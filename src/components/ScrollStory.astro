---
// B-E-C-C-I story as a pinned scroll "drum": the stage sticks while the page scrolls,
// one chapter is lit at a time. All five chapters stay in the DOM in reading order, so
// screen readers, no-JS and reduced-motion users get a plain ordered list.
import { story } from '../data/site';
const word = (name: string) => name.split(' ')[0];
---
<section class="story" aria-labelledby="story-title" data-story style={`--n:${story.length}`}>
  <div class="story__stage">
    <div class="wrap story__head">
      <div>
        <h2 id="story-title">Five letters, one journey</h2>
        <p class="story__intro">Read the letters of BECCI in order and they tell one entrepreneur's story: a first idea, the encouragement to start, a community to grow with, the commerce that community creates, and the impact it leaves behind.</p>
      </div>
      <p class="story__count" aria-hidden="true"><span data-story-count>1</span> of {story.length}</p>
    </div>
    <ol class="story__list wrap">
      {story.map((s, i) => (
        <li class="story__item" data-i={i} data-active={i === 0 ? '' : undefined}>
          <span class="story__letter" aria-hidden="true">{s.letter}</span>
          <h3 class="story__word"><span class="visually-hidden">{s.letter}: </span>{word(s.name)}</h3>
          <div class="story__text"><span class="story__name">{s.letter} · {s.name}</span><strong>{s.title}</strong><p>{s.text}</p><a class="story__link" href={s.link.href}>{s.link.label}</a></div>
        </li>
      ))}
    </ol>
    <div class="story__rail wrap" aria-hidden="true">
      {story.map((s) => <span>{s.letter}</span>)}
    </div>
  </div>
</section>

<style>
  .story { position: relative; background: var(--midnight); color: var(--on-dark-2); }
  .story__stage { position: relative; overflow: hidden; padding-block: var(--s-8); }
  .story__stage::before { content: ''; position: absolute; inset: auto -10% -40% -10%; height: 90%; background: radial-gradient(50% 60% at 50% 100%, rgb(40 105 232 / 55%), rgb(66 200 216 / 18%) 45%, transparent 70%); pointer-events: none; }
  .story__head { position: relative; display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); }
  .story__head h2 { color: #fff; font-size: var(--fs-xl); margin: 0; }
  .story__count { margin: 0; font-size: var(--fs-sm); font-variant-numeric: tabular-nums; color: var(--on-dark-2); }
  .story__count span { color: var(--sky); font-weight: 600; }
  .story__list { position: relative; list-style: none; padding: 0; margin-block: var(--s-6) 0; display: grid; gap: var(--s-6); }
  .story__letter { display: block; font: 600 clamp(5rem, 14vw, 11rem)/0.85 var(--font-display); letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 1.5px rgb(101 185 242 / 60%); }
  .story__word { font: 600 clamp(2rem, 1rem + 4vw, 4.5rem)/1 var(--font-display); letter-spacing: -0.03em; color: #fff; margin: var(--s-3) 0; }
  .story__text strong { display: block; color: #fff; font-size: var(--fs-md); margin-bottom: var(--s-2); }
  .story__text p { margin: 0; max-width: 42ch; color: #c3d1e8; }
  .story__intro { margin: var(--s-2) 0 0; max-width: 60ch; font-size: var(--fs-sm); color: var(--on-dark-2); }
  .story__name { display: block; font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.02em; color: var(--sky); margin-bottom: var(--s-2); }
  .story__link { display: inline-flex; align-items: center; min-height: 44px; margin-top: var(--s-2); color: #fff; font-weight: 600; font-size: var(--fs-sm); text-decoration: underline; text-decoration-color: rgb(101 185 242 / 50%); text-underline-offset: 5px; }
  .story__link::after { content: ' →'; white-space: pre; }
  .story__rail { display: none; }

  /* Pinned drum: only with JS and motion allowed */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .story { height: calc(var(--n) * 70svh + 100svh); }
    :global(.js) .story__stage { position: sticky; top: 0; height: 100svh; display: grid; grid-template-rows: auto 1fr auto; padding-block: calc(var(--header-h) + var(--s-5)) var(--s-6); }
    :global(.js) .story__list { display: block; margin: 0 auto; height: 100%; }
    :global(.js) .story__item { position: static; }
    :global(.js) .story__word { position: absolute; left: 50%; top: 50%; width: max-content; max-width: 90vw; margin: 0; text-align: center; transform-origin: 50% 50%;
      transform: translate(-50%, -50%) translateY(calc(var(--o, 0) * 1.25em)) scale(calc(1 - min(var(--d, 0), 3) * 0.16)); opacity: calc(1 - min(var(--d, 0), 2.6) * 0.36); color: rgb(195 209 232 / 70%); transition: color 300ms; will-change: transform, opacity; }
    :global(.js) .story__item[data-active] .story__word { color: #fff; text-shadow: 0 0 40px rgb(40 105 232 / 85%), 0 0 90px rgb(66 200 216 / 45%); }
    :global(.js) .story__letter { position: absolute; left: 0; top: 50%; transform: translateY(-50%) scale(0.9); opacity: 0; transition: opacity 400ms, transform 600ms var(--ease); font-size: clamp(8rem, 22vw, 20rem); }
    :global(.js) .story__item[data-active] .story__letter { opacity: 1; transform: translateY(-50%) scale(1); }
    :global(.js) .story__text { position: absolute; right: 0; top: 50%; width: min(32ch, 28vw); transform: translateY(-40%); opacity: 0; visibility: hidden; transition: opacity 300ms, transform 500ms var(--ease), visibility 0s 300ms; }
    :global(.js) .story__item[data-active] .story__text { opacity: 1; visibility: visible; transform: translateY(-50%); transition: opacity 300ms 120ms, transform 500ms var(--ease) 120ms, visibility 0s; }
    :global(.js) .story__rail { position: relative; display: flex; gap: var(--s-3); }
    :global(.js) .story__rail span { flex: 1; padding-top: var(--s-3); border-top: 2px solid rgb(255 255 255 / 14%); font-size: var(--fs-sm); font-weight: 600; color: var(--on-dark-2); transition: border-color 300ms, color 300ms; }
    :global(.js) .story__rail span[data-on] { border-top-color: var(--cyan); color: #fff; }
    @media (max-width: 860px) {
      :global(.js) .story__intro { display: none; }
      :global(.js) .story__letter { left: 50%; top: 0; transform: translate(-50%, 0) scale(0.9); font-size: clamp(6rem, 30vw, 9rem); }
      :global(.js) .story__item[data-active] .story__letter { transform: translate(-50%, 0) scale(1); }
      :global(.js) .story__text { left: 0; right: 0; top: auto; bottom: var(--s-5); width: auto; transform: translateY(12px); text-align: center; }
      :global(.js) .story__text p { margin-inline: auto; }
      :global(.js) .story__item[data-active] .story__text { transform: none; }
      :global(.js) .story__word { font-size: clamp(2rem, 9vw, 3rem); }
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-story]');
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
  if (root && motion.matches) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.story__item'));
    const rail = Array.from(root.querySelectorAll<HTMLElement>('.story__rail span'));
    const count = root.querySelector<HTMLElement>('[data-story-count]')!;
    let active = -1, ticking = false;
    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / span));
      const pos = p * (items.length - 1); // continuous chapter position
      items.forEach((li, i) => {
        const o = i - pos;
        li.style.setProperty('--o', o.toFixed(3));
        li.style.setProperty('--d', Math.abs(o).toFixed(3));
      });
      const a = Math.round(pos);
      if (a !== active) {
        active = a;
        items.forEach((li, i) => li.toggleAttribute('data-active', i === a));
        rail.forEach((s, i) => s.toggleAttribute('data-on', i <= a));
        count.textContent = String(a + 1);
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { window.addEventListener('scroll', onScroll, { passive: true }); update(); }
      else window.removeEventListener('scroll', onScroll);
    }).observe(root);
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
