---
import { site, socials, nav } from '../data/site';
import Logo from './Logo.astro';
const groups = nav.filter((g) => g.children);
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="footer-top">
      <p class="footer-promise">Building Businesses • Building Bharat</p>
      <div class="footer-cta">
        <a class="btn btn--light" href="/membership#join">Join BECCI</a>
        <a class="btn btn--ghost" href="/partnerships">Partner with BECCI</a>
      </div>
    </div>
    <div class="footer-grid">
      <div class="footer-id">
        <Logo tone="light" />
        <p>{site.identity}</p>
        {socials.length ? (
          <ul class="footer-social">{socials.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}</ul>
        ) : <p class="small">Official social media links will be added once BECCI confirms them.</p>}
      </div>
      {groups.map((g) => (
        <div><h2>{g.label}</h2><ul>{[...g.children!, ...(g.more ?? [])].map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul></div>
      ))}
    </div>
    <div class="footer-base">
      <span>© {new Date().getFullYear()} BECCI · {site.fullName}</span>
      <span><a href="/membership">Membership</a> · <a href="/policies">Privacy Policy</a> · <a href="/policies#terms">Terms</a> · <a href="/opportunities/about-data">How we check opportunities</a></span>
    </div>
  </div>
</footer>
<style is:global>
  .site-footer { position: relative; overflow: hidden; isolation: isolate; background: var(--midnight); padding-top: clamp(var(--s-7), 7vw, 112px); }
  .footer-cta { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .footer-id p { margin: var(--s-4) 0 0; max-width: 34ch; }
  .footer-social { list-style: none; padding: 0; display: flex; gap: var(--s-4); margin-top: var(--s-4); }
  .footer-grid { grid-template-columns: 1.4fr repeat(4, 1fr) !important; }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr !important; } .site-footer { padding-top: var(--s-7); } }
</style>
