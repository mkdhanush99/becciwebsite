---
import { opportunities, portals, CATEGORY_META, CATEGORY_ORDER, OBC_SCOPE_LABEL, FEED_STATUS, type Category } from '../data/opportunities';
import { computeStatus, STATUS_LABEL, deadlineText, formatDate, todayISO, type Status } from '../lib/status';

interface Props { category?: Category }
const { category } = Astro.props;
const today = todayISO();
const records = opportunities.filter((o) => !category || o.categories.includes(category));
const scopePortals = portals.filter((p) => !category || p.categories.includes(category));

const statusOrder: Status[] = ['closing-soon', 'open', 'rolling', 'upcoming', 'amended', 'awaiting-notice', 'closed'];

type Facet = { key: string; label: string; values: { value: string; label: string; count: number }[] };
const facet = (key: string, label: string, get: (o: (typeof records)[number]) => string[], labeler: (v: string) => string = (v) => v): Facet => {
  const counts = new Map<string, number>();
  records.forEach((o) => get(o).forEach((v) => counts.set(v, (counts.get(v) ?? 0) + 1)));
  return { key, label, values: [...counts].map(([value, count]) => ({ value, label: labeler(value), count })) };
};
const facets: Facet[] = [
  facet('status', 'Status', (o) => [computeStatus(o, today)], (v) => STATUS_LABEL[v as Status]),
  facet('aud', 'Who it is for', (o) => o.audience),
  facet('geo', 'Where it applies', (o) => o.geography),
  facet('level', 'Government', (o) => [o.level]),
  facet('scope', 'Category rule', (o) => [o.obcScope], (v) => OBC_SCOPE_LABEL[v as keyof typeof OBC_SCOPE_LABEL]),
  facet('edu', 'Education level', (o) => o.educationLevel ?? []),
  facet('fund', 'Support type', (o) => o.fundingType ?? []),
  facet('stage', 'Business stage', (o) => o.stage ?? []),
].filter((f) => f.values.length > 0);
facets[0]?.values.sort((a, b) => statusOrder.indexOf(a.value as Status) - statusOrder.indexOf(b.value as Status));

const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
const feed = category ? FEED_STATUS[category] : null;
const title = category ? CATEGORY_META[category].label : 'All opportunities';
---
<div class="finder" data-finder data-category={category ?? 'all'}>
  <nav class="cat-tabs" aria-label="Opportunity categories">
    <a href="/opportunities" aria-current={!category ? 'page' : undefined}>All <span class="cat-tabs__n">{opportunities.length}</span></a>
    {CATEGORY_ORDER.map((c) => (
      <a href={CATEGORY_META[c].path} aria-current={category === c ? 'page' : undefined}>{CATEGORY_META[c].label} <span class="cat-tabs__n">{opportunities.filter((o) => o.categories.includes(c)).length}</span></a>
    ))}
  </nav>

  <form class="finder-bar" role="search" data-search onsubmit="return false">
    <label class="visually-hidden" for="finder-q">Search {title.toLowerCase()}</label>
    <div class="finder-input">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m14 14 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <input id="finder-q" class="input" type="search" name="q" autocomplete="off" placeholder="Search by name, authority or keyword" data-q />
    </div>
    <button type="button" class="btn btn--ghost filter-open" data-filter-open aria-haspopup="dialog">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 4h14M5 9h8M7.5 14h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      Filters <span class="filter-count" data-filter-count hidden></span>
    </button>
  </form>

  <div class="finder-layout">
    <aside class="finder-filters" aria-label="Filters">
      <dialog class="filter-sheet" data-filter-sheet aria-labelledby="filter-sheet-title">
        <div class="filter-sheet__head">
          <h2 id="filter-sheet-title">Filters</h2>
          <button type="button" class="icon-btn" data-filter-close aria-label="Close filters">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4l10 10M14 4 4 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="filter-groups" data-filter-groups>
          {facets.map((f) => (
            <fieldset class="filter-group">
              <legend>{f.label}</legend>
              {f.values.map((v) => (
                <label class="check">
                  <input type="checkbox" name={f.key} value={v.value} data-label={v.label} />
                  <span class="check__box" aria-hidden="true"></span>
                  <span class="check__label">{v.label}</span>
                  <span class="check__count" data-count-for={`${f.key}:${v.value}`}>{v.count}</span>
                </label>
              ))}
            </fieldset>
          ))}
          {facets.length === 0 && <p class="muted small">Filters appear when there are records to narrow down.</p>}
        </div>
        <div class="filter-sheet__foot">
          <button type="button" class="btn btn--ghost" data-clear>Clear all</button>
          <button type="button" class="btn" data-filter-apply>Show <span data-apply-count>{records.length}</span> results</button>
        </div>
      </dialog>
    </aside>

    <section class="finder-results" aria-labelledby="results-heading">
      <div class="results-toolbar">
        <div class="results-head">
          <h2 id="results-heading" class="results-count" aria-live="polite" data-result-count>
            {records.length} {records.length === 1 ? 'record' : 'records'}
          </h2>
          <div class="finder-sort">
            <label for="finder-sort" class="small muted">Sort</label>
            <select id="finder-sort" class="select" data-sort>
              <option value="closing">Closing soon first</option>
              <option value="latest">Latest checked</option>
              <option value="az">A to Z</option>
            </select>
          </div>
        </div>
        <div class="active-filters" data-active hidden>
          <span class="active-filters__label" data-active-label>Filtered by</span>
          <ul class="chips" data-chips></ul>
          <button type="button" class="link-btn" data-clear>Clear all</button>
        </div>
      </div>

      {feed && !feed.live && (category === 'tenders' || category === 'jobs') && (
        <div class="notice notice--warn feed-note" role="status"><strong>No live feed connected.</strong> {feed.message}</div>
      )}

      {records.length > 0 && (
        <ol class="results" data-results>
          {records.map((o) => {
            const st = computeStatus(o, today);
            return (
              <li class="result" data-item
                data-slug={o.slug}
                data-title={o.title.toLowerCase()}
                data-text={`${o.title} ${o.authority} ${o.summary} ${o.geography.join(' ')} ${o.audience.join(' ')}`.toLowerCase()}
                data-closing={o.closingDate ?? ''}
                data-opening={o.openingDate ?? ''}
                data-amended={o.amendedDate ?? ''}
                data-rolling={o.rolling ? '1' : ''}
                data-awaiting={o.awaitingNotice ? '1' : ''}
                data-verified={o.lastVerified}
                data-status={st}
                data-aud={o.audience.join('|')}
                data-geo={o.geography.join('|')}
                data-level={o.level}
                data-scope={o.obcScope}
                data-edu={(o.educationLevel ?? []).join('|')}
                data-fund={(o.fundingType ?? []).join('|')}
                data-stage={(o.stage ?? []).join('|')}>
                <article class="result__card">
                  <div class="result__when">
                    <span class={`status status--${st}`} data-status-pill>{STATUS_LABEL[st]}</span>
                    <p class="result__deadline" data-deadline>{deadlineText(o, today)}</p>
                  </div>
                  <div class="result__main">
                    <h3 class="result__title"><a href={`/opportunities/${o.slug}`} data-result-link>{o.title}</a></h3>
                    <p class="result__authority">{o.authority}</p>
                    <p class="result__summary">{o.summary}</p>
                    <p class="result__who"><span>Who can apply</span> {o.whoCanApply[0]}</p>
                  </div>
                  <dl class="result__facts">
                    <div><dt>Category rule</dt><dd><span class={`scope scope--${o.obcScope}`}>{OBC_SCOPE_LABEL[o.obcScope]}</span></dd></div>
                    <div><dt>Where</dt><dd class="result__level">{o.level} · {o.geography.join(', ')}</dd></div>
                    <div><dt>Official source</dt><dd>{host(o.sources[0].url)}<br /><span class="muted">Verified {formatDate(o.lastVerified)}</span></dd></div>
                  </dl>
                </article>
              </li>
            );
          })}
        </ol>
      )}

      <div class="empty" data-empty hidden>
        <h3>No records match these filters</h3>
        <p>Try removing a filter or searching for a broader term. Only records checked against an official source are listed, so coverage is still small.</p>
        <button type="button" class="btn btn--ghost btn--sm" data-clear>Clear all filters</button>
      </div>

      {records.length === 0 && (
        <div class="empty">
          <h3>No individual {category ? CATEGORY_META[category].plural : 'records'} listed yet</h3>
          <p>BECCI lists an opportunity only after checking it against an official source. Until a verified record or authorised feed is available, use the official portals below.</p>
        </div>
      )}

      {scopePortals.length > 0 && (
        <details class="portals" open={records.length === 0}>
          <summary class="portals__summary"><span class="portals__title">Official portals{category ? ` for ${CATEGORY_META[category].plural}` : ''}</span> <span class="portals__n">{scopePortals.length}</span></summary>
          <p class="small muted">These links go straight to government websites. BECCI does not run them and has no integration with them.</p>
          <ul class="portal-list">
            {scopePortals.map((p) => (
              <li class="portal">
                <div>
                  <a class="portal__name ext" href={p.url} rel="noopener" target="_blank">{p.name}<span class="visually-hidden"> (opens official site in a new tab)</span></a>
                  <span class="portal__meta">{p.authority} · {p.geography}</span>
                  <p class="portal__note">{p.note}</p>
                </div>
                <span class={p.reachable ? 'reach reach--ok' : 'reach reach--no'}>
                  {p.reachable ? 'Reached' : 'Not reached'} {formatDate(p.checked)}
                </span>
              </li>
            ))}
          </ul>
        </details>
      )}
    </section>
  </div>
</div>

<style is:global>
  .cat-tabs { display: flex; gap: var(--s-1); overflow-x: auto; margin: 0 0 var(--s-5); border-bottom: var(--hair); scrollbar-width: none; scroll-padding-inline: var(--s-4); }
  @media (max-width: 960px) { .cat-tabs { mask-image: linear-gradient(90deg, #000 85%, transparent); } }
  .cat-tabs::-webkit-scrollbar { display: none; }
  .cat-tabs a { flex: none; display: inline-flex; align-items: center; gap: var(--s-2); min-height: 48px; padding: 0 var(--s-3); color: var(--slate); font-weight: 500; text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: color var(--dur), border-color var(--dur); }
  .cat-tabs a:hover { color: var(--midnight); border-bottom-color: var(--silver-300); }
  .cat-tabs a[aria-current='page'] { color: var(--midnight); font-weight: 600; border-bottom-color: var(--sapphire); }
  .cat-tabs__n { font-size: var(--fs-label); font-weight: 600; min-width: 22px; padding: 2px 6px; border-radius: 4px; background: var(--silver-100); color: var(--slate); text-align: center; font-variant-numeric: tabular-nums; }
  .cat-tabs a[aria-current='page'] .cat-tabs__n { background: var(--sapphire); color: #fff; }

  .finder-bar { display: flex; gap: var(--s-3); margin-bottom: var(--s-6); }
  .finder-input { position: relative; flex: 1; }
  .finder-input svg { position: absolute; left: var(--s-4); top: 50%; translate: 0 -50%; color: var(--slate); }
  .finder-input .input { padding-left: 48px; min-height: 56px; font-size: var(--fs-md); }
  .filter-open { min-height: 56px; display: none; }
  .filter-count { background: var(--sapphire); color: #fff; border-radius: 4px; padding: 2px 7px; font-size: var(--fs-label); }

  .finder-layout { display: grid; grid-template-columns: 272px minmax(0, 1fr); gap: var(--s-6); align-items: start; }
  .filter-sheet { position: static; display: block; border: 0; padding: 0; margin: 0; background: transparent; width: auto; max-width: none; color: inherit; }
  .filter-sheet__head, .filter-sheet__foot { display: none; }
  .finder-filters { background: var(--white); border: var(--hair); border-radius: var(--radius); padding: var(--s-5); }
  .filter-group { border: 0; padding: 0 0 var(--s-4); margin: 0 0 var(--s-4); border-bottom: var(--hair); }
  .filter-group:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .filter-group legend { font: 600 var(--fs-label)/1 var(--font-body); letter-spacing: 0.05em; text-transform: uppercase; color: var(--slate); margin-bottom: var(--s-2); padding: 0; }
  .check { display: grid; grid-template-columns: 20px 1fr auto; align-items: center; gap: var(--s-3); min-height: 40px; font-size: var(--fs-sm); color: var(--ink-2); }
  .check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .check__box { width: 20px; height: 20px; border: 1.5px solid #8f9bb0; border-radius: 4px; background: #fff; display: grid; place-items: center; transition: background var(--dur), border-color var(--dur); }
  .check:hover .check__box { border-color: var(--sapphire); }
  .check input:checked + .check__box { background: var(--sapphire); border-color: var(--sapphire); }
  .check input:checked + .check__box::after { content: ''; width: 10px; height: 6px; border-left: 2px solid #fff; border-bottom: 2px solid #fff; transform: rotate(-45deg) translate(1px, -1px); }
  .check input:checked ~ .check__label { font-weight: 600; color: var(--midnight); }
  .check input:focus-visible + .check__box { outline: 3px solid var(--blue-500); outline-offset: 2px; }
  .check__count { font-size: var(--fs-label); color: var(--slate); font-variant-numeric: tabular-nums; }
  .check__label { line-height: 1.3; padding-block: var(--s-1); }
  .results-count { font-variant-numeric: tabular-nums; }
  .check[data-zero] { opacity: 0.45; }

  .results-toolbar { position: sticky; top: 64px; z-index: 5; background: var(--ivory); padding: var(--s-3) 0; margin-top: calc(-1 * var(--s-3)); border-bottom: var(--hair); margin-bottom: var(--s-4); }
  .results-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-2) var(--s-4); }
  .results-count { font: 600 var(--fs-md) var(--font-body); color: var(--midnight); margin: 0; }
  .finder-sort { display: flex; align-items: center; gap: var(--s-2); }
  .finder-sort .select { min-height: 44px; width: auto; padding-block: 0; font-size: var(--fs-sm); }
  .active-filters { display: flex; align-items: center; gap: var(--s-3); margin-top: var(--s-3); min-width: 0; }
  .active-filters[hidden] { display: none; }
  .active-filters__label { font-size: var(--fs-sm); color: var(--slate); flex: none; }
  .chips { display: flex; gap: var(--s-2); list-style: none; padding: 0; margin: 0; overflow-x: auto; scrollbar-width: none; min-width: 0; }
  .chips::-webkit-scrollbar { display: none; }
  .chip { flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 var(--s-2) 0 var(--s-3); border-radius: 4px; background: var(--sapphire-soft); color: var(--sapphire-deep); border: 0; font: 600 var(--fs-sm) var(--font-body); transition: background var(--dur); }
  .chip:hover { background: #cbd9f0; }
  .feed-note { margin-bottom: var(--s-4); }

  .results { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--midnight); }
  .result[hidden] { display: none; }
  .result__card { position: relative; display: grid; grid-template-columns: 168px minmax(0, 1fr) 216px; gap: var(--s-5); padding: var(--s-5) var(--s-2); border-bottom: var(--hair); transition: background var(--dur); }
  .result__card:hover { background: var(--white); }
  .result__when { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); }
  .result__deadline { margin: 0; font-size: var(--fs-sm); font-weight: 600; color: var(--ink); line-height: 1.4; }
  .result__title { font-size: var(--fs-lg); line-height: 1.25; margin-bottom: var(--s-1); }
  .result__title a { color: var(--midnight); text-decoration: none; }
  .result__title a::after { content: ''; position: absolute; inset: 0; }
  .result__title a:hover { color: var(--sapphire); text-decoration: underline; }
  .result__title a:focus-visible { outline: none; }
  .result__title a:focus-visible::after { outline: 3px solid var(--blue-500); outline-offset: -2px; border-radius: var(--radius-sm); }
  .result__authority { font-size: var(--fs-sm); color: var(--slate); margin-bottom: var(--s-3); }
  .result__summary { margin-bottom: var(--s-2); color: var(--ink-2); max-width: 64ch; }
  .result__who { margin: 0; font-size: var(--fs-sm); color: var(--ink-2); max-width: 64ch; }
  .result__who span { font-weight: 600; color: var(--midnight); margin-right: var(--s-1); }
  .result__facts { margin: 0; display: grid; gap: var(--s-3); align-content: start; font-size: var(--fs-sm); }
  .result__facts dt { font-size: var(--fs-label); letter-spacing: 0.05em; text-transform: uppercase; color: var(--slate); font-weight: 600; margin-bottom: 2px; }
  .result__facts dd { margin: 0; color: var(--ink-2); overflow-wrap: anywhere; }
  .result__facts .scope { white-space: normal; }
  .result__title, .result__summary, .result__who { overflow-wrap: break-word; }

  .empty { background: var(--white); border: var(--hair); border-radius: var(--radius); padding: var(--s-6); }
  .empty p { color: var(--slate); max-width: 60ch; }
  .portals { margin-top: var(--s-7); border-top: var(--hair); }
  .portals__summary { display: flex; align-items: center; gap: var(--s-3); min-height: 64px; cursor: pointer; list-style: none; }
  .portals__summary::-webkit-details-marker { display: none; }
  .portals__summary::after { content: '+'; margin-left: auto; font-size: 1.5rem; color: var(--sapphire); }
  .portals[open] .portals__summary::after { content: '–'; }
  .portals__title { font: 600 var(--fs-xl)/1.2 var(--font-display); color: var(--midnight); letter-spacing: -0.01em; }
  .portals__n { font-size: var(--fs-label); font-weight: 600; padding: 2px 8px; border-radius: 4px; background: var(--silver-100); color: var(--slate); }
  .portal-list { list-style: none; padding: 0; margin: var(--s-4) 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
  .portal { display: flex; justify-content: space-between; gap: var(--s-4); padding: var(--s-4) var(--s-5); border: var(--hair); border-radius: var(--radius-sm); background: var(--white); }
  .portal__name { font-weight: 600; }
  .portal__meta { display: block; font-size: var(--fs-sm); color: var(--slate); }
  .portal__note { font-size: var(--fs-sm); margin: var(--s-2) 0 0; color: var(--ink-2); }
  .reach { flex: none; align-self: start; font-size: var(--fs-label); font-weight: 600; padding: 4px 8px; border-radius: 4px; white-space: nowrap; }
  .reach--ok { background: var(--ok-bg); color: var(--ok); }
  .reach--no { background: var(--closed-bg); color: var(--closed); }

  @media (max-width: 1180px) {
    .result__card { grid-template-columns: 140px minmax(0, 1fr); }
    .result__facts { grid-column: 2; grid-template-columns: repeat(3, auto); justify-content: start; column-gap: var(--s-6); }
  }
  @media (max-width: 960px) {
    .finder-layout { grid-template-columns: 1fr; }
    .finder-filters { position: static; max-height: none; overflow: visible; padding: 0; border: 0; background: none; }
    .filter-open { display: inline-flex; }
    .finder-bar { position: sticky; top: 64px; z-index: 6; background: var(--ivory); padding-block: var(--s-2); margin-bottom: var(--s-4); }
    .results-toolbar { position: static; margin-top: 0; }
    .filter-sheet { display: none; position: fixed; inset: auto 0 0 0; width: 100%; max-width: 100%; max-height: 88dvh; margin: 0; border-radius: var(--radius) var(--radius) 0 0; background: var(--white); padding: 0; box-shadow: var(--shadow-overlay); }
    .filter-sheet[open] { display: flex; flex-direction: column; animation: sheet 260ms var(--ease); }
    .filter-sheet::backdrop { background: rgb(6 22 56 / 45%); }
    .filter-sheet__head { display: flex; justify-content: space-between; align-items: center; padding: var(--s-4) var(--gutter); border-bottom: var(--hair); }
    .filter-sheet__head h2 { font-size: var(--fs-lg); margin: 0; }
    .filter-groups { overflow: auto; padding: var(--s-5) var(--gutter); flex: 1; }
    .filter-sheet__foot { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); padding: var(--s-3) var(--gutter) calc(var(--s-3) + env(safe-area-inset-bottom)); border-top: var(--hair); background: var(--white); }
    .check { min-height: 48px; font-size: var(--fs-base); }
    .portal-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .result__card { grid-template-columns: 1fr; gap: var(--s-3); padding: var(--s-5) 0; }
    .result__when { flex-direction: row; align-items: center; flex-wrap: wrap; }
    .result__facts { grid-column: 1; grid-template-columns: 1fr 1fr; }
    .result__facts > div:last-child { grid-column: 1 / -1; }
    .portal { flex-direction: column; gap: var(--s-2); }
    .finder-input .input { font-size: var(--fs-base); }
  }
  @keyframes sheet { from { transform: translateY(40px); opacity: 0.6; } }
</style>


<script>
  import { computeStatus, STATUS_LABEL, deadlineText, todayISO } from '../lib/status';

  const root = document.querySelector<HTMLElement>('[data-finder]');
  if (root) {
    const FILTER_KEYS = ['status', 'aud', 'geo', 'level', 'scope', 'edu', 'fund', 'stage'];
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const list = root.querySelector<HTMLOListElement>('[data-results]');
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-item]'));
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('[data-filter-groups] input[type=checkbox]'));
    const countEl = root.querySelector<HTMLElement>('[data-result-count]')!;
    const applyCount = root.querySelector<HTMLElement>('[data-apply-count]')!;
    const chips = root.querySelector<HTMLUListElement>('[data-chips]')!;
    const active = root.querySelector<HTMLElement>('[data-active]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const badge = root.querySelector<HTMLElement>('[data-filter-count]')!;
    const sheet = root.querySelector<HTMLDialogElement>('[data-filter-sheet]')!;
    const mobile = window.matchMedia('(max-width: 900px)');
    const today = todayISO();

    // Re-evaluate statuses in the browser so a cached page never shows a stale "Open".
    items.forEach((li) => {
      const d = li.dataset;
      const rec = { closingDate: d.closing || undefined, openingDate: d.opening || undefined, amendedDate: d.amended || undefined, rolling: !!d.rolling, awaitingNotice: !!d.awaiting };
      const st = computeStatus(rec, today);
      if (st !== d.status) {
        li.dataset.status = st;
        const pill = li.querySelector<HTMLElement>('[data-status-pill]')!;
        pill.className = `status status--${st}`;
        pill.textContent = STATUS_LABEL[st];
        const box = boxes.find((b) => b.name === 'status' && b.value === st);
        if (box) box.dataset.label = STATUS_LABEL[st];
      }
      li.querySelector('[data-deadline]')!.textContent = deadlineText(rec, today);
    });

    const selected = () => {
      const s: Record<string, string[]> = {};
      boxes.forEach((b) => { if (b.checked) (s[b.name] ??= []).push(b.value); });
      return s;
    };
    const matches = (li: HTMLLIElement, s: Record<string, string[]>, term: string, skip?: string) => {
      if (term && !term.split(/\s+/).every((t) => li.dataset.text!.includes(t))) return false;
      return Object.entries(s).every(([k, vals]) => {
        if (k === skip) return true;
        const have = (li.dataset[k] ?? '').split('|');
        return vals.some((v) => have.includes(v)); // OR within a group, AND across groups
      });
    };
    const order = ['closing-soon', 'open', 'rolling', 'upcoming', 'amended', 'awaiting-notice', 'closed'];
    const sorters: Record<string, (a: HTMLLIElement, b: HTMLLIElement) => number> = {
      closing: (a, b) => {
        const sa = order.indexOf(a.dataset.status!), sb = order.indexOf(b.dataset.status!);
        const closedA = a.dataset.status === 'closed', closedB = b.dataset.status === 'closed';
        if (closedA !== closedB) return closedA ? 1 : -1;
        const ca = a.dataset.closing || '9999', cb = b.dataset.closing || '9999';
        return ca.localeCompare(cb) || sa - sb || a.dataset.title!.localeCompare(b.dataset.title!);
      },
      latest: (a, b) => b.dataset.verified!.localeCompare(a.dataset.verified!) || a.dataset.title!.localeCompare(b.dataset.title!),
      az: (a, b) => a.dataset.title!.localeCompare(b.dataset.title!),
    };

    const writeURL = (s: Record<string, string[]>) => {
      const p = new URLSearchParams();
      if (q.value.trim()) p.set('q', q.value.trim());
      Object.entries(s).forEach(([k, v]) => p.set(k, v.join(',')));
      if (sort.value !== 'closing') p.set('sort', sort.value);
      const url = `${location.pathname}${p.toString() ? '?' + p : ''}`;
      history.replaceState(history.state, '', url);
    };

    const render = (opts: { pushURL?: boolean } = {}) => {
      const s = selected();
      const term = q.value.trim().toLowerCase();
      let n = 0;
      items.forEach((li) => { const ok = matches(li, s, term); li.hidden = !ok; if (ok) n++; });
      if (list) items.slice().sort(sorters[sort.value]).forEach((li) => list.appendChild(li));
      // counts per option, given the other active groups
      boxes.forEach((b) => {
        const c = items.filter((li) => matches(li, s, term, b.name) && (li.dataset[b.name] ?? '').split('|').includes(b.value)).length;
        const el = root.querySelector(`[data-count-for="${b.name}:${CSS.escape(b.value)}"]`);
        if (el) el.textContent = String(c);
        b.closest('.check')!.toggleAttribute('data-zero', c === 0 && !b.checked);
      });
      const noun = n === 1 ? 'record' : 'records';
      countEl.textContent = items.length ? `${n} ${noun}${n !== items.length ? ` of ${items.length}` : ''}` : '0 records';
      applyCount.textContent = String(n);
      empty.hidden = !(items.length && n === 0);
      // active chips
      chips.innerHTML = '';
      const all = boxes.filter((b) => b.checked);
      if (term) all.unshift(Object.assign(document.createElement('input'), { name: 'q', value: q.value.trim() }));
      all.forEach((b) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'chip';
        const text = b.name === 'q' ? `“${b.value}”` : b.dataset.label ?? b.value;
        btn.setAttribute('aria-label', `Remove filter: ${text}`);
        btn.innerHTML = `<span></span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`;
        btn.querySelector('span')!.textContent = text;
        btn.addEventListener('click', () => {
          if (b.name === 'q') q.value = ''; else b.checked = false;
          render(); (chips.querySelector('.chip') as HTMLElement | null ?? q).focus();
        });
        li.appendChild(btn); chips.appendChild(li);
      });
      active.hidden = all.length === 0;
      root.querySelector('[data-active-label]')!.textContent = `${all.length} active ${all.length === 1 ? 'filter' : 'filters'}`;
      const fc = boxes.filter((b) => b.checked).length;
      badge.hidden = fc === 0; badge.textContent = String(fc);
      if (opts.pushURL !== false) writeURL(s);
    };

    // Restore state from URL
    const params = new URLSearchParams(location.search);
    q.value = params.get('q') ?? '';
    if (params.get('sort') && sorters[params.get('sort')!]) sort.value = params.get('sort')!;
    FILTER_KEYS.forEach((k) => (params.get(k) ?? '').split(',').filter(Boolean).forEach((v) => {
      const b = boxes.find((x) => x.name === k && x.value === v); if (b) b.checked = true;
    }));
    render({ pushURL: false });

    let t: number | undefined;
    q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => render(), 120); });
    sort.addEventListener('change', () => render());
    boxes.forEach((b) => b.addEventListener('change', () => render()));
    root.querySelectorAll('[data-clear]').forEach((btn) => btn.addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); q.value = ''; render(); }));

    // Mobile filter sheet
    root.querySelector('[data-filter-open]')!.addEventListener('click', () => sheet.showModal());
    const closeSheet = () => sheet.close();
    root.querySelector('[data-filter-close]')!.addEventListener('click', closeSheet);
    root.querySelector('[data-filter-apply]')!.addEventListener('click', closeSheet);
    sheet.addEventListener('click', (e) => { if (e.target === sheet) closeSheet(); });
    mobile.addEventListener('change', () => { if (!mobile.matches && sheet.open) sheet.close(); });

    // Remember scroll position for the return trip from a detail page
    const key = 'finder-scroll:' + location.pathname;
    root.querySelectorAll<HTMLAnchorElement>('[data-result-link]').forEach((a) => a.addEventListener('click', () => {
      sessionStorage.setItem(key, JSON.stringify({ y: window.scrollY, url: location.pathname + location.search }));
      sessionStorage.setItem('finder-return', location.pathname + location.search);
    }));
    try {
      const saved = JSON.parse(sessionStorage.getItem(key) ?? 'null');
      if (saved && saved.url === location.pathname + location.search) {
        requestAnimationFrame(() => window.scrollTo(0, saved.y));
        sessionStorage.removeItem(key);
      }
    } catch { /* ignore */ }
  }
</script>
