---
import { nav } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Illo from './Illo.astro';
import HeaderSearch from './HeaderSearch';
import '../styles/tailwind.css';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href.split('#')[0] && !href.includes('#'));
const inGroup = (g: (typeof nav)[number]) => [...(g.children ?? []), ...(g.more ?? [])].some((c) => { const h = c.href.split('#')[0]; return path === h || path.startsWith(h + '/'); });
const chevron = '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
---
<header class="site-header" data-header>
  <div class="wrap site-header__bar">
    <a class="brand" href="/" aria-label="BECCI home"><Logo /></a>
    <nav class="primary-nav" aria-label="Main">
      <ul>
        {nav.map((g, i) => (
          <li class="nav-item">
            <button class="nav-trigger" type="button" aria-expanded="false" aria-controls={`nav-panel-${i}`} data-in={inGroup(g) ? '' : undefined}>
              {g.label}<Fragment set:html={chevron} />
            </button>
            <div class={`nav-panel mm mm--${g.tone}`} id={`nav-panel-${i}`}>
              <span class="mm__back" aria-hidden="true"></span>
              <div class="mm__card">
                <p class="mm__eyebrow">{g.label}</p>
                <p class="mm__intro">{g.intro}</p>
                <ul class="mm__links">
                  {g.children!.map((c, j) => (
                    <li style={`--j:${j}`}><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                      <span class={`mm__ic mm__ic--${j % 4}`}><Icon name={c.icon as any} size={22} /></span>
                      <span class="mm__l"><span class="mm__t">{c.label}</span>{c.desc && <span class="mm__d">{c.desc}</span>}</span>
                      <span class="mm__go" aria-hidden="true">→</span>
                    </a></li>
                  ))}
                </ul>
                {g.more && (
                  <p class="mm__more"><span>Also in {g.label}</span>{g.more.map((m) => <a href={m.href}>{m.label}{m.note && <span class="nav-note">{m.note}</span>}</a>)}</p>
                )}
              </div>
              {g.feature && (
                <a class="mm__feature" href={g.feature.href}>
                  <span class="mm__f-eyebrow">{g.feature.eyebrow}</span>
                  <span class="mm__f-title">{g.feature.title}</span>
                  <span class="mm__f-text">{g.feature.text}</span>
                  <span class="mm__f-art"><Illo name={g.illo!} /></span>
                  <span class="mm__f-cta">{g.feature.cta} →</span>
                </a>
              )}
            </div>
          </li>
        ))}
        <li class="nav-search"><a href="/opportunities" aria-label="Search BECCI" aria-keyshortcuts="Control+K Meta+K" data-search-open><Icon name="search" size={18} /></a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <a class="hdr-login login-link" href="/membership#member-login">Member login</a>
      <a class="btn btn--accent btn--sm" href="/membership#join">Join BECCI</a>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="site-menu" data-menu-open>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <dialog class="mobile-nav" id="site-menu" aria-label="Menu" data-menu>
    <div class="mobile-nav__inner">
      <div class="mobile-nav__top">
        <Logo />
        <button class="menu-toggle" style="display:inline-flex" type="button" aria-label="Close menu" data-menu-close>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4 4 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
      <a class="m-search" href="/opportunities" data-search-open><Icon name="search" size={20} />Search pages and schemes</a>
      {nav.map((g, i) => (
        <details class={`m-grp m-grp--${g.tone}`} open={i === 0}>
          <summary><span class="m-grp__dot" aria-hidden="true"></span>{g.label}</summary>
          <ul>{g.children!.map((c, j) => <li><a href={c.href}><span class={`mm__ic mm__ic--${j % 4}`}><Icon name={c.icon as any} size={20} /></span><span class="m-l">{c.label}</span></a></li>)}</ul>
          {g.more && <p class="m-more">{g.more.map((m) => <a href={m.href}>{m.label}{m.note && <span class="nav-note">{m.note}</span>}</a>)}</p>}
        </details>
      ))}
      <div class="mobile-nav__cta">
        <a class="btn btn--accent" href="/membership#join">Join BECCI</a>
        <a class="btn btn--ghost" href="/membership#member-login">Member login</a>
      </div>
    </div>
  </dialog>
</header>
<HeaderSearch client:idle />
<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('.nav-trigger')];
  const panelOf = (t: HTMLButtonElement) => document.getElementById(t.getAttribute('aria-controls')!)!;
  const closeAll = (except?: HTMLButtonElement) => triggers.forEach((t) => {
    if (t === except) return;
    t.setAttribute('aria-expanded', 'false');
    panelOf(t).removeAttribute('data-open');
  });
  triggers.forEach((t, i) => {
    const panel = panelOf(t);
    const links = () => [...panel.querySelectorAll<HTMLAnchorElement>('a')];
    const open = () => {
      // Moving between open panels swaps content without replaying the entrance
      const switching = triggers.some((o) => o !== t && o.getAttribute('aria-expanded') === 'true');
      closeAll(t); t.setAttribute('aria-expanded', 'true');
      panel.toggleAttribute('data-swap', switching); panel.setAttribute('data-open', '');
    };
    const close = () => { t.setAttribute('aria-expanded', 'false'); panel.removeAttribute('data-open'); };
    t.addEventListener('click', () => (t.getAttribute('aria-expanded') === 'true' ? close() : open()));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); open(); links()[0]?.focus(); }
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); triggers[(i + (e.key === 'ArrowRight' ? 1 : triggers.length - 1)) % triggers.length].focus(); }
    });
    panel.addEventListener('keydown', (e) => {
      const ls = links(); const k = ls.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown' && k > -1) { e.preventDefault(); ls[(k + 1) % ls.length].focus(); }
      if (e.key === 'ArrowUp' && k > -1) { e.preventDefault(); k === 0 ? t.focus() : ls[k - 1].focus(); }
    });
    const item = t.parentElement!;
    let timer: number | undefined; let intent: number | undefined;
    item.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { clearTimeout(timer); intent = window.setTimeout(open, 70); } });
    item.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { clearTimeout(intent); timer = window.setTimeout(close, 220); } });
    item.addEventListener('keydown', (e) => { if (e.key === 'Escape') { close(); t.focus(); } });
    item.addEventListener('focusout', (e) => { if (!item.contains(e.relatedTarget as Node)) close(); });
  });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.nav-item')) closeAll(); });

  const dlg = document.querySelector<HTMLDialogElement>('[data-menu]')!;
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  opener?.addEventListener('click', () => { dlg.showModal(); opener.setAttribute('aria-expanded', 'true'); });
  dlg.addEventListener('close', () => opener?.setAttribute('aria-expanded', 'false'));
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
