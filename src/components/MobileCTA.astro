---
// Thumb-zone action bar (UXPeak Mobile App Design / playbook: primary action within thumb reach).
// Phones only. Hides itself once the form it points to is on screen, so it never covers the form.
interface Props { href: string; label: string; note?: string; target?: string }
const { href, label, note, target } = Astro.props;
---
<div class="m-cta" data-mcta data-target={target ?? href}>
  {note && <span class="m-cta__note">{note}</span>}
  <a class="btn btn--accent" href={href}>{label}</a>
</div>
<style is:global>
  .m-cta { display: none; }
  @media (max-width: 760px) {
    .m-cta { position: fixed; inset: auto 12px max(12px, env(safe-area-inset-bottom)) 12px; z-index: 40; display: flex; align-items: center; gap: var(--s-3); padding: 8px 8px 8px var(--s-4); border-radius: 999px; background: var(--midnight); color: #c8d6ee; box-shadow: 0 16px 32px -12px rgb(8 26 53 / 55%); transition: translate 260ms var(--ease), opacity 200ms; }
    .m-cta[data-hide] { translate: 0 140%; opacity: 0; pointer-events: none; }
    .m-cta__note { flex: 1; min-width: 0; font-size: 0.8125rem; line-height: 1.3; }
    .m-cta .btn { --bg: #fff; --bd: #fff; --fg: var(--midnight); min-height: 44px; margin-left: auto; padding: 0 var(--s-4); font-size: var(--fs-sm); }
    body:has(.m-cta) .site-footer { padding-bottom: 96px; }
  }
</style>
<script>
  const bar = document.querySelector<HTMLElement>('[data-mcta]');
  const t = bar && document.querySelector(bar.dataset.target!);
  if (bar && t && 'IntersectionObserver' in window) {
    const hero = document.querySelector('.page-hero');
    const seen = new Set<Element>();
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
      bar.toggleAttribute('data-hide', seen.size > 0);
    });
    io.observe(t); if (hero) io.observe(hero);
  }
</script>
