---
import { story } from '../data/site';
import InfinityMark from './InfinityMark.astro';
---
<section class="section section--white" aria-labelledby="story-title">
  <div class="wrap">
    <div class="section-head">
      <div><span class="eyebrow">The BECCI story</span><h2 id="story-title">Five letters, one journey</h2></div>
      <p>Move across the letters, or tap them, to follow the journey from a single idea to lasting impact.</p>
    </div>
    <ol class="letters" data-letters>
      {story.map((s, i) => (
        <li class:list={['letter', i === 2 && 'letter--c1', i === 3 && 'letter--c2']} data-active={i === 0 ? '' : undefined}>
          <button type="button" class="letter__btn" id={`letter-${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`letter-panel-${i}`}>
            <span class="letter__glyph" aria-hidden="true">{s.letter}</span>
            <span class="letter__name"><span class="visually-hidden">{s.letter} — </span>{s.name}</span>
            {(i === 2 || i === 3) && (
              <span class="letter__pair" aria-hidden="true"><InfinityMark class="letter__inf letter__inf--navy" tone="color" /><InfinityMark class="letter__inf letter__inf--white" tone="light" /><span>{i === 2 ? 'Community' : 'Commerce'}</span></span>
            )}
          </button>
          <div class="letter__panel" id={`letter-panel-${i}`} role="region" aria-labelledby={`letter-${i}`}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .letters { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--s-3); min-height: 380px; counter-reset: ch; }
  .letter { position: relative; flex: 1 1 0; min-width: 0; border-radius: var(--radius); background: var(--paper); border: 1px solid var(--line-2); transition: flex-grow 520ms var(--ease), background 300ms, border-color 300ms; overflow: hidden; }
  .letter[data-active] { flex-grow: 3.2; background: var(--blue-900); border-color: var(--blue-900); }
  .letter--c2[data-active] { background: var(--blue-700); border-color: var(--blue-700); }
  .letter__btn { all: unset; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-3); width: 100%; height: 100%; min-height: 380px; padding: var(--s-5) var(--s-5); position: absolute; inset: 0; }
  .letter__btn:focus-visible { outline: 3px solid var(--accent-500); outline-offset: -3px; border-radius: var(--radius); }
  .letter__glyph { font: 600 clamp(4rem, 7vw, 6.5rem)/0.9 var(--font-display); color: var(--blue-800); transition: color 300ms; }
  .letter--c2 .letter__glyph { color: var(--accent-500); }
  .letter__name { font: 600 var(--fs-sm)/1.3 var(--font-body); color: var(--muted); max-width: 16ch; }
  .letter[data-active] .letter__glyph { color: var(--accent-300); }
  .letter[data-active] .letter__name { color: #c9d4e8; }
  .letter__panel { position: absolute; left: 20px; right: 20px; bottom: 24px; max-width: 34ch; opacity: 0; transform: translateY(8px); transition: opacity 300ms, transform 400ms var(--ease); pointer-events: none; }
  .letter[data-active] .letter__panel { opacity: 1; transform: none; transition-delay: 180ms; }
  .letter[data-active] .letter__name { opacity: 0; }
  .letter__panel h3 { color: #fff; font-size: var(--step-2); }
  .letter__panel p { color: #dbe3f1; margin: 0; }
  .letter__pair { position: static; display: inline-flex; align-items: center; gap: var(--s-2); font: 600 var(--fs-label)/1 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue-700); }
  .letter--c2 .letter__pair { color: var(--accent-700); }
  .letter[data-active] .letter__pair { color: var(--accent-300); position: absolute; top: 24px; right: 20px; }
  .letter__pair :global(.letter__inf) { width: 34px; height: auto; }
  .letter__pair :global(.letter__inf--white), .letter[data-active] .letter__pair :global(.letter__inf--navy) { display: none; }
  .letter[data-active] .letter__pair :global(.letter__inf--white) { display: block; }
  @media (max-width: 760px) {
    .letters { flex-direction: column; min-height: 0; }
    .letter { flex: none; }
    .letter__btn { position: relative; inset: auto; min-height: 0; flex-direction: row; align-items: center; padding: var(--s-4) var(--s-4); }
    .letter__glyph { font-size: var(--fs-2xl); width: 1.2em; }
    .letter__name { max-width: none; flex: 1; }
    .letter[data-active] .letter__name { opacity: 1; }
    .letter__panel { position: static; display: none; padding: 0 var(--s-4) var(--s-5) var(--s-4); max-width: none; transform: none; }
    .letter[data-active] .letter__panel { display: block; }
    .letter__pair, .letter[data-active] .letter__pair { position: static; margin-left: auto; }
  }
</style>
<script>
  const list = document.querySelector('[data-letters]');
  if (list) {
    const items = Array.from(list.querySelectorAll<HTMLLIElement>('.letter'));
    const activate = (li: HTMLLIElement) => items.forEach((x) => {
      const on = x === li;
      x.toggleAttribute('data-active', on);
      x.querySelector('.letter__btn')!.setAttribute('aria-expanded', String(on));
    });
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    items.forEach((li, i) => {
      const btn = li.querySelector<HTMLButtonElement>('.letter__btn')!;
      btn.addEventListener('click', () => activate(li));
      btn.addEventListener('focus', () => activate(li));
      li.addEventListener('pointerenter', () => { if (fine.matches) activate(li); });
      btn.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        const next = k === 'ArrowRight' || k === 'ArrowDown' ? i + 1 : k === 'ArrowLeft' || k === 'ArrowUp' ? i - 1 : k === 'Home' ? 0 : k === 'End' ? items.length - 1 : null;
        if (next === null) return;
        e.preventDefault();
        items[(next + items.length) % items.length].querySelector<HTMLButtonElement>('.letter__btn')!.focus();
      });
    });
  }
</script>
