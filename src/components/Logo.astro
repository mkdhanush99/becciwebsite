---
// Official BECCI logo (BECCI_Logo_R2_Final, horizontal lockup, Continuum Navy #0A2352 / white).
// Files are used exactly as supplied: public/brand/becci-logo.svg = 06_Web/logo.svg,
// public/brand/becci-logo-light.svg = 06_Web/logo-white.svg. Never recolour, stretch or retype.
// Minimum size: 96px wide. Clear space: half the cap height on every side.
interface Props { tone?: 'dark' | 'light'; full?: boolean; class?: string }
const { tone = 'dark', full = true, class: cls = '' } = Astro.props;
const src = tone === 'light' ? '/brand/becci-logo-light.svg' : '/brand/becci-logo.svg';
---
<span class:list={['brand__text', `brand__text--${tone}`, cls]}>
  <img class="brand__logo" src={src} alt="BECCI" width="427" height="105" decoding="async" />
  {full && <span class="brand__full"><span class="brand__name">Bahujan Entrepreneurs Chamber for Commerce &amp; Industry</span><span class="brand__tag">Building Businesses <i aria-hidden="true">•</i> Building Bharat</span></span>}
</span>
<style is:global>
  .brand__text { display: inline-flex; align-items: center; gap: var(--s-3); }
  .brand__logo { display: block; width: auto; height: 28px; max-width: none; }
  .brand__full { display: grid; gap: 5px; font: 500 0.6875rem/1.25 var(--font-body); color: var(--slate); padding-left: var(--s-3); border-left: 1px solid var(--silver-300); }
  .brand__name { color: var(--midnight); font-weight: 600; white-space: nowrap; }
  .brand__tag { display: inline-flex; align-items: center; gap: 6px; font: 700 0.5625rem/1 var(--font-body); letter-spacing: 0.16em; text-transform: uppercase; color: #A9874C; white-space: nowrap; }
  .brand__tag i { font-style: normal; color: #C6A15B; }
  @media (max-width: 1100px) { .brand__name { white-space: normal; max-width: 31ch; } }
  .brand__text--light .brand__full { color: var(--on-dark-2); border-left-color: rgb(255 255 255 / 20%); }
  .brand__text--light .brand__name { color: #fff; }
  @media (max-width: 560px) { .brand__full { display: none; } .brand__logo { height: 24px; } }
</style>
