---
// Photography slot. Uses the approved photo when present in /public, otherwise a
// deliberate graphic panel built from the BECCI emblem (never stock imagery).
import { hasPublic } from '../lib/asset';
import InfinityMark from './InfinityMark.astro';
interface Props { src: string; alt: string; ratio?: string; class?: string; eager?: boolean; caption?: string }
const { src, alt, ratio = '4 / 3', class: cls = '', eager = false, caption } = Astro.props;
const present = hasPublic(src);
---
<figure class:list={['media', 'brand-media', cls]} style={`aspect-ratio:${ratio}`} data-media={present ? 'photo' : 'graphic'}>
  {present ? (
    <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class="brand-media__graphic" aria-hidden="true">
      <svg class="brand-media__grid" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
        <defs><pattern id="bm-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="currentColor" stroke-width="0.5" /></pattern></defs>
        <rect width="400" height="300" fill="url(#bm-grid)" />
      </svg>
      <InfinityMark class="brand-media__mark" tone="light" />
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style is:global>
  .brand-media { margin: 0; }
  .brand-media__graphic { position: absolute; inset: 0; background: radial-gradient(90% 80% at 70% 30%, #173a74 0%, var(--midnight-2) 55%, var(--midnight) 100%); display: grid; place-items: center; }
  .brand-media__grid { position: absolute; inset: 0; width: 100%; height: 100%; color: rgb(169 195 240 / 14%); }
  .brand-media__mark { position: relative; width: 62%; max-width: 420px; opacity: 0.9; }
  .brand-media figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: var(--s-3) var(--s-4); font-size: var(--fs-sm); color: #fff; background: linear-gradient(transparent, rgb(10 22 48 / 70%)); }
</style>
