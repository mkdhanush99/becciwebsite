---
import InfinityMark from './InfinityMark.astro';
---
<div class="hero-art" aria-hidden="true">
  <canvas class="hero-canvas" data-hero-canvas></canvas>
  <InfinityMark class="hero-static" tone="light" />
  <span class="hero-label hero-label--l">Community</span>
  <span class="hero-label hero-label--r">Commerce</span>
</div>
<style>
  .hero-art { position: relative; aspect-ratio: 2 / 1.15; width: 100%; }
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  :global(.hero-static) { position: absolute; inset: 12% 6%; width: 88%; height: 76%; opacity: 0; transition: opacity 600ms; }
  .hero-label { position: absolute; top: 50%; translate: 0 -50%; font: 600 0.78rem/1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-300); opacity: 0; transition: opacity 900ms 200ms; }
  .hero-label--l { left: 27%; translate: -50% -50%; } .hero-label--r { left: 73%; translate: -50% -50%; }
  :global(.hero-art[data-formed]) .hero-label { opacity: 0.95; }
  :global(.hero-art[data-static] .hero-static) { opacity: 1; }
  :global(.hero-art[data-static]) .hero-canvas { display: none; }
  :global(.hero-art[data-static]) .hero-label { opacity: 0.95; transition: none; }
  @media (max-width: 520px) { .hero-label { font-size: 0.66rem; letter-spacing: 0.1em; } }
</style>
<script>
  const art = document.querySelector<HTMLElement>('.hero-art');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (art && canvas) {
    const ctx = canvas.getContext('2d');
    if (!ctx || reduce.matches) {
      art.setAttribute('data-static', '');
    } else {
      let w = 0, h = 0, dpr = 1, raf = 0, start = 0, running = false;
      const N = 150;
      type P = { phase: number; join: number; size: number; drift: number; hue: number };
      const ps: P[] = Array.from({ length: N }, (_, i) => ({
        phase: Math.random() * Math.PI * 2,
        join: i === 0 ? 0 : 0.6 + Math.pow(i / N, 0.8) * 4.2, // seconds before joining
        size: i === 0 ? 3.2 : 0.8 + Math.random() * 1.8,
        drift: (Math.random() - 0.5) * 0.08,
        hue: Math.random(),
      }));
      const resize = () => {
        const r = canvas.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width; h = r.height;
        canvas.width = w * dpr; canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      // Bernoulli lemniscate, blended from a circle while the motion "gathers momentum".
      const point = (t: number, form: number) => {
        const a = w * 0.42, cx = w / 2, cy = h / 2;
        const s = Math.sin(t), c = Math.cos(t), d = 1 + s * s;
        const lx = (a * c) / d, ly = (a * s * c) / d * 1.25;
        const r = Math.min(w, h) * 0.12;
        const ox = r * Math.cos(t * 2), oy = r * Math.sin(t * 2);
        return [cx + ox + (lx - ox) * form, cy + oy + (ly - oy) * form];
      };
      const frame = (now: number) => {
        if (!start) start = now;
        const el = (now - start) / 1000;
        const form = Math.min(1, Math.max(0, (el - 1.2) / 2.6));
        const eased = 1 - Math.pow(1 - form, 3);
        const speed = 0.35 + Math.min(el, 3) * 0.12;
        if (form >= 1 && !art.hasAttribute('data-formed')) art.setAttribute('data-formed', '');
        ctx.globalCompositeOperation = 'destination-out';
        ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
        ctx.fillRect(0, 0, w, h);
        ctx.globalCompositeOperation = 'lighter';
        for (const p of ps) {
          if (el < p.join) continue;
          const appear = Math.min(1, (el - p.join) / 0.8);
          const t = p.phase + el * speed + p.drift * el;
          let [x, y] = point(t, eased);
          if (appear < 1) { // drift in from outside the formation
            const fx = w / 2 + Math.cos(p.phase * 3) * w * 0.6, fy = h / 2 + Math.sin(p.phase * 5) * h * 0.6;
            x = fx + (x - fx) * appear; y = fy + (y - fy) * appear;
          }
          const gold = p.hue > 0.35;
          const g = ctx.createRadialGradient(x, y, 0, x, y, p.size * 5);
          g.addColorStop(0, gold ? 'rgba(244, 214, 140, 0.95)' : 'rgba(190, 210, 255, 0.9)');
          g.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = g;
          ctx.beginPath(); ctx.arc(x, y, p.size * 5, 0, Math.PI * 2); ctx.fill();
        }
        raf = requestAnimationFrame(frame);
      };
      const play = () => { if (!running) { running = true; raf = requestAnimationFrame(frame); } };
      const pause = () => { running = false; cancelAnimationFrame(raf); };
      resize();
      new ResizeObserver(resize).observe(canvas);
      new IntersectionObserver(([e]) => (e.isIntersecting ? play() : pause())).observe(canvas);
      document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
      reduce.addEventListener('change', (e) => { if (e.matches) { pause(); art.setAttribute('data-static', ''); } });
    }
  }
</script>
