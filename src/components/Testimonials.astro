---
// Testimonials (Critique §4.4): feedback from members, entrepreneurs and partners, in their own words,
// published only with their consent. One endless sideways scroll: the list is drawn twice and the track moves
// by exactly one copy, so the loop has no seam and never ends. Hover or focus pauses it; with reduced motion
// it becomes a normal horizontal scroller.
import { testimonials } from '../data/site';
import SampleBadge from './SampleBadge.astro';
const tones = ['light', 'navy', 'light', 'dark'];
---
{testimonials.length > 0 && (
  <section class="tst" aria-labelledby="tst-title">
    <div class="wrap tst__head">
      <span class="story-kicker">05 · Voices</span>
      <h2 id="tst-title">In their words</h2>
    </div>
    <div class="tst__viewport" tabindex="0" aria-label="Testimonials, scrolling">
      <div class="tst__track" style={`--n:${testimonials.length}`}>
        {[0, 1].map((copy) => (
          <ul class="tst__list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {testimonials.map((x, i) => (
              <li class:list={['tst__card', `tst__card--${tones[i % tones.length]}`]}>
                <blockquote><p>“{x.quote}”</p></blockquote>
                <div class="tst__who">
                  {x.photo && <img src={x.photo} alt="" width="56" height="56" loading="lazy" decoding="async" />}
                  <span><strong>{x.name}</strong><span>{x.context}</span></span>
                  {x.sample && <SampleBadge />}
                </div>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .tst { padding-block: clamp(72px, 9vw, 128px); background: #fff; overflow: hidden; }
  .tst__head { margin-bottom: clamp(32px, 4vw, 56px); }
  .tst__head h2 { margin: 0; font-size: clamp(1.75rem, 1.3rem + 2.4vw, 2.625rem); letter-spacing: -0.015em; }
  .tst__viewport { position: relative; outline: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .tst__track { display: flex; width: max-content; animation: tst-scroll calc(var(--n) * 9s) linear infinite; }
  .tst__viewport:hover .tst__track, .tst__viewport:focus-within .tst__track { animation-play-state: paused; }
  @keyframes tst-scroll { to { transform: translateX(-50%); } }
  .tst__list { display: flex; gap: 20px; margin: 0; padding: 0 10px; list-style: none; }
  .tst__card { display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-5); width: 400px; min-height: 260px; padding: 28px; border-radius: 16px; border: 1px solid rgb(10 35 82 / 12%); }
  .tst__card--light { background: var(--ivory); color: var(--midnight); }
  .tst__card--navy { background: #0A2352; color: #fff; border-color: transparent; }
  .tst__card--dark { background: #061638; color: #fff; border-color: transparent; }
  .tst__card blockquote { margin: 0; }
  .tst__card blockquote p { margin: 0; font: 500 1.0625rem/1.55 var(--font-body); }
  .tst__who { display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
  .tst__who img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; }
  .tst__who > span { display: grid; gap: 2px; }
  .tst__who strong { font: 700 1rem/1.25 var(--font-display); }
  .tst__who > span > span { font-size: var(--fs-sm); opacity: 0.75; }
  @media (prefers-reduced-motion: reduce) {
    .tst__viewport { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .tst__track { animation: none; }
    .tst__list[aria-hidden] { display: none; }
  }
  @media (max-width: 560px) { .tst__card { width: 300px; min-height: 240px; padding: 22px; } }
</style>
