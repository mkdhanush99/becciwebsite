---
// Page banner. Variants share one structure:
//  editorial (default) — light surface (tone: ivory | ice | sky | cyan); for reading and directory pages.
//  feature — dark surface (tone: midnight | royal); for pages that ask the visitor to act.
// An `icon` adds a spot illustration so each page has its own composition.
import Kinetic from './Kinetic.astro';
import Spot from './Spot.astro';
import Illo from './Illo.astro';
interface Props { title: string; lede?: string; eyebrow?: string; note?: string; variant?: 'editorial' | 'feature'; tone?: 'ivory' | 'ice' | 'sky' | 'cyan' | 'midnight' | 'royal'; icon?: string; illo?: 'finder' | 'chamber' | 'members' | 'updates'; crumbs?: { label: string; href?: string }[] }
const { title, lede, note, variant = 'editorial', tone, icon, illo, crumbs = [] } = Astro.props;
const feature = variant === 'feature';
const t = tone ?? (feature ? 'midnight' : 'ivory');
const n = title.split(' ').length;
---
<header class:list={['page-hero', `page-hero--${variant}`, `page-hero--t-${t}`, (icon || illo) && 'page-hero--spot', feature && 'on-dark']}>
  <div class="lux" aria-hidden="true"><span class="lux__a"></span><span class="lux__b"></span></div>
  <div class="wrap page-hero__inner">
    <div class="page-hero__copy">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>{crumbs.map((c) => <><span aria-hidden="true"> / </span>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</>)}
        </nav>
      )}
      <h1 class="kinetic-title"><Kinetic text={title} />{note && <span class="page-hero__note">{note}</span>}</h1>
      {lede && <p class="lede m-in" style={`--i:${n + 1}`}>{lede}</p>}
      <div class="m-in" style={`--i:${n + 2}`}><slot /></div>
    </div>
    {illo ? <div class="page-hero__illo m-in" aria-hidden="true"><Illo name={illo} /></div> : icon && <Spot icon={icon} dark={feature} class="page-hero__spot m-in" />}
  </div>
</header>
