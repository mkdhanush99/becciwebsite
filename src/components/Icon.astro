---
// BECCI icon family. One geometry: 24px grid, 1.75 stroke, round caps and joins,
// plus one filled accent shape per icon (colour via --icon-accent). Decorative by default;
// pass `label` when the icon carries meaning on its own.
type IconName = 'women' | 'youth' | 'entrepreneur' | 'commerce' | 'community' | 'schemes' | 'tenders' | 'scholarship' | 'jobs' | 'funding' | 'education' | 'leadership' | 'partnership' | 'events' | 'knowledge' | 'membership' | 'support' | 'chapters' | 'sectors' | 'franchise' | 'stories' | 'news' | 'services' | 'search' | 'arrow';
interface Props { name: IconName; size?: number; label?: string; class?: string }
const { name, size = 24, label, class: cls = '' } = Astro.props;

// a = accent (filled), s = strokes
const I: Record<IconName, { a?: string; s: string }> = {
  // Women's Wing: a figure crowned by a rising bloom (leadership and growth)
  women: { a: '<circle cx="12" cy="4.6" r="2.1"/>', s: '<circle cx="12" cy="10" r="2.6"/><path d="M6.5 20.5c.6-3.6 2.8-5.8 5.5-5.8s4.9 2.2 5.5 5.8"/><path d="M9.6 4.2c.8-1.4 1.6-2 2.4-2s1.6.6 2.4 2"/>' },
  // Youth Wing: a seedling breaking ground with an upward path (beginning)
  youth: { a: '<path d="M12 10.5c0-3.6 2.4-6 6-6 0 3.6-2.4 6-6 6Z"/>', s: '<path d="M12 21v-10.5"/><path d="M12 13c0-2.8-1.9-4.7-4.7-4.7 0 2.8 1.9 4.7 4.7 4.7Z"/><path d="M4 21h16"/><path d="M15.5 17.5 18 15l2.5 2.5"/>' },
  entrepreneur: { a: '<path d="M9.5 17.5h5v1.6a2.5 2.5 0 0 1-5 0Z"/>', s: '<path d="M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.4 1.1 2.3v1.4h5v-1.4c0-.9.4-1.7 1.1-2.3A6 6 0 0 0 12 3Z"/><path d="M12 7.5v3l1.6 1.2"/>' },
  commerce: { a: '<circle cx="12" cy="12" r="3"/>', s: '<path d="M4 8.5h13l-3-3"/><path d="M20 15.5H7l3 3"/>' },
  community: { a: '<circle cx="12" cy="7" r="2.6"/>', s: '<circle cx="5.5" cy="12" r="2.2"/><circle cx="18.5" cy="12" r="2.2"/><path d="M2.5 20c.4-2.4 1.7-3.8 3.5-3.8M21.5 20c-.4-2.4-1.7-3.8-3.5-3.8"/><path d="M7.5 20.5c.5-3.6 2.2-5.5 4.5-5.5s4 1.9 4.5 5.5"/>' },
  schemes: { a: '<path d="M12 3 3.5 7.5h17Z"/>', s: '<path d="M12 3 3.5 7.5h17Z"/><path d="M5.5 10.5v7M10 10.5v7M14 10.5v7M18.5 10.5v7"/><path d="M3 20.5h18"/>' },
  tenders: { a: '<rect x="8" y="2.5" width="8" height="4" rx="1.2"/>', s: '<path d="M8 4.5H6.5A1.5 1.5 0 0 0 5 6v13.5A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H16"/><path d="m8.5 13 2.2 2.2 4.8-4.7"/>' },
  scholarship: { a: '<path d="M12 4 2.5 9 12 14l9.5-5Z"/>', s: '<path d="M12 4 2.5 9 12 14l9.5-5Z"/><path d="M6.5 11.2v4.3c0 1.5 2.5 3 5.5 3s5.5-1.5 5.5-3v-4.3"/><path d="M21.5 9v5"/>' },
  jobs: { a: '<rect x="3" y="11" width="18" height="3" rx="1"/>', s: '<rect x="3" y="7" width="18" height="13" rx="2.2"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/>' },
  funding: { a: '<ellipse cx="12" cy="6" rx="6.5" ry="2.6"/>', s: '<ellipse cx="12" cy="6" rx="6.5" ry="2.6"/><path d="M5.5 6v5c0 1.4 2.9 2.6 6.5 2.6s6.5-1.2 6.5-2.6V6"/><path d="M5.5 11v5c0 1.4 2.9 2.6 6.5 2.6s6.5-1.2 6.5-2.6v-5"/>' },
  education: { a: '<path d="M12 6.5c-2-1.6-4.6-2.2-8.5-2v13c3.9-.2 6.5.4 8.5 2Z"/>', s: '<path d="M12 6.5c-2-1.6-4.6-2.2-8.5-2v13c3.9-.2 6.5.4 8.5 2 2-1.6 4.6-2.2 8.5-2v-13c-3.9-.2-6.5.4-8.5 2Z"/><path d="M12 6.5v13"/>' },
  leadership: { a: '<path d="M6 4h11l-2.5 3.5L17 11H6Z"/>', s: '<path d="M6 21V3.5"/><path d="M6 4h11l-2.5 3.5L17 11H6"/><path d="M3.5 21h6"/>' },
  partnership: { a: '<circle cx="9" cy="12" r="5.5"/>', s: '<circle cx="9" cy="12" r="5.5"/><circle cx="15" cy="12" r="5.5"/>' },
  events: { a: '<rect x="13" y="13" width="4" height="4" rx="1"/>', s: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.2"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>' },
  knowledge: { a: '<circle cx="10.5" cy="10.5" r="4"/>', s: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/><path d="M8.5 10.5h4M10.5 8.5v4"/>' },
  membership: { a: '<circle cx="8.5" cy="11" r="2.3"/>', s: '<rect x="2.5" y="5" width="19" height="14" rx="2.2"/><path d="M5 16.5c.5-1.6 1.8-2.5 3.5-2.5s3 .9 3.5 2.5"/><path d="M14.5 10h4.5M14.5 13.5h3"/>' },
  support: { a: '<path d="M8 10.5h8v2.5H8Z"/>', s: '<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 3.5V17A2.5 2.5 0 0 1 4 14.5Z"/>' },
  chapters: { a: '<circle cx="12" cy="9.5" r="2.6"/>', s: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/>' },
  sectors: { a: '<rect x="13" y="3.5" width="7.5" height="7.5" rx="1.6"/>', s: '<rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.6"/><rect x="13" y="3.5" width="7.5" height="7.5" rx="1.6"/><rect x="3.5" y="13" width="7.5" height="7.5" rx="1.6"/><rect x="13" y="13" width="7.5" height="7.5" rx="1.6"/>' },
  franchise: { a: '<path d="M4 9.5h16v2a3 3 0 0 1-5.3 1.9A3 3 0 0 1 12 14.5a3 3 0 0 1-2.7-1.1A3 3 0 0 1 4 11.5Z"/>', s: '<path d="M5.5 4h13L20 9.5H4Z"/><path d="M5.5 14v6.5h13V14"/><path d="M10 20.5v-4h4v4"/>' },
  stories: { a: '<path d="M7 3.5h10v6l-5-2.8-5 2.8Z"/>', s: '<rect x="4" y="3.5" width="16" height="17" rx="2.2"/><path d="M8 14h8M8 17h5"/>' },
  news: { a: '<rect x="7" y="7" width="5" height="4" rx=".8"/>', s: '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h11A1.5 1.5 0 0 1 18 5.5V19a1.5 1.5 0 0 0 3 0V9h-3"/><path d="M7 14.5h8M7 17.5h6M14 7.5h1M14 10.5h1"/>' },
  services: { a: '<circle cx="12" cy="12" r="2.8"/>', s: '<path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8"/><circle cx="12" cy="12" r="5.5"/>' },
  search: { s: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/>' },
  arrow: { s: '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>' },
};
const icon = I[name];
---
<svg class:list={['icon', `icon--${name}`, cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false">
  {icon.a && <g class="icon__accent" stroke="none" set:html={icon.a} />}
  <g set:html={icon.s} />
</svg>
