---
// BECCI AI: the site-wide assistant. A small floating button opens a chat panel. Questions go to
// /api/chat.php (PHP on the server, which holds the API key and answers only from the site's own content).
// History stays in this browser (localStorage) until the visitor clears it.
---
<div class="bai" data-bai>
  <button class="bai__fab" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="bai-panel" data-bai-open>
    <span class="bai__fab-ring" aria-hidden="true"></span>
    <img class="bai__fab-ic" src="/brand/becci-symbol-white.svg" alt="" width="34" height="17" decoding="async" />
    <span class="bai__fab-l">BECCI <b>AI</b></span>
  </button>

  <section class="bai__panel" id="bai-panel" role="dialog" aria-modal="false" aria-labelledby="bai-title" hidden data-bai-panel>
    <header class="bai__head">
      <span class="bai__av" aria-hidden="true"><img src="/brand/becci-symbol-white.svg" alt="" width="22" height="11" /></span>
      <span class="bai__ht">
        <strong id="bai-title">BECCI AI</strong>
        <span class="bai__st"><i aria-hidden="true"></i>From the BECCI website</span>
      </span>
      <button class="bai__hb" type="button" data-bai-clear aria-label="Clear chat" title="Clear chat">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
      </button>
      <button class="bai__hb" type="button" data-bai-close aria-label="Close BECCI AI" title="Close">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </header>

    <div class="bai__log" role="log" aria-live="polite" aria-relevant="additions" tabindex="0" data-bai-log></div>

    <div class="bai__sugs" data-bai-sugs>
      <button type="button">How do I become a member?</button>
      <button type="button">Show me government schemes</button>
      <button type="button">Loans for my business</button>
      <button type="button">What does BC mean in BECCI?</button>
      <button type="button">Open the events page</button>
      <button type="button">How do I contact BECCI?</button>
    </div>

    <form class="bai__form" data-bai-form>
      <label for="bai-q" class="visually-hidden">Ask BECCI AI</label>
      <textarea id="bai-q" rows="1" maxlength="1500" placeholder="Ask BECCI AI anything…" autocomplete="off" data-bai-input></textarea>
      <button class="bai__send" type="submit" aria-label="Send" data-bai-send>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </form>
    <p class="bai__fine">BECCI AI can make mistakes. Check important details on the linked page.</p>
  </section>
</div>

<style is:global>
  .bai { --bai-navy: #0A2352; --bai-mid: #061638; --bai-gold: #C6A15B; --bai-gold-d: #A9874C; --bai-ivory: #F7F5EF; --bai-tint: #e9edf4; font-family: var(--font-body); }
  .bai__fab { position: fixed; right: max(20px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom)); z-index: 70; isolation: isolate; overflow: hidden;
    display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; width: 70px; height: 70px; padding: 0; border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 28%); color: #fff; cursor: pointer;
    background: linear-gradient(145deg, rgb(255 255 255 / 22%), rgb(255 255 255 / 4%) 45%, rgb(198 161 91 / 14%)), rgb(10 35 82 / 62%);
    -webkit-backdrop-filter: blur(14px) saturate(160%); backdrop-filter: blur(14px) saturate(160%);
    box-shadow: 0 14px 34px -12px rgb(6 22 56 / 60%), inset 0 1px 0 rgb(255 255 255 / 45%), inset 0 -10px 18px -10px rgb(198 161 91 / 45%), 0 0 0 1px rgb(198 161 91 / 35%);
    transition: transform 220ms cubic-bezier(.34,1.56,.64,1), box-shadow 220ms, opacity 200ms, translate 260ms cubic-bezier(.2,.8,.2,1); }
  .bai__fab::before { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: radial-gradient(70% 45% at 35% 12%, rgb(255 255 255 / 45%), transparent 70%); pointer-events: none; }
  .bai__fab::after { content: ""; position: absolute; top: -40%; left: -60%; width: 40%; height: 180%; z-index: -1; background: linear-gradient(90deg, transparent, rgb(255 255 255 / 35%), transparent); transform: rotate(20deg); animation: bai-sheen 4.5s ease-in-out infinite; pointer-events: none; }
  @keyframes bai-sheen { 0%, 60% { left: -60%; } 85%, 100% { left: 130%; } }
  .bai__fab:hover { transform: translateY(-2px) scale(1.05); box-shadow: 0 18px 38px -12px rgb(6 22 56 / 65%), inset 0 1px 0 rgb(255 255 255 / 55%), inset 0 -10px 18px -10px rgb(198 161 91 / 60%), 0 0 0 1px rgb(198 161 91 / 60%); }
  .bai__fab:active { transform: scale(0.94); }
  .bai__fab:focus-visible { outline: 3px solid var(--bai-gold); outline-offset: 3px; }
  .bai__fab-ic { width: 34px; height: auto; filter: drop-shadow(0 1px 2px rgb(6 22 56 / 50%)); animation: bai-breathe 3.2s ease-in-out infinite; }
  @keyframes bai-breathe { 50% { transform: scale(1.08); } }
  .bai__fab-l { font: 700 0.5625rem/1 var(--font-display, inherit); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; text-shadow: 0 1px 2px rgb(6 22 56 / 60%); }
  .bai__fab-l b { color: var(--bai-gold); }
  .bai__fab-ring { position: absolute; inset: -6px; border-radius: 50%; border: 1px solid rgb(198 161 91 / 45%); animation: bai-ring 3.2s ease-out infinite; pointer-events: none; }
  @keyframes bai-ring { 0% { transform: scale(0.92); opacity: 0.9; } 70%, 100% { transform: scale(1.18); opacity: 0; } }
  .bai[data-open] .bai__fab, body:has(dialog[open]) .bai__fab { transform: scale(0.6); opacity: 0; pointer-events: none; }
  @media (max-width: 760px) { body:has(.m-cta:not([data-hide])) .bai__fab { translate: 0 -76px; } }

  .bai__panel { position: fixed; right: max(20px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom)); z-index: 71;
    display: flex; flex-direction: column; width: min(380px, calc(100vw - 32px)); height: min(580px, calc(100dvh - 150px));
    border-radius: 22px; overflow: hidden; background: #fff; color: var(--bai-mid);
    border: 1px solid rgb(10 35 82 / 14%); box-shadow: 0 30px 70px -20px rgb(6 22 56 / 45%), 0 0 0 1px rgb(198 161 91 / 18%);
    transform-origin: calc(100% - 34px) calc(100% - 34px); }
  .bai__panel[hidden] { display: none; }
  .bai__panel[data-in] { animation: bai-pop 340ms cubic-bezier(.34,1.56,.64,1) both; }
  .bai__panel[data-out] { animation: bai-out 160ms ease-in both; }
  @keyframes bai-pop { from { opacity: 0; transform: scale(0.4) translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes bai-out { to { opacity: 0; transform: scale(0.85) translateY(10px); } }

  .bai__head { display: flex; align-items: center; gap: 10px; padding: 14px 12px 14px 16px; background: linear-gradient(160deg, var(--bai-navy), var(--bai-mid)); color: #fff; border-bottom: 2px solid var(--bai-gold); }
  .bai__av { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 50%; background: rgb(198 161 91 / 16%); color: var(--bai-gold); border: 1px solid rgb(198 161 91 / 55%); }
  .bai__ht { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .bai__ht strong { font: 700 1rem/1.1 var(--font-display, inherit); letter-spacing: 0.01em; }
  .bai__st { display: inline-flex; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; align-items: center; gap: 6px; font-size: 0.75rem; color: #c8d2e4; }
  .bai__st i { width: 7px; height: 7px; border-radius: 50%; background: var(--bai-gold); box-shadow: 0 0 0 3px rgb(198 161 91 / 22%); }
  .bai__hb { display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 10px; background: transparent; color: #dfe5ee; cursor: pointer; transition: background 160ms, color 160ms; }
  .bai__hb:hover { background: rgb(255 255 255 / 10%); color: #fff; }
  .bai__hb:focus-visible { outline: 2px solid var(--bai-gold); outline-offset: 1px; }

  .bai__log { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 18px 14px 8px; display: flex; flex-direction: column; gap: 12px; background: var(--bai-ivory); scroll-behavior: smooth; }
  .bai__log:focus-visible { outline: 2px solid var(--bai-gold); outline-offset: -2px; }
  .bai__m { display: flex; flex-direction: column; gap: 8px; max-width: 88%; animation: bai-msg 260ms cubic-bezier(.2,.8,.2,1) both; }
  @keyframes bai-msg { from { opacity: 0; transform: translateY(8px); } }
  .bai__m--u { align-self: flex-end; align-items: flex-end; }
  .bai__b { padding: 10px 14px; border-radius: 16px; font-size: 0.9375rem; line-height: 1.5; overflow-wrap: anywhere; }
  .bai__m--u .bai__b { background: var(--bai-navy); color: #fff; border-bottom-right-radius: 5px; }
  .bai__m--a .bai__b { background: #fff; color: var(--bai-mid); border: 1px solid rgb(10 35 82 / 10%); border-bottom-left-radius: 5px; }
  .bai__b p { margin: 0; } .bai__b p + p, .bai__b p + ul, .bai__b ul + p { margin-top: 8px; }
  .bai__b ul { margin: 6px 0 0; padding-left: 18px; } .bai__b li + li { margin-top: 3px; }
  .bai__b strong { font-weight: 700; color: var(--bai-navy); }
  .bai__links { display: flex; flex-direction: column; gap: 6px; }
  .bai__link { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 12px; background: #fff; border: 1px solid rgb(198 161 91 / 55%); color: var(--bai-navy); font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: transform 160ms, background 160ms, border-color 160ms; }
  .bai__link:hover { transform: translateY(-1px); background: #fbf8f1; border-color: var(--bai-gold); }
  .bai__link:focus-visible { outline: 2px solid var(--bai-gold); outline-offset: 2px; }
  .bai__link span { flex: 1; min-width: 0; }
  .bai__link svg { flex: none; color: var(--bai-gold-d); }
  .bai__open { font-size: 0.8125rem; color: var(--bai-gold-d); font-weight: 600; }
  .bai__typing { display: inline-flex; gap: 5px; padding: 14px 16px; }
  .bai__typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--bai-navy); opacity: 0.35; animation: bai-dot 1.1s infinite ease-in-out; }
  .bai__typing i:nth-child(2) { animation-delay: 0.15s; } .bai__typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes bai-dot { 0%, 80%, 100% { opacity: 0.3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-4px); } }

  .bai__sugs { display: flex; gap: 8px; padding: 10px 14px 4px; overflow-x: auto; scrollbar-width: none; background: var(--bai-ivory); }
  .bai__sugs::-webkit-scrollbar { display: none; }
  .bai__sugs[hidden] { display: none; }
  .bai__sugs button { flex: none; padding: 8px 12px; border-radius: 999px; border: 1px solid rgb(10 35 82 / 18%); background: #fff; color: var(--bai-navy); font: 600 0.8125rem/1.2 var(--font-body); cursor: pointer; transition: border-color 160ms, background 160ms; }
  .bai__sugs button:hover { border-color: var(--bai-gold); background: #fbf8f1; }
  .bai__sugs button:focus-visible { outline: 2px solid var(--bai-gold); outline-offset: 1px; }

  .bai__form { display: flex; align-items: flex-end; gap: 8px; padding: 10px 12px 6px; background: #fff; border-top: 1px solid rgb(10 35 82 / 10%); }
  .bai__form textarea { flex: 1; min-height: 44px; max-height: 120px; padding: 11px 14px; border-radius: 14px; border: 1px solid rgb(10 35 82 / 20%); background: #fff; color: var(--bai-mid); font: 400 16px/1.4 var(--font-body); resize: none; }
  .bai__form textarea:focus { outline: none; border-color: var(--bai-navy); box-shadow: 0 0 0 3px rgb(198 161 91 / 35%); }
  .bai__send { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--bai-navy); color: var(--bai-gold); cursor: pointer; transition: transform 160ms, background 160ms, opacity 160ms; }
  .bai__send:hover { background: var(--bai-mid); }
  .bai__send:active { transform: scale(0.92); }
  .bai__send:disabled { opacity: 0.45; cursor: not-allowed; }
  .bai__send:focus-visible { outline: 2px solid var(--bai-gold); outline-offset: 2px; }
  .bai__fine { margin: 0; padding: 0 14px 10px; background: #fff; font-size: 0.6875rem; color: #5b6b86; text-align: center; }

  @media (max-width: 560px) {
    .bai__panel { right: 12px; bottom: max(12px, env(safe-area-inset-bottom)); width: calc(100vw - 24px); height: min(520px, 70dvh); border-radius: 20px; }
    .bai__fab { width: 56px; height: 56px; gap: 2px; right: 12px; bottom: max(12px, env(safe-area-inset-bottom)); }
    .bai__fab-ic { width: 28px; }
    .bai__fab-l { font-size: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bai__fab-ring { animation: none; opacity: 0.5; }
    .bai__fab::after, .bai__fab-ic { animation: none; }
    .bai__panel[data-in], .bai__panel[data-out], .bai__m { animation-duration: 1ms; }
    .bai__typing i { animation: none; opacity: 0.6; }
  }
</style>

<script>
  type Link = { title: string; url: string };
  type Msg = { role: 'user' | 'assistant'; content: string; links?: Link[] };
  const KEY = 'becci-ai-chat-v1';
  const GREETING = 'Namaste! I’m **BECCI AI**. I can help you with membership, government schemes, loans, tenders, events and anything else on the BECCI website. What would you like to know?';

  const root = document.querySelector<HTMLElement>('[data-bai]')!;
  const fab = root.querySelector<HTMLButtonElement>('[data-bai-open]')!;
  const panel = root.querySelector<HTMLElement>('[data-bai-panel]')!;
  const log = root.querySelector<HTMLElement>('[data-bai-log]')!;
  const form = root.querySelector<HTMLFormElement>('[data-bai-form]')!;
  const input = root.querySelector<HTMLTextAreaElement>('[data-bai-input]')!;
  const send = root.querySelector<HTMLButtonElement>('[data-bai-send]')!;
  const sugs = root.querySelector<HTMLElement>('[data-bai-sugs]')!;

  let history: Msg[] = [];
  try { history = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { history = []; }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(history.slice(-40))); } catch {} };
  let busy = false;

  // A soft "pop" made with the Web Audio API (no file to load). Plays only on a visitor's click.
  let ctx: AudioContext | undefined;
  const pop = (up = true) => {
    try {
      ctx ??= new (window.AudioContext || (window as any).webkitAudioContext)();
      const t = ctx.currentTime, o = ctx.createOscillator(), g = ctx.createGain();
      o.type = 'sine';
      o.frequency.setValueAtTime(up ? 420 : 700, t);
      o.frequency.exponentialRampToValueAtTime(up ? 880 : 380, t + 0.09);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.12, t + 0.012);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.16);
      o.connect(g).connect(ctx.destination); o.start(t); o.stop(t + 0.18);
    } catch {}
  };

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const inline = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  const md = (s: string) => {
    const out: string[] = []; let list: string[] = [];
    const flush = () => { if (list.length) { out.push('<ul>' + list.map((l) => `<li>${inline(l)}</li>`).join('') + '</ul>'); list = []; } };
    for (const line of s.split('\n')) {
      const b = line.match(/^\s*(?:[-•*]|\d+[.)])\s+(.*)$/);
      if (b) { list.push(b[1]); continue; }
      flush(); if (line.trim()) out.push(`<p>${inline(line.trim())}</p>`);
    }
    flush(); return out.join('');
  };
  const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

  const scroll = () => { log.scrollTop = log.scrollHeight; };
  const render = (m: Msg) => {
    const el = document.createElement('div');
    el.className = `bai__m bai__m--${m.role === 'user' ? 'u' : 'a'}`;
    el.innerHTML = `<div class="bai__b">${m.role === 'user' ? `<p>${esc(m.content).replace(/\n/g, '<br>')}</p>` : md(m.content)}</div>`;
    if (m.links?.length) {
      const ls = document.createElement('div'); ls.className = 'bai__links';
      m.links.forEach((l) => {
        if (!l.url.startsWith('/')) return;
        const a = document.createElement('a'); a.className = 'bai__link'; a.href = l.url;
        a.innerHTML = `<span>${esc(l.title)}</span>${arrow}`; ls.append(a);
      });
      el.append(ls);
    }
    log.append(el); scroll(); return el;
  };
  const paint = () => {
    log.replaceChildren();
    render({ role: 'assistant', content: GREETING });
    history.forEach(render);
    sugs.hidden = history.length > 0;
  };

  const open = (sound = true) => {
    root.setAttribute('data-open', ''); fab.setAttribute('aria-expanded', 'true');
    panel.hidden = false; panel.removeAttribute('data-out'); panel.setAttribute('data-in', '');
    if (sound) pop(true); paint();
    setTimeout(() => input.focus({ preventScroll: true }), 60);
  };
  const close = () => {
    panel.removeAttribute('data-in'); panel.setAttribute('data-out', ''); pop(false);
    setTimeout(() => { panel.hidden = true; panel.removeAttribute('data-out'); root.removeAttribute('data-open'); fab.setAttribute('aria-expanded', 'false'); fab.focus({ preventScroll: true }); }, 150);
  };
  fab.addEventListener('click', () => open());
  try { if (sessionStorage.getItem('becci-ai-reopen')) { sessionStorage.removeItem('becci-ai-reopen'); open(false); } } catch {}
  root.querySelector('[data-bai-close]')!.addEventListener('click', close);
  root.querySelector('[data-bai-clear]')!.addEventListener('click', () => { history = []; save(); paint(); input.focus(); });
  panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  const grow = () => { input.style.height = 'auto'; input.style.height = Math.min(120, input.scrollHeight) + 'px'; };
  input.addEventListener('input', grow);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
  sugs.addEventListener('click', (e) => { const b = (e.target as Element).closest('button'); if (b) ask(b.textContent!.trim()); });
  form.addEventListener('submit', (e) => { e.preventDefault(); const q = input.value.trim(); if (q) ask(q); });

  async function ask(q: string) {
    if (busy) return;
    busy = true; send.disabled = true; sugs.hidden = true;
    input.value = ''; grow();
    const u: Msg = { role: 'user', content: q }; history.push(u); save(); render(u);
    const typing = document.createElement('div');
    typing.className = 'bai__m bai__m--a'; typing.setAttribute('aria-label', 'BECCI AI is typing');
    typing.innerHTML = '<div class="bai__b bai__typing"><i></i><i></i><i></i></div>';
    log.append(typing); scroll();
    let reply: Msg;
    let go = '';
    try {
      const ctl = new AbortController(); const timer = setTimeout(() => ctl.abort(), 45000);
      const r = await fetch('/api/chat.php', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, signal: ctl.signal,
        body: JSON.stringify({ messages: history.map(({ role, content }) => ({ role, content })) }),
      });
      clearTimeout(timer);
      const d = await r.json();
      if (!d.answer) throw new Error(d.error || 'No answer');
      reply = { role: 'assistant', content: d.answer, links: d.links || [] };
      go = typeof d.open === 'string' && d.open.startsWith('/') ? d.open : '';
    } catch {
      reply = { role: 'assistant', content: 'Sorry, I can’t reach the BECCI assistant right now. You can search the site, or contact the BECCI team.', links: [{ title: 'Contact BECCI', url: '/contact/' }, { title: 'Search opportunities', url: '/opportunities/' }] };
    }
    typing.remove();
    history.push(reply); save();
    const el = render(reply); pop(true);
    busy = false; send.disabled = false; input.focus({ preventScroll: true });
    if (go) {
      const here = location.pathname.replace(/\/$/, '') + location.hash;
      const note = document.createElement('p'); note.className = 'bai__open';
      note.textContent = 'Opening the page…'; el.append(note); scroll();
      setTimeout(() => {
        if (go.replace(/\/(?=#|$)/, '') === here) { note.textContent = 'You are on this page.'; const id = go.split('#')[1]; if (id) document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' }); return; }
        try { sessionStorage.setItem('becci-ai-reopen', '1'); } catch {}
        location.href = go;
      }, 900);
    }
  }
</script>
