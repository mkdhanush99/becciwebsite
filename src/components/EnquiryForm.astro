---
import { destinations } from '../data/site';
interface Field { name: string; label: string; type?: 'text' | 'email' | 'tel' | 'textarea' | 'select'; required?: boolean; options?: string[]; hint?: string; autocomplete?: string }
interface Props { id: string; purpose: string; fields: Field[]; submitLabel: string }
const { id, purpose, fields, submitLabel } = Astro.props;
const endpoint = destinations.formEndpoint;
---
<form class="enquiry" id={id} novalidate onsubmit="event.preventDefault()" data-enquiry data-endpoint={endpoint ?? ''} data-purpose={purpose}>
  {!endpoint && (
    <p class="notice notice--warn" role="note"><strong>Online submission is not connected yet.</strong> You can fill in and check this form, but nothing will be sent until BECCI connects its inbox. No details are stored.</p>
  )}
  {fields.map((f) => (
    <div class="field">
      <label for={`${id}-${f.name}`}>{f.label}{!f.required && <span class="muted small"> (optional)</span>}</label>
      {f.hint && <span class="hint" id={`${id}-${f.name}-hint`}>{f.hint}</span>}
      {f.type === 'textarea' ? (
        <textarea class="textarea" id={`${id}-${f.name}`} name={f.name} required={f.required} aria-describedby={f.hint ? `${id}-${f.name}-hint` : undefined}></textarea>
      ) : f.type === 'select' ? (
        <select class="select" id={`${id}-${f.name}`} name={f.name} required={f.required}>
          <option value="">Choose one</option>
          {f.options?.map((o) => <option>{o}</option>)}
        </select>
      ) : (
        <input class="input" id={`${id}-${f.name}`} name={f.name} type={f.type ?? 'text'} required={f.required} autocomplete={f.autocomplete} inputmode={f.type === 'tel' ? 'tel' : undefined} aria-describedby={f.hint ? `${id}-${f.name}-hint` : undefined} />
      )}
      <span class="field-error" id={`${id}-${f.name}-err`} hidden></span>
    </div>
  ))}
  <button class="btn" type="submit">{submitLabel}</button>
  <div class="enquiry__result" role="status" aria-live="polite"></div>
</form>
<style is:global>
  .enquiry { max-width: 620px; }
  .enquiry > .notice { margin-bottom: 20px; }
  .enquiry__result:not(:empty) { margin-top: 16px; }
</style>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((form) => {
    const result = form.querySelector<HTMLElement>('.enquiry__result')!;
    const validate = (el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
      const err = form.querySelector<HTMLElement>(`#${el.id}-err`)!;
      let msg = '';
      const v = el.value.trim();
      if (el.required && !v) msg = 'Please fill this in.';
      else if (v && el.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) msg = 'Enter an email address like name@example.com.';
      else if (v && el.type === 'tel' && !/^[+\d][\d\s-]{7,}$/.test(v)) msg = 'Enter a phone number with at least 8 digits.';
      err.textContent = msg; err.hidden = !msg;
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
      if (msg) el.setAttribute('aria-errormessage', err.id); else el.removeAttribute('aria-errormessage');
      return !msg;
    };
    const controls = Array.from(form.querySelectorAll<HTMLInputElement>('input, textarea, select'));
    controls.forEach((c) => {
      c.addEventListener('blur', () => { if (c.value) validate(c); });
      c.addEventListener('input', () => { if (c.getAttribute('aria-invalid') === 'true') validate(c); });
      c.addEventListener('change', () => { if (c.getAttribute('aria-invalid') === 'true') validate(c); });
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const bad = controls.filter((c) => !validate(c));
      if (bad.length) { result.innerHTML = ''; bad[0].focus(); return; }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        result.innerHTML = '<p class="notice notice--warn">Your entries look complete, but <strong>this form is not connected to BECCI yet, so nothing was sent</strong>. Please keep your message and try again once online submissions open.</p>';
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true; result.innerHTML = '<p class="notice">Sending…</p>';
      try {
        const data = new FormData(form); data.set('purpose', form.dataset.purpose ?? '');
        const r = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error(String(r.status));
        result.innerHTML = '<p class="notice notice--ok">Thank you. Your message was sent to BECCI.</p>';
        form.reset();
      } catch {
        result.innerHTML = '<p class="notice notice--warn">Your message could not be sent. Please check your connection and try again.</p>';
      } finally { btn.disabled = false; }
    });
  });
</script>
