---
import MobileCTA from '../../components/MobileCTA.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pending from '../../components/Pending.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import { wingContent } from '../../data/site';
const wc = wingContent.youth;
---
<Base title="Youth Wing" description="The Youth Wing of BECCI: who it is for, what it offers students and young founders today, and how to take part.">
  <PageHero tone="midnight" icon="youth" variant="feature" title="Youth Wing" lede="The Youth Wing is for students, graduates, young professionals and first-time founders: the people at the very beginning of the BECCI story." crumbs={[{ label: 'Wings', href: '/wings' }, { label: "Youth Wing" }]}>
    <div style="display:flex;gap:var(--s-3);flex-wrap:wrap;margin-top:var(--s-5)"><a class="btn btn--accent" href="/membership#join">Join the Youth Wing</a><a class="btn btn--ghost" href="#invite">Invite someone</a></div>
  </PageHero>
  <section class="section"><div class="wrap w-grid">
    <div class="w-main">
      <section class="w-block"><h2>Who it is for</h2>
        <ul class="w-list">
          <li>Students in school, college and higher education who want support to keep studying.</li>
          <li>Graduates and job seekers looking for internships, apprenticeships and a first job.</li>
          <li>Young professionals building a career who may want to start a business later.</li>
          <li>First-time founders with an idea, a skill or a small business just getting started.</li>
        </ul>
        <p>Like all of BECCI, the wing is for members whose community is on the Central OBC list for their State or on a State BC/OBC list. The minimum age for membership has not yet been fixed.</p>
      </section>
      <section class="w-block"><h2>Why start young</h2>
        <p>The BECCI story begins with B for Beginning: a person, an idea and a dream. The earlier a young person meets entrepreneurs from their own community, the earlier enterprise becomes a real choice rather than a distant one. The Youth Wing connects students and young founders with the people and opportunities that make that first step possible.</p>
      </section>
      <section class="w-block"><h2>What you can use today</h2>
        <ul class="w-links bento">
          <li><a class="tile" href="/opportunities/scholarships"><span class="ibadge"><Icon name="scholarship" /></span><strong>Scholarships</strong><span>Verified Central and State scholarships, including those reserved for OBC and BC students, with deadlines.</span></a></li>
          <li><a class="tile" href="/opportunities/jobs"><span class="ibadge"><Icon name="jobs" /></span><strong>Jobs, internships and apprenticeships</strong><span>Official portals such as the PM Internship Scheme, Apprenticeship India and the National Career Service.</span></a></li>
          <li><a class="tile" href="/opportunities/finance"><span class="ibadge"><Icon name="funding" /></span><strong>Funding a first business</strong><span>Loan schemes for aspiring entrepreneurs, with who can apply and what they ask for.</span></a></li>
        </ul>
      </section>
      <section class="w-block"><h2>Objectives, programmes and office bearers</h2>
        {wc.bearers.length || wc.programmes.length ? (<>
          {wc.programmes.length > 0 && <ul class="wp-list">{wc.programmes.map((g) => <li><strong>{g.title} {g.sample && <SampleBadge />}</strong><span>{g.text}</span></li>)}</ul>}
          {wc.bearers.length > 0 && <ul class="wb-list">{wc.bearers.map((p) => <li>{p.photo && <img src={p.photo} alt={p.sample ? 'Sample portrait (illustrative AI image)' : `Photograph of ${p.name}`} width="400" height="400" loading="lazy" decoding="async" />}<strong>{p.name} {p.sample && <SampleBadge />}</strong><span>{p.role}</span></li>)}</ul>}
        </>) : <Pending label="Awaiting approved content" icon="events" action={{ label: "Request a call from the team", href: "/membership#join" }}>The wing’s approved objectives, its office bearers and its first programmes will be published here. Personal phone numbers are never published.</Pending>}
      </section>
      <section class="w-block"><h2>Events and initiatives</h2><p class="muted">No Youth Wing events have been announced yet. When they are, they will appear here and on the <a href="/events">event calendar</a>.</p></section>
    </div>
    <aside class="w-side">
      <div class="panel w-panel">
        <h2>Taking part</h2>
        <p>Become a BECCI member and tell the membership team you would like to join the Youth Wing. Online applications are not open yet, so start with a call.</p>
        <a class="btn btn--accent" href="/membership#join">Join the Youth Wing</a>
      </div>
      <div class="panel w-panel" id="invite">
        <h2>Invite someone</h2>
        <p>Know someone who should be part of the Youth Wing? Share this page with them.</p>
        <button class="btn btn--ghost btn--sm" type="button" data-share>Copy link to this page</button> <span class="small muted" role="status" data-share-status></span>
        <p class="small muted">Personal invitation links with referral tracking are a member feature that is not available yet.</p>
      </div>
    </aside>
  </div></section>
  <MobileCTA href="/membership#join" target=".page-hero" label="Join the Youth Wing" note="Start with a call from the membership team." />
</Base>
<script>
  const b = document.querySelector('[data-share]'); const s = document.querySelector('[data-share-status]');
  b?.addEventListener('click', async () => {
    const url = location.origin + location.pathname;
    try { if (navigator.share) { await navigator.share({ title: document.title, url }); return; } await navigator.clipboard.writeText(url); if (s) s.textContent = 'Link copied.'; }
    catch { if (s) s.textContent = url; }
  });
</script>
<style>
  .w-grid { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: clamp(var(--s-6), 6vw, var(--s-8)); align-items: start; }
  .w-block { padding-block: var(--s-5); border-top: var(--hair); }
  .w-block:first-child { border-top: 0; padding-top: 0; }
  .w-block h2 { font-size: var(--fs-xl); }
  .w-list { padding-left: 1.2em; }
  .w-list li { margin-bottom: var(--s-2); }
  .w-links { list-style: none; padding: 0; margin: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .w-links li { display: flex; }
  .w-links .tile { width: 100%; }
  .w-links strong { color: var(--midnight); font-weight: 500; font-size: var(--fs-md); }
  .w-links span:not(.ibadge) { font-size: var(--fs-sm); color: var(--slate); }
  .w-side { display: grid; gap: var(--s-4); position: sticky; top: calc(64px + var(--s-5)); }
  .w-panel { padding: var(--s-5); }
  .w-panel h2 { font-size: var(--fs-lg); }
  .w-panel p:last-child { margin: var(--s-3) 0 0; }
  @media (max-width: 860px) { .w-grid { grid-template-columns: 1fr; } .w-side { position: static; } }
</style>

<style>
  .wp-list { list-style: none; padding: 0; margin: 0 0 var(--s-5); display: grid; gap: var(--s-3); }
  .wp-list li { display: grid; gap: 4px; padding: var(--s-4); border-radius: var(--radius-sm); background: #fff; border: 1px solid rgb(10 35 82 / 10%); }
  .wp-list strong { display: flex; gap: 8px; align-items: center; color: var(--midnight); }
  .wp-list span { color: var(--slate); font-size: var(--fs-sm); }
  .wb-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 220px)); gap: var(--s-5); }
  .wb-list li { display: grid; gap: 4px; }
  .wb-list img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); margin-bottom: 6px; }
  .wb-list strong { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--midnight); }
  .wb-list span { color: var(--slate); font-size: var(--fs-sm); }
</style>
