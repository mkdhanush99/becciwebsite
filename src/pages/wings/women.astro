---
import MobileCTA from '../../components/MobileCTA.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pending from '../../components/Pending.astro';
---
<Base title="Women's Wing" description="The Women's Wing of BECCI: who it is for, what it is for, what you can use today and how to take part.">
  <PageHero tone="royal" icon="women" variant="feature" title="Women's Wing" lede="The Women's Wing brings together women entrepreneurs, women-led enterprises, professionals and women preparing to start a business within BECCI." crumbs={[{ label: 'Wings', href: '/wings' }, { label: "Women's Wing" }]}>
    <div style="display:flex;gap:var(--s-3);flex-wrap:wrap;margin-top:var(--s-5)"><a class="btn btn--accent" href="/membership#join">Join the Women's Wing</a><a class="btn btn--ghost" href="#invite">Invite someone</a></div>
  </PageHero>
  <section class="section"><div class="wrap w-grid">
    <div class="w-main">
      <section class="w-block"><h2>Who it is for</h2>
        <ul class="w-list">
          <li>Women who run a business, whether a shop, a service, a workshop or a registered company.</li>
          <li>Women who are preparing to start one and want guidance, finance or a partner.</li>
          <li>Women professionals who can mentor, advise or open doors for others.</li>
          <li>Women in self-help groups and collectives who want to grow their work into an enterprise.</li>
        </ul>
        <p>Like all of BECCI, the wing is for members whose community is on the Central OBC list for their State or on a State BC/OBC list.</p>
      </section>
      <section class="w-block"><h2>Why a wing of its own</h2>
        <p>A dedicated wing gives women members a place of their own inside the chamber: to meet other women in business, find mentors and partners, and raise the issues that matter most to women-led enterprises, with the backing of the whole of BECCI.</p>
      </section>
      <section class="w-block"><h2>What you can use today</h2>
        <ul class="w-links bento">
          <li><a class="tile" href="/opportunities/finance"><span class="ibadge"><Icon name="funding" /></span><strong>Loans and funding</strong><span>Verified credit schemes, including group credit through self-help groups, with the category rule for each.</span></a></li>
          <li><a class="tile" href="https://www.standupmitra.in/" rel="noopener"><span class="ibadge"><Icon name="schemes" /></span><strong>Stand-Up India ↗</strong><span>A national scheme for bank loans to women and SC/ST entrepreneurs. BECCI has not yet verified its current details.</span></a></li>
          <li><a class="tile" href="/knowledge"><span class="ibadge"><Icon name="knowledge" /></span><strong>Knowledge Centre</strong><span>Guides on registration, compliance and finance as BECCI publishes them.</span></a></li>
        </ul>
      </section>
      <section class="w-block"><h2>Objectives, programmes and office bearers</h2>
        <Pending label="Awaiting approved content" icon="events" action={{ label: "Request a call from the team", href: "/membership#join" }}>The wing’s approved objectives, its office bearers and its first programmes will be published here. Personal phone numbers are never published.</Pending>
      </section>
      <section class="w-block"><h2>Events and initiatives</h2><p class="muted">No Women’s Wing events have been announced yet. When they are, they will appear here and on the <a href="/events">event calendar</a>.</p></section>
    </div>
    <aside class="w-side">
      <div class="panel w-panel">
        <h2>Taking part</h2>
        <p>Become a BECCI member and tell the membership team you would like to join the Women's Wing. Online applications are not open yet, so start with a call.</p>
        <a class="btn btn--accent" href="/membership#join">Join the Women's Wing</a>
      </div>
      <div class="panel w-panel" id="invite">
        <h2>Invite someone</h2>
        <p>Know someone who should be part of the Women's Wing? Share this page with them.</p>
        <button class="btn btn--ghost btn--sm" type="button" data-share>Copy link to this page</button> <span class="small muted" role="status" data-share-status></span>
        <p class="small muted">Personal invitation links with referral tracking are a member feature that is not available yet.</p>
      </div>
    </aside>
  </div></section>
  <MobileCTA href="/membership#join" target=".page-hero" label="Join the Women's Wing" note="Start with a call from the membership team." />
</Base>
<script>
  const b = document.querySelector('[data-share]'); const s = document.querySelector('[data-share-status]');
  b?.addEventListener('click', async () => {
    const url = location.origin + location.pathname;
    try { if (navigator.share) { await navigator.share({ title: document.title, url }); return; } await navigator.clipboard.writeText(url); if (s) s.textContent = 'Link copied.'; }
    catch { if (s) s.textContent = url; }
  });
</script>
<style>
  .w-grid { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: clamp(var(--s-6), 6vw, var(--s-8)); align-items: start; }
  .w-block { padding-block: var(--s-5); border-top: var(--hair); }
  .w-block:first-child { border-top: 0; padding-top: 0; }
  .w-block h2 { font-size: var(--fs-xl); }
  .w-list { padding-left: 1.2em; }
  .w-list li { margin-bottom: var(--s-2); }
  .w-links { list-style: none; padding: 0; margin: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .w-links li { display: flex; }
  .w-links .tile { width: 100%; }
  .w-links strong { color: var(--midnight); font-weight: 500; font-size: var(--fs-md); }
  .w-links span:not(.ibadge) { font-size: var(--fs-sm); color: var(--slate); }
  .w-side { display: grid; gap: var(--s-4); position: sticky; top: calc(64px + var(--s-5)); }
  .w-panel { padding: var(--s-5); }
  .w-panel h2 { font-size: var(--fs-lg); }
  .w-panel p:last-child { margin: var(--s-3) 0 0; }
  @media (max-width: 860px) { .w-grid { grid-template-columns: 1fr; } .w-side { position: static; } }
</style>
