---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Finder from '../../components/Finder.astro';
import { CATEGORY_META } from '../../data/opportunities';
const m = CATEGORY_META['tenders'];
---
<Base title={m.label} description={m.blurb}>
  <PageHero eyebrow="Opportunity finder" title={m.label} lede={m.blurb} crumbs={[{ label: 'Opportunities', href: '/opportunities' }, { label: m.label }]} />
  <section class="section--tight"><div class="wrap"><Finder category="tenders" /></div></section>
</Base>
