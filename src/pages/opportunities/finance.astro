---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { opportunities, portals } from '../../data/opportunities';
import ScopeLegend from '../../components/ScopeLegend.astro';
import Finder from '../../components/Finder.astro';
import { CATEGORY_META } from '../../data/opportunities';
const m = CATEGORY_META['finance'];
---
<Base title={m.label} description={m.blurb}>
  <PageHead meta={`${opportunities.length} verified records · ${portals.length} official portals. Every record links to its source.`} title={m.label} lede={m.blurb} crumbs={[{ label: 'Opportunities', href: '/opportunities' }, { label: m.label }]} />
  <section class="finder-page"><div class="wrap"><ScopeLegend /><Finder category="finance" /></div></section>
</Base>
