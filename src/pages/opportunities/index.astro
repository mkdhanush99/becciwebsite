---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { opportunities, portals } from '../../data/opportunities';
import Finder from '../../components/Finder.astro';
---
<Base title="Opportunities" description="Search public schemes, scholarships, loans, tenders and jobs, with official sources and deadlines.">
  <PageHead meta={`${opportunities.length} verified records · ${portals.length} official portals. Every record links to its source.`} title="Find opportunities that fit you" lede="Schemes, scholarships, loans and funding, tenders and jobs. Every listing links to its official source and shows when we last checked it." crumbs={[{ label: 'Opportunities' }]} />
  <section class="finder-page"><div class="wrap"><Finder /></div></section>
</Base>
