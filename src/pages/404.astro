---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found">
  <PageHero tone="royal" icon="search" variant="feature" title="This page has moved on" lede="That page doesn't exist or has moved. Start again from the homepage or go straight to the opportunity finder.">
    <p class="nf-actions"><a class="btn btn--light" href="/">Go to the homepage</a> <a class="btn btn--ghost" href="/opportunities">Find opportunities</a></p>
  </PageHero>
  <div class="section--tight"></div>
</Base>
<style>.nf-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin: var(--s-6) 0 0; }</style>
