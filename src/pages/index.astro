---
import Base from '../layouts/Base.astro';
import ScrollStory from '../components/ScrollStory.astro';
import { site, audiences, advisors, events, news, stats } from '../data/site';
import { opportunities, portals, CATEGORY_META, CATEGORY_ORDER, OBC_SCOPE_LABEL } from '../data/opportunities';
import { computeStatus, STATUS_LABEL, deadlineText, todayISO, formatDate } from '../lib/status';

const today = todayISO();
const open = opportunities
  .map((o) => ({ o, st: computeStatus(o, today) }))
  .filter((x) => x.st !== 'closed' && x.st !== 'awaiting-notice')
  .sort((a, b) => (a.o.closingDate ?? '9999').localeCompare(b.o.closingDate ?? '9999'));
const [featured, ...rest] = open;
const lastChecked = opportunities.map((o) => o.lastVerified).sort().at(-1);
const register = open.slice(0, 3);
const statement = 'Community and Commerce have not been sufficiently connected. BECCI brings them together, so connections turn into businesses and businesses turn into opportunities.';
const words = (t: string) => t.split(' ');
// The four questions every visitor should get an answer to (Critique Review §20),
// each with what works today and what is still being set up.
const answers = [
  { q: 'What opportunities can I access?', a: 'Government schemes, scholarships, loans, tenders, jobs and apprenticeships, each checked against its official source and dated. No account is needed.', status: 'Available now', href: '/opportunities', link: 'Open the opportunity finder' },
  { q: 'What can BECCI do for my business?', a: 'Connect you with finance, registration, compliance and mentorship through service providers and institutions BECCI is arranging. You can tell us what you need today.', status: 'Being set up', href: '/services', link: 'See service areas' },
  { q: 'Whom can I connect with?', a: 'Other entrepreneurs through the Women’s Wing, Youth Wing, sector committees, State chapters and BECCI events.', status: 'Being set up', href: '/wings', link: 'Wings, sectors and chapters' },
  { q: 'How can I become part of BECCI?', a: 'Join as a member if your community is on the Central OBC list for your State or a State BC/OBC list, or partner with BECCI as an institution.', status: 'Request a call', href: '/membership', link: 'Membership and joining' },
];
const more = [
  { label: 'Government Schemes', href: '/schemes' },
  { label: 'Franchise & Enterprise', href: '/franchise' },
  { label: 'Services', href: '/services' },
  { label: 'Event Calendar', href: '/events' },
  { label: 'Knowledge Centre', href: '/knowledge' },
  { label: 'Success Stories', href: '/success-stories' },
  { label: 'Biz Connect', href: '/biz-connect', note: 'Coming later' },
  { label: 'Marketplace', href: '/marketplace', note: 'Coming later' },
];
const tiers = [
  { name: 'Free', text: 'Basic platform access and manual scheme search for your home State and National schemes.' },
  { name: 'Affiliate', text: 'Everything in Free, plus profile-based scheme suggestions and opportunity notifications.' },
  { name: 'Associate', text: 'Everything in Affiliate, plus one complimentary Scheme Suggestion Report.' },
];
---
<Base title="Home">
  <section class="h-hero on-dark">
    <div class="h-hero__bg" aria-hidden="true"><span class="h-glow h-glow--a"></span><span class="h-glow h-glow--b"></span></div>
    <div class="wrap h-hero__inner">
      <h1 class="kinetic" aria-label="Where Community Meets Commerce">
        <span class="kinetic__line" aria-hidden="true"><span class="kw" style="--i:0"><span>Where</span></span> <span class="kw" style="--i:1"><span>Community</span></span></span>
        <span class="kinetic__line kinetic__line--lit" aria-hidden="true"><span class="kw" style="--i:2"><span>Meets</span></span> <span class="kw" style="--i:3"><span>Commerce</span></span></span>
      </h1>
      <p class="h-hero__lede h-in" style="--i:5">{site.supporting}</p>
      <p class="h-hero__id h-in" style="--i:5">BECCI is the <strong>Bahujan Entrepreneurs Chamber for Commerce &amp; Industry</strong>, an OBC-exclusive national Chamber of Commerce. Use this website to find verified opportunities, learn about membership and connect with the chamber.</p>
      <form class="h-search h-in" style="--i:6" action="/opportunities" method="get" role="search">
        <label for="hero-q" class="visually-hidden">Find schemes, scholarships, loans, tenders and jobs</label>
        <div class="h-search__row">
          <svg class="h-search__icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m13.5 13.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <input id="hero-q" name="q" type="search" class="input" placeholder="Search loans, scholarships…" />
          <button class="btn" type="submit">Search</button>
        </div>
      </form>
      <ul class="h-cats h-in" style="--i:7" aria-label="Browse by category">
        {CATEGORY_ORDER.map((c) => <li><a href={CATEGORY_META[c].path}>{CATEGORY_META[c].label}</a></li>)}
      </ul>
      <div class="h-hero__actions h-in" style="--i:8">
        <a class="btn btn--light" href="/membership#join">Join as a Member</a>
        <a class="h-hero__link" href="/about">About the chamber</a>
      </div>
    </div>

    <div class="wrap h-stage">
      <aside class="h-reg" aria-labelledby="reg-title" data-rise>
        <div class="h-reg__head">
          <h2 id="reg-title">Open now</h2>
          <span class="h-reg__live">Checked {formatDate(lastChecked)}</span>
        </div>
        <ol class="h-reg__list">
          {register.map(({ o, st }) => (
            <li>
              <div class="h-reg__meta"><span class={`status status--${st}`}>{STATUS_LABEL[st]}</span><span class="h-reg__cat">{CATEGORY_META[o.categories[0]].label}</span></div>
              <h3><a href={`/opportunities/${o.slug}`}>{o.title}</a></h3>
              <p>{o.authority.split(',')[0]}</p>
              <p class="h-reg__when">{deadlineText(o, today)}</p>
            </li>
          ))}
        </ol>
        <a class="h-reg__all" href="/opportunities">See all {opportunities.length} records and {portals.length} official portals</a>
      </aside>
    </div>
  </section>

  <section class="h-statement on-dark" aria-label="Why BECCI exists">
    <div class="wrap">
      <p class="h-statement__text" data-scrub>{words(statement).map((w, i) => <><span class="sw" style={`--w:${i}`}>{w}</span>{' '}</>)}</p>
      <div class="h-facts">
        <p class="h-promise">{site.promise}</p>
        <ul>
          <li>Began in Telangana and Andhra Pradesh</li>
          <li>Building a national presence</li>
          <li><a href="/about">About BECCI</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section h-paths h-curtain" aria-labelledby="paths-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="paths-title">I am…</h2>
        <p>Start from where you are today. Each path opens the part of the website that is most useful to you first.</p>
      </div>
      <ul class="h-paths__list" data-reveal-group>
        {audiences.map((a, i) => (
          <li><a href={a.href}><span class="h-paths__n">{String(i + 1).padStart(2, '0')}</span><strong>{a.who}</strong><span class="h-paths__need">{a.need}</span><span class="h-paths__go" aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="open-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <h2 id="open-title">Opportunities you can apply for</h2>
          <p class="h-open__intro">Every listing names the authority that issued it, who can apply, the deadline and the official link, and shows when BECCI last checked it.</p>
        </div>
        <a class="link-arrow" href="/opportunities">All {opportunities.length} records and {portals.length} official portals</a>
      </div>
      <dl class="h-scope" data-reveal>
        <div><dt><span class="scope scope--exclusive">{OBC_SCOPE_LABEL.exclusive}</span></dt><dd>Reserved for OBC/BC applicants under the scheme’s own rules.</dd></div>
        <div><dt><span class="scope scope--preference">{OBC_SCOPE_LABEL.preference}</span></dt><dd>Open more widely, with a written preference or quota for OBC/BC applicants.</dd></div>
        <div><dt><span class="scope scope--open">{OBC_SCOPE_LABEL.open}</span></dt><dd>Open to anyone who meets the eligibility rules. Not every listing is OBC-only.</dd></div>
      </dl>
      <div class="h-open" data-reveal-group>
        {featured && (
          <article class="h-open__feature on-dark">
            <div class="h-open__meta"><span class={`status status--${featured.st}`}>{STATUS_LABEL[featured.st]}</span><span class="h-open__scope">{OBC_SCOPE_LABEL[featured.o.obcScope]}</span></div>
            <h3><a href={`/opportunities/${featured.o.slug}`}>{featured.o.title}</a></h3>
            <p class="h-open__auth">{featured.o.authority}</p>
            <p>{featured.o.summary}</p>
            <p class="h-open__deadline">{deadlineText(featured.o, today)}</p>
          </article>
        )}
        <ol class="h-open__list">
          {rest.map(({ o, st }) => (
            <li>
              <div class="h-open__meta"><span class={`status status--${st}`}>{STATUS_LABEL[st]}</span><span class={`scope scope--${o.obcScope}`}>{OBC_SCOPE_LABEL[o.obcScope]}</span></div>
              <h3><a href={`/opportunities/${o.slug}`}>{o.title}</a></h3>
              <p class="small muted">{o.authority.split(',')[0]} · {deadlineText(o, today)}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <ScrollStory />

  <section class="section" aria-labelledby="does-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="does-title">What BECCI can do for you</h2>
        <p>Four questions every visitor asks, answered plainly, including what works today and what is still being set up.</p>
      </div>
      <ul class="h-does" data-reveal-group>
        {answers.map((p, i) => (
          <li class:list={[i === 0 && 'h-does__lead on-dark']}><span class="h-does__status">{p.status}</span><h3>{p.q}</h3><p>{p.a}</p><a class="link-arrow" href={p.href}>{p.link}</a></li>
        ))}
      </ul>
      <ul class="h-more" aria-label="More from BECCI">
        {more.map((m) => <li><a href={m.href}>{m.label}{m.note && <span class="nav-note">{m.note}</span>}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="join-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="join-title">Become part of the chamber</h2>
        <p>Membership is for Bahujan entrepreneurs, business owners, professionals, students and first-generation founders whose community is on the Central OBC list for their State or on a State BC/OBC list. Either list is enough.</p>
      </div>
      <ol class="h-tiers" data-reveal-group>
        {tiers.map((t, i) => <li><span class="h-tiers__step">Level {i + 1}</span><h3>{t.name} Membership</h3><p>{t.text}</p></li>)}
      </ol>
      <div class="h-member__foot">
        <a class="btn" href="/membership#join">Join as a Member</a>
        <p class="small muted">These three categories are proposed. Fees and final benefits will be confirmed before online applications open. Until then, the membership team can explain them on a call.</p>
      </div>
    </div>
  </section>

  <section class="section h-close" aria-labelledby="close-title">
    <div class="wrap">
      <div class="h-close__panel on-dark" data-grow>
        <div>
          <h2 id="close-title">Open doors for entrepreneurs at scale</h2>
          <p>Government departments, banks, MSME bodies, industry associations, educational institutions, incubators and corporates can create opportunities for entrepreneurs that ordinary networking cannot. BECCI welcomes proposals for collaboration.</p>
          <a class="btn btn--light" href="/partnerships">Partner with BECCI</a>
        </div>
        <ul class="h-close__links">
          <li><a href="/events"><strong>Event calendar</strong><span>{events.length ? `${events.length} announced` : 'No events announced yet'}</span></a></li>
          <li><a href="/news"><strong>News Desk</strong><span>{news.length ? `${news.length} announcements` : 'No announcements yet'}</span></a></li>
          <li><a href="/knowledge"><strong>Knowledge Centre</strong><span>Guides and resources</span></a></li>
          <li><a href="/leadership"><strong>Leadership</strong><span>{advisors.length ? `${advisors.length} advisors` : 'Profiles coming soon'}</span></a></li>
        </ul>
      </div>
    </div>
    {stats.length > 0 && <ul class="wrap h-stats">{stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span><small>{s.period} · {s.basis}</small></li>)}</ul>}
  </section>
</Base>


<style>
  /* ── Hero: centred kinetic headline over rising light ── */
  .h-hero { position: relative; z-index: 2; isolation: isolate; background: #040d26; color: var(--on-dark-2); padding-top: clamp(var(--s-8), 9vw, 140px); text-align: center; }
  .h-hero__bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: linear-gradient(180deg, #050f2b 0%, var(--midnight) 40%, #0a1f5c 100%); mask-image: linear-gradient(180deg, #000 70%, transparent 100%); }
  .h-hero__bg::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(70% 60% at 50% 30%, #000, transparent 75%); }
  .h-glow { position: absolute; left: 50%; border-radius: 50%; filter: blur(60px); pointer-events: none; }
  .h-glow--a { bottom: -12%; width: 120%; height: 70%; transform: translateX(-50%); background: radial-gradient(closest-side, rgb(61 123 255 / 95%), rgb(33 82 232 / 60%) 45%, transparent 100%); }
  .h-glow--b { bottom: 4%; width: 60%; height: 50%; transform: translateX(-30%); background: radial-gradient(closest-side, rgb(34 184 230 / 70%), transparent 100%); }
  @media (prefers-reduced-motion: no-preference) {
    .h-glow--a { animation: breathe 9s ease-in-out infinite alternate; }
    .h-glow--b { animation: drift 14s ease-in-out infinite alternate; }
  }
  @keyframes breathe { to { transform: translateX(-50%) scale(1.08); opacity: 0.85; } }
  @keyframes drift { from { transform: translateX(-60%); } to { transform: translateX(-20%); } }

  .h-hero__inner { display: flex; flex-direction: column; align-items: center; }
  .kinetic { color: #fff; font-size: clamp(3rem, 0.8rem + 8.2vw, 8.5rem); font-weight: 600; line-height: 0.95; letter-spacing: -0.045em; margin: 0 0 var(--s-6); max-width: none; }
  .kinetic__line { display: block; white-space: nowrap; }
  .kinetic__line--lit { color: #8fdcf7; }
  .kw { display: inline-block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; vertical-align: top; }
  .kw > span { display: inline-block; }
  .h-hero__lede { font-size: var(--fs-md); color: #c3d1e8; max-width: 52ch; margin: 0 auto var(--s-3); }
  .h-hero__id { font-size: var(--fs-sm); color: #a9bad6; max-width: 60ch; margin: 0 auto var(--s-6); }
  .h-hero__id strong { color: #fff; font-weight: 600; }
  .h-open__intro { margin: var(--s-2) 0 0; color: var(--slate); max-width: 56ch; }
  .h-scope { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); margin: 0 0 var(--s-6); padding: var(--s-4) var(--s-5); border-radius: 16px; background: var(--ivory); border: 1px solid var(--silver-200); }
  .h-scope dt { margin-bottom: var(--s-2); }
  .h-scope dd { margin: 0; font-size: var(--fs-sm); color: var(--slate); }
  @media (max-width: 760px) { .h-scope { grid-template-columns: 1fr; } }
  .h-does__status { display: inline-flex; align-self: flex-start; font-size: var(--fs-label); font-weight: 600; padding: 4px 10px; border-radius: 999px; background: var(--sapphire-soft); color: var(--royal-deep); margin-bottom: var(--s-4); }
  .h-does__lead .h-does__status { background: rgb(143 220 247 / 16%); color: #8fdcf7; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .kw > span { transform: translateY(105%) rotate(4deg); animation: rise 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: calc(120ms + var(--i) * 90ms); }
    :global(.js) .h-in { opacity: 0; transform: translateY(16px); animation: fadeUp 700ms var(--ease) forwards; animation-delay: calc(var(--i) * 90ms); }
  }
  @keyframes rise { to { transform: none; } }
  @keyframes fadeUp { to { opacity: 1; transform: none; } }

  .h-search { width: min(100%, 640px); margin-bottom: var(--s-4); }
  .h-search__row { position: relative; display: flex; align-items: center; gap: var(--s-2); padding: 6px; background: #fff; border-radius: 16px; box-shadow: 0 30px 60px -24px rgb(0 0 0 / 60%), 0 0 0 6px rgb(255 255 255 / 8%), 0 0 80px -10px rgb(61 123 255 / 50%); text-align: left; }
  .h-search__icon { position: absolute; left: 20px; color: var(--slate); pointer-events: none; }
  .h-search .input { flex: 1; min-width: 0; border: 0; background: transparent; min-height: 52px; padding-left: 48px; font-size: var(--fs-md); box-shadow: none; }
  .h-search .input:focus-visible { outline: none; }
  .h-search__row:focus-within { box-shadow: 0 30px 60px -24px rgb(0 0 0 / 60%), 0 0 0 4px var(--cyan), 0 0 80px -10px rgb(61 123 255 / 60%); }
  .h-search .btn { min-height: 52px; padding: 0 var(--s-6); border-radius: 12px; }
  .h-cats { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2); list-style: none; padding: 0; margin: 0 0 var(--s-6); }
  .h-cats a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 var(--s-4); border-radius: 999px; border: 1px solid rgb(255 255 255 / 18%); background: rgb(255 255 255 / 6%); backdrop-filter: blur(6px); color: #fff; font-size: var(--fs-sm); font-weight: 500; text-decoration: none; transition: background var(--dur), border-color var(--dur); }
  .h-cats a:hover { color: #fff; background: rgb(34 184 230 / 18%); border-color: var(--cyan); }
  .h-hero__actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--s-3) var(--s-5); }
  .h-hero__link { display: inline-flex; align-items: center; min-height: 44px; color: #fff; font-weight: 600; text-decoration: underline; text-decoration-color: rgb(255 255 255 / 35%); text-underline-offset: 6px; }
  .h-hero__link:hover { color: #fff; text-decoration-color: var(--cyan); }
  :global(.btn--light) { --bg: #fff; --bd: #fff; --fg: var(--midnight); }
  :global(.btn--light:hover) { --bg: var(--cyan-soft); --bd: var(--cyan-soft); --fg: var(--midnight); }

  /* Stage: the register card rises out of the light, bridging into the next band */
  .h-stage { position: relative; display: flex; justify-content: center; margin-top: var(--s-7); margin-bottom: calc(-1 * clamp(80px, 10vw, 160px)); z-index: 2; text-align: left; }
  .h-reg { width: min(100%, 760px); background: rgb(255 255 255 / 97%); color: var(--ink); border-radius: 24px; padding: var(--s-5) var(--s-6); box-shadow: 0 50px 100px -40px rgb(0 0 0 / 70%), 0 0 0 1px rgb(255 255 255 / 40%), 0 0 120px -20px rgb(61 123 255 / 55%); transform: translateY(calc((1 - var(--p, 1)) * 90px)) scale(calc(0.94 + var(--p, 1) * 0.06)); }
  .h-reg__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding-bottom: var(--s-4); border-bottom: var(--hair); }
  .h-reg__head h2 { font-size: var(--fs-md); margin: 0; }
  .h-reg__live { display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-label); font-weight: 600; color: var(--cyan-ink); }
  .h-reg__live::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 0 4px var(--cyan-soft); }
  .h-reg__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); }
  .h-reg__list li { position: relative; padding: var(--s-4) 0; }
  .h-reg__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
  .h-reg__cat { font-size: var(--fs-label); font-weight: 600; color: var(--slate); width: 100%; }
  .h-reg h3 { font-size: var(--fs-base); line-height: 1.35; margin: var(--s-2) 0 2px; }
  .h-reg h3 a { color: var(--midnight); text-decoration: none; }
  .h-reg h3 a::after { content: ''; position: absolute; inset: 0; }
  .h-reg h3 a:hover { color: var(--royal); }
  .h-reg p { margin: 0; font-size: var(--fs-sm); color: var(--slate); }
  .h-reg .h-reg__when { color: var(--ink); font-weight: 600; margin-top: 2px; }
  .h-reg__all { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); min-height: 48px; border-top: var(--hair); font-size: var(--fs-sm); font-weight: 600; color: var(--royal); text-decoration: none; }
  .h-reg__all::after { content: '→'; transition: transform var(--dur) var(--ease); }
  .h-reg__all:hover::after { transform: translateX(4px); }

  /* Statement: oversized words light up as they scroll past */
  .h-statement { position: relative; background: #040d26; padding-block: calc(clamp(80px, 10vw, 160px) + var(--s-8)) var(--s-8); overflow: hidden; }
  .h-statement::before { content: ''; position: absolute; inset: 0 0 auto; height: 60%; background: radial-gradient(50% 60% at 50% 0%, rgb(61 123 255 / 30%), transparent 70%); pointer-events: none; }
  .h-statement__text { position: relative; font: 600 clamp(2rem, 0.8rem + 4.4vw, 5rem)/1.05 var(--font-display); letter-spacing: -0.035em; color: #fff; margin: 0; max-width: 20ch; text-wrap: balance; }
  @media (prefers-reduced-motion: no-preference) { :global(.js) .h-statement .sw[data-on]:nth-last-child(-n + 16) { color: #8fdcf7; } }
  .h-facts { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3) var(--s-6); margin-top: var(--s-8); padding-top: var(--s-5); border-top: 1px solid rgb(255 255 255 / 12%); }
  .h-promise { margin: 0; font-weight: 500; letter-spacing: 0.02em; color: #fff; }
  .h-facts ul { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); list-style: none; margin: 0; padding: 0; font-size: var(--fs-sm); color: #a9bad6; }
  .h-facts strong { color: #8fdcf7; font-weight: 600; font-variant-numeric: tabular-nums; }
  .h-facts a { color: #fff; }

  /* Curtain: the light surface slides over the dark band with a rounded edge */
  .h-curtain { position: relative; z-index: 1; margin-top: -40px; border-radius: 40px 40px 0 0; background: var(--ivory); }

  @media (max-width: 860px) { .h-reg__list { grid-template-columns: 1fr; gap: 0; } .h-reg__list li + li { border-top: var(--hair); } .h-reg__cat { width: auto; margin-left: auto; } }
  @media (max-width: 520px) {
