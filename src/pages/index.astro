---
import Base from '../layouts/Base.astro';
import ScrollStory from '../components/ScrollStory.astro';
import ImpactStats from '../components/ImpactStats.astro';
import Icon from '../components/Icon.astro';
import Illo from '../components/Illo.astro';
import { site, audiences, advisors, events, news, stats } from '../data/site';
import { opportunities, portals, CATEGORY_META, CATEGORY_ORDER, OBC_SCOPE_LABEL } from '../data/opportunities';
import { computeStatus, STATUS_LABEL, deadlineText, todayISO, formatDate } from '../lib/status';

const today = todayISO();
const open = opportunities
  .map((o) => ({ o, st: computeStatus(o, today) }))
  .filter((x) => x.st !== 'closed' && x.st !== 'awaiting-notice' && x.st !== 'unconfirmed')
  .sort((a, b) => (a.o.closingDate ?? '9999').localeCompare(b.o.closingDate ?? '9999'));
const [featured, ...rest] = open;
const lastChecked = opportunities.map((o) => o.lastVerified).sort().at(-1);
const register = open.slice(0, 3);
const schemeList = opportunities.filter((o) => o.categories.includes('schemes') && o.scheme);
const featuredSchemes = ['pmegp', 'pm-mudra-yojana', 'nbcfdc-individual-loan-scheme', 'pm-vishwakarma'].map((slug) => schemeList.find((o) => o.slug === slug)!).filter(Boolean);
const statement = 'Community and Commerce have not been sufficiently connected. BECCI brings them together, so connections turn into businesses and businesses turn into opportunities.';
const words = (t: string) => t.split(' ');
// The four questions every visitor should get an answer to (Critique Review §20),
// each with what works today and what is still being set up.
// Four content pillars. Each answers one visitor question (Critique Review §20) and says
// honestly whether it works today.
const answers = [
  { pillar: 'Discover', icon: 'search', q: 'What opportunities can I access?', a: 'Government schemes, tenders, scholarships, loans, jobs and apprenticeships, each checked against its official source and dated. No account needed.', status: 'Available now', href: '/opportunities', link: 'Open the opportunity finder' },
  { pillar: 'Develop', icon: 'services', q: 'What can BECCI do for my business?', a: 'Connect you with finance, registration, compliance and mentorship through providers and institutions BECCI is arranging.', status: 'Being set up', href: '/services', link: 'Tell us what you need' },
  { pillar: 'Connect', icon: 'community', q: 'Whom can I connect with?', a: 'Other entrepreneurs through the Women’s Wing, Youth Wing, sector committees, State chapters and events.', status: 'Being set up', href: '/wings', link: 'Wings, sectors and chapters' },
  { pillar: 'Grow', icon: 'membership', q: 'How can I become part of BECCI?', a: 'Join as a member if your community is on the Central OBC list for your State or a State BC/OBC list, or partner with BECCI as an institution.', status: 'Request a call', href: '/membership', link: 'Membership and joining' },
];
const pillarArt: Record<string, { tone: string; illo?: 'finder' | 'chamber' | 'members' }> = {
  Discover: { tone: 'ice', illo: 'finder' }, Develop: { tone: 'midnight' }, Connect: { tone: 'royal', illo: 'chamber' }, Grow: { tone: 'sky', illo: 'members' },
};
const cardTones = ['ice', 'cyan', 'sky', 'white', 'sapphire', 'stone'];
const more = [
  { label: 'Government Schemes', href: '/schemes' },
  { label: 'Franchise & Enterprise', href: '/franchise' },
  { label: 'Services', href: '/services' },
  { label: 'Event Calendar', href: '/events' },
  { label: 'Knowledge Centre', href: '/knowledge' },
  { label: 'Success Stories', href: '/success-stories' },
  { label: 'Biz Connect', href: '/biz-connect', note: 'Coming later' },
  { label: 'Marketplace', href: '/marketplace', note: 'Coming later' },
];
const tiers = [
  { name: 'Free', text: 'Basic platform access and manual scheme search for your home State and National schemes.' },
  { name: 'Affiliate', text: 'Everything in Free, plus profile-based scheme suggestions and opportunity notifications.' },
  { name: 'Associate', text: 'Everything in Affiliate, plus one complimentary Scheme Suggestion Report.' },
];
---
<Base title="Home">
  <section class="h-hero on-dark">
    <div class="h-hero__bg" aria-hidden="true"></div>
    <div class="wrap h-hero__grid">
      <div class="h-hero__copy">
        <h1 class="kinetic" aria-label="Where Community Meets Commerce.">
          <span class="kinetic__line" aria-hidden="true"><span class="kw" style="--i:0"><span>Where</span></span> <span class="kw" style="--i:1"><span>Community</span></span></span>
          <span class="kinetic__line kinetic__line--lit" aria-hidden="true"><span class="kw" style="--i:2"><span>Meets</span></span> <span class="kw" style="--i:3"><span>Commerce.</span></span></span>
        </h1>
        <p class="h-hero__lede h-in" style="--i:4">{site.supporting}</p>
        <div class="h-hero__actions h-in" style="--i:5">
          <a class="btn btn--light btn--lg" href="/opportunities">Explore Opportunities <Icon name="arrow" size={18} /></a>
          <a class="btn btn--ghost btn--lg" href="/membership#join">Join as a Member</a>
        </div>
        <p class="h-hero__id h-in" style="--i:6">BECCI is the <strong>Bahujan Entrepreneurs Chamber for Commerce &amp; Industry</strong>, an OBC-exclusive national Chamber of Commerce.</p>
        <form class="h-search h-in" style="--i:7" action="/opportunities" method="get" role="search">
          <label for="hero-q" class="visually-hidden">Find schemes, scholarships, loans, tenders and jobs</label>
          <div class="h-search__row">
            <Icon name="search" size={18} class="h-search__icon" />
            <input id="hero-q" name="q" type="search" class="input" placeholder="Search loans, scholarships, tenders…" />
            <button class="btn" type="submit">Search</button>
          </div>
        </form>
        <ul class="h-cats h-in" style="--i:8" aria-label="Browse by category">
          {CATEGORY_ORDER.map((c) => <li><a href={CATEGORY_META[c].path}>{CATEGORY_META[c].label}</a></li>)}
        </ul>
      </div>
      <div class="h-art" aria-labelledby="reg-title">
        <div class="h-art__scene"><Illo name="hero" /></div>
        <h2 id="reg-title" class="visually-hidden">Open now</h2>
        <span class="h-art__live">Open now · checked {formatDate(lastChecked)}</span>
        {register.slice(0, 2).map(({ o, st }, i) => (
          <article class={`h-card h-card--${i}`}>
            <div class="h-card__meta"><span class={`status status--${st}`}>{STATUS_LABEL[st]}</span><span class="h-card__cat">{CATEGORY_META[o.categories[0]].label}</span></div>
            <h3><a href={`/opportunities/${o.slug}`}>{o.title}</a></h3>
            <p>{o.authority.split(',')[0]}</p>
            <p class="h-card__when">{deadlineText(o, today)}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="h-sources" aria-label="Official sources BECCI checks">
      <p class="wrap h-sources__label">Listings are checked against official sources, including</p>
      <ul class="wrap h-sources__list">{portals.map((p) => <li>{p.name}</li>)}</ul>
    </div>
  </section>

  <section class="h-statement on-dark" aria-label="Why BECCI exists">
    <div class="wrap">
      <p class="h-statement__text" data-scrub>{words(statement).map((w, i) => <><span class="sw" style={`--w:${i}`}>{w}</span>{' '}</>)}</p>
      <div class="h-facts">
        <p class="h-promise">{site.promise}</p>
        <ul>
          <li>Began in Telangana and Andhra Pradesh</li>
          <li>Building a national presence</li>
          <li><a href="/about">About BECCI</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section h-paths h-curtain" aria-labelledby="paths-title">
    <div class="wrap">
      <div class="h-head" data-reveal>
        <h2 id="paths-title">BECCI for…</h2>
        <p>Start from where you are today. Each path opens the part of the website that is most useful to you first.</p>
      </div>
      <ul class="h-paths__list" data-reveal-group>
        {audiences.map((a, i) => (
          <li><a class={`h-path h-path--${cardTones[i % cardTones.length]}`} href={a.href}>
            <span class="h-path__for">BECCI for</span>
            <strong>{a.who}</strong>
            <span class="h-path__need">{a.need}</span>
            <span class="h-path__go">Start here <span aria-hidden="true">→</span></span>
            <span class="h-path__art" aria-hidden="true"><Icon name={a.icon as any} size={40} /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="open-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <h2 id="open-title">Opportunities you can apply for</h2>
          <p class="h-open__intro">Every listing names the authority that issued it, who can apply, the deadline and the official link, and shows when BECCI last checked it.</p>
        </div>
        <a class="link-arrow" href="/opportunities">All {opportunities.length} records and {portals.length} official portals</a>
      </div>
      <dl class="h-scope" data-reveal>
        <div><dt><span class="scope scope--exclusive">{OBC_SCOPE_LABEL.exclusive}</span></dt><dd>Reserved for OBC/BC applicants under the scheme’s own rules.</dd></div>
        <div><dt><span class="scope scope--preference">{OBC_SCOPE_LABEL.preference}</span></dt><dd>Open more widely, with a written preference or quota for OBC/BC applicants.</dd></div>
        <div><dt><span class="scope scope--open">{OBC_SCOPE_LABEL.open}</span></dt><dd>Open to anyone who meets the eligibility rules. Not every listing is OBC-only.</dd></div>
      </dl>
      <div class="h-open" data-reveal-group>
        {featured && (
          <article class="h-open__feature on-dark">
            <div class="h-open__meta"><span class={`status status--${featured.st}`}>{STATUS_LABEL[featured.st]}</span><span class="h-open__scope">{OBC_SCOPE_LABEL[featured.o.obcScope]}</span></div>
            <h3><a href={`/opportunities/${featured.o.slug}`}>{featured.o.title}</a></h3>
            <p class="h-open__auth">{featured.o.authority}</p>
            <p>{featured.o.summary}</p>
            <p class="h-open__deadline">{deadlineText(featured.o, today)}</p>
          </article>
        )}
        <ol class="h-open__list">
          {rest.map(({ o, st }) => (
            <li>
              <div class="h-open__meta"><span class={`status status--${st}`}>{STATUS_LABEL[st]}</span><span class={`scope scope--${o.obcScope}`}>{OBC_SCOPE_LABEL[o.obcScope]}</span></div>
              <h3><a href={`/opportunities/${o.slug}`}>{o.title}</a></h3>
              <p class="small muted">{o.authority.split(',')[0]} · {deadlineText(o, today)}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section h-gs" aria-labelledby="gs-title">
    <div class="wrap h-gs__grid">
      <div class="h-gs__copy">
        <h2 id="gs-title">Government schemes, explained</h2>
        <p>{schemeList.length} Central and State schemes, each told in six short chapters: why it exists, what it offers, who can benefit, what you need, how to apply, and where to check it officially.</p>
        <p class="h-gs__rule">BECCI explains the opportunity. The issuing government authority remains the source of truth.</p>
        <a class="btn" href="/schemes">Browse government schemes</a>
      </div>
      <ol class="h-gs__list">
        {featuredSchemes.map((o) => (
          <li>
            <a href={`/schemes/${o.slug}`}>
              <span class="h-gs__name">{o.title}</span>
              <span class="h-gs__by">{o.scheme!.ministry}</span>
              <span class="h-gs__meta"><span>For {o.scheme!.beneficiaries.join(', ').toLowerCase()}</span><span class={`scope scope--${o.obcScope}`}>{OBC_SCOPE_LABEL[o.obcScope]}</span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ImpactStats />

  <ScrollStory />

  <section class="section" aria-labelledby="does-title">
    <div class="wrap">
      <div class="h-head" data-reveal>
        <h2 id="does-title">Discover. Develop. Connect. Grow.</h2>
        <p>Each pillar answers a question visitors ask, and says plainly what works today and what is still being set up.</p>
      </div>
      <ul class="h-does" data-reveal-group>
        {answers.map((p) => { const art = pillarArt[p.pillar]; return (
          <li class={`h-pil h-pil--${art.tone}`}>
            {art.tone === 'midnight' && <span class="h-pil__mark" aria-hidden="true"></span>}
            <p class="h-pil__eyebrow"><span>{p.pillar}</span><span class="h-pil__status">{p.status}</span></p>
            <h3>{p.q}</h3>
            <p class="h-pil__text">{p.a}</p>
            <a class="h-pil__link" href={p.href}>{p.link} <span aria-hidden="true">→</span></a>
            {art.illo ? <span class="h-pil__art"><Illo name={art.illo} /></span> : <span class="h-pil__icon" aria-hidden="true"><Icon name={p.icon as any} size={56} /></span>}
          </li>
        ); })}
      </ul>
      <ul class="h-more" aria-label="More from BECCI">
        {more.map((m) => <li><a href={m.href}>{m.label}{m.note && <span class="nav-note">{m.note}</span>}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section h-join on-dark" aria-labelledby="join-title">
    <div class="h-join__bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="h-head h-head--center" data-reveal>
        <h2 id="join-title">Become part of the chamber</h2>
        <p>For Bahujan entrepreneurs, business owners, professionals, students and first-generation founders whose community is on the Central OBC list for their State or on a State BC/OBC list. Either list is enough.</p>
      </div>
      <ol class="h-tiers" data-reveal-group>
        {tiers.map((t, i) => <li><span class="h-tiers__step">Level {i + 1}</span><h3>{t.name} <span>Membership</span></h3><p>{t.text}</p></li>)}
      </ol>
      <div class="h-member__foot">
        <a class="btn btn--light" href="/membership#join">Join BECCI</a>
        <p class="small">These three categories are proposed. Fees and final benefits will be confirmed before online applications open. Until then, the membership team can explain them on a call.</p>
      </div>
    </div>
  </section>

  <section class="section h-close" aria-labelledby="close-title">
    <div class="wrap">
      <div class="h-close__box">
        <span class="h-close__art"><Illo name="arch" /></span>
        <h2 id="close-title">Open doors for entrepreneurs at scale</h2>
        <p>Government departments, banks, MSME bodies, industry associations, educational institutions, incubators and corporates can create opportunities for entrepreneurs that ordinary networking cannot. BECCI welcomes proposals for collaboration.</p>
        <div class="h-close__cta"><a class="btn" href="/partnerships">Partner with BECCI</a><a class="btn btn--ghost" href="/contact">Contact the chamber</a></div>
        <ul class="h-close__links">
          <li><a href="/events"><Icon name="events" size={22} /><strong>Event calendar</strong><span>{events.length ? `${events.length} announced` : 'No events announced yet'}</span></a></li>
          <li><a href="/news"><Icon name="news" size={22} /><strong>News</strong><span>{news.length ? `${news.length} announcements` : 'No announcements yet'}</span></a></li>
          <li><a href="/knowledge"><Icon name="knowledge" size={22} /><strong>Knowledge Centre</strong><span>Guides and resources</span></a></li>
          <li><a href="/leadership"><Icon name="leadership" size={22} /><strong>Leadership</strong><span>{advisors.length ? `${advisors.length} advisors` : 'Profiles coming soon'}</span></a></li>
        </ul>
      </div>
    </div>
    {stats.length > 0 && <ul class="wrap h-stats">{stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span><small>{s.period} · {s.basis}</small></li>)}</ul>}
  </section>
</Base>


<style>
  /* ── Hero: saturated royal surface with a drawing grid, copy left, illustrated stage right ── */
  .h-hero { position: relative; z-index: 2; isolation: isolate; overflow: hidden; background: var(--royal); color: #dbe6fb; padding-top: clamp(var(--s-7), 6vw, 96px); }
  .h-hero__bg { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(rgb(255 255 255 / 9%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 9%) 1px, transparent 1px); background-size: 72px 72px; background-position: -1px -1px; mask-image: linear-gradient(180deg, #000 60%, transparent); }
  .h-hero__bg::after { content: ''; position: absolute; inset: 0; background: radial-gradient(50% 60% at 80% 40%, rgb(101 185 242 / 35%), transparent 70%); }
  .h-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-6); align-items: center; }
  /* Headline: heavier editorial weight (ref. Bizpole's bold display), tight leading, measured tracking */
  .kinetic { color: #fff; font-size: clamp(2.75rem, 0.8rem + 4.4vw, 5.25rem); font-weight: 700; line-height: 0.96; letter-spacing: -0.035em; margin: 0 0 var(--s-5); max-width: none; font-kerning: normal; }
  .kinetic__line { display: block; white-space: nowrap; }
  .kinetic__line--lit { color: #bfe7ff; }
  .kw { display: inline-block; overflow: hidden; padding: 0.14em 0.06em 0.08em; margin: -0.14em -0.06em -0.08em; vertical-align: top; }
  .kw > span { display: inline-block; }
  .h-hero__lede { font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem); font-weight: 400; line-height: 1.5; letter-spacing: -0.005em; color: #eef3fd; max-width: 34ch; margin: 0 0 var(--s-6); text-wrap: pretty; }
  .h-hero__id { font-size: var(--fs-sm); line-height: 1.55; color: #d3e0f8; max-width: 50ch; margin: var(--s-6) 0 var(--s-4); padding-top: var(--s-4); border-top: 1px solid rgb(255 255 255 / 18%); }
  .h-hero__id strong { color: #fff; font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .kw > span { transform: translateY(105%) rotate(4deg); animation: rise 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: calc(120ms + var(--i) * 90ms); }
    :global(.js) .h-in { opacity: 0; transform: translateY(16px); animation: fadeUp 700ms var(--ease) forwards; animation-delay: calc(var(--i) * 80ms); }
    :global(.js) .h-card { opacity: 0; animation: cardIn 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    :global(.js) .h-card--0 { animation-delay: 700ms; } :global(.js) .h-card--1 { animation-delay: 850ms; }
    .h-card { transition: transform 300ms var(--ease), box-shadow 300ms var(--ease); }
    }
  @keyframes rise { to { transform: none; } }
  @keyframes fadeUp { to { opacity: 1; transform: none; } }
  @keyframes cardIn { from { opacity: 0; translate: 0 40px; } to { opacity: 1; translate: 0 0; } }

  .h-search { width: min(100%, 520px); margin-bottom: var(--s-3); }
  .h-search__row { position: relative; display: flex; align-items: center; gap: var(--s-2); padding: 6px; background: #fff; border-radius: 999px; border: 1px solid var(--midnight); box-shadow: none; }
  :global(.h-search__icon) { position: absolute; left: 20px; color: var(--slate); pointer-events: none; }
  .h-search .input { flex: 1; min-width: 0; border: 0; background: transparent; min-height: 44px; padding-left: 46px; font-size: var(--fs-base); box-shadow: none; }
  .h-search .input:focus-visible { outline: 2px solid var(--royal); outline-offset: 2px; border-radius: 999px; }
  .h-search__row:focus-within { box-shadow: 0 0 0 4px var(--cyan); }
  .h-search .btn { min-height: 44px; padding: 0 var(--s-5); border-radius: 999px; --bg: var(--midnight); --bd: var(--midnight); }
  .h-cats { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; padding: 0; margin: 0 0 var(--s-5); }
  .h-cats a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--s-3); border-radius: 999px; border: 1px solid rgb(255 255 255 / 30%); background: rgb(255 255 255 / 8%); color: #fff; font-size: var(--fs-sm); font-weight: 500; text-decoration: none; transition: background var(--dur), border-color var(--dur), color var(--dur); }
  .h-cats a:hover { color: var(--midnight); background: #fff; border-color: #fff; }
  .h-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .h-hero__actions .btn { border-radius: 999px; min-height: 56px; padding: 0 var(--s-6); font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.005em; }
  .h-hero__actions .btn--light { box-shadow: 4px 4px 0 var(--midnight); }
  .h-hero__actions .btn--light:hover { transform: translateY(-1px); }
  :global(.btn--light) { --bg: #fff; --bd: #fff; --fg: var(--midnight); }
  :global(.btn--light:hover) { --bg: var(--cyan-soft); --bd: var(--cyan-soft); --fg: var(--midnight); }

  /* Stage: illustration with live opportunity cards layered over it */
  .h-art { position: relative; min-height: 520px; }
  .h-art__scene { position: absolute; inset: 14% -6% 0 6%; }
  .h-art__live { position: absolute; top: 6%; right: 2%; z-index: 3; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--midnight); color: #fff; font-size: var(--fs-label); font-weight: 600; box-shadow: 3px 3px 0 rgb(8 26 53 / 40%); }
  .h-art__live::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 0 3px rgb(66 200 216 / 35%); }
  .h-card { position: absolute; z-index: 2; width: min(272px, 56%); padding: var(--s-4); background: #fff; color: var(--ink); border: 1px solid var(--midnight); border-radius: 16px; box-shadow: 6px 6px 0 var(--midnight); }
  .h-card--0 { top: 0; left: 0; }
  .h-card--1 { bottom: 0; right: 0; }
  .h-card:hover { transform: translateY(-2px); box-shadow: 8px 10px 0 var(--midnight); }
  .h-card__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
  .h-card__cat { margin-left: auto; font-size: var(--fs-label); font-weight: 600; color: var(--slate); }
  .h-card h3 { font-size: var(--fs-base); line-height: 1.3; margin: var(--s-2) 0 2px; }
  .h-card h3 a { color: var(--midnight); text-decoration: none; }
  .h-card h3 a::after { content: ''; position: absolute; inset: 0; }
  .h-card h3 a:hover { color: var(--royal); }
  .h-card p { margin: 0; font-size: var(--fs-sm); color: var(--slate); }
  .h-card .h-card__when { color: var(--ink); font-weight: 600; margin-top: 2px; }

  .h-sources { position: relative; margin-top: var(--s-6); padding: var(--s-4) 0 calc(var(--s-6) + 40px); overflow: hidden; border-top: 1px solid rgb(255 255 255 / 16%); }
  .h-sources__label { margin: 0 auto var(--s-3); font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #c5d6f6; }
  .h-sources__list { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); list-style: none; padding: 0; margin-top: 0; margin-bottom: 0; }
  .h-sources li { font: 500 var(--fs-base)/1.4 var(--font-display); color: #fff; }

  @media (max-width: 1000px) {
    .h-hero__grid { grid-template-columns: minmax(0, 1fr); }
