---
import Base from '../layouts/Base.astro';
import ImpactStats from '../components/ImpactStats.astro';
import InfinityRule from '../components/InfinityRule.astro';
import AdvisorsStrip from '../components/AdvisorsStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import Icon from '../components/Icon.astro';
import Illo from '../components/Illo.astro';
import { schemeLogos } from '../data/scheme-logos';
import { site, audiences, advisors, events, news, stats, story } from '../data/site';
import { photos, srcset } from '../data/photos';
import { opportunities, portals, CATEGORY_META, CATEGORY_ORDER, OBC_SCOPE_LABEL } from '../data/opportunities';
import { computeStatus, STATUS_LABEL, deadlineText, todayISO } from '../lib/status';

const today = todayISO();
const realCount = (xs: { sample?: boolean }[]) => xs.filter((x) => !x.sample).length;
const open = opportunities
  .map((o) => ({ o, st: computeStatus(o, today) }))
  .filter((x) => x.st !== 'closed' && x.st !== 'awaiting-notice' && x.st !== 'unconfirmed')
  .sort((a, b) => (a.o.closingDate ?? '9999').localeCompare(b.o.closingDate ?? '9999'));
const [featured, ...rest] = open;
const schemeList = opportunities.filter((o) => o.categories.includes('schemes') && o.scheme);
const featuredSchemes = ['pmegp', 'pm-mudra-yojana', 'nbcfdc-individual-loan-scheme', 'pm-vishwakarma'].map((slug) => schemeList.find((o) => o.slug === slug)!).filter(Boolean);
// BECCI card experience: the five tiles of the Critique Review ("The BECCI Story – Five Letters, One Journey"),
// with the letter, its meaning, the tile title and the story statement exactly as the client wrote them (data/site.ts `story`).
// The infinity symbol sits on the two C tiles, joining Community and Commerce.
const tilePhotos = [
  { photo: photos.entrepreneurs, pos: '42% 40%' },
  { photo: photos.chamber, pos: '52% 45%' },
  { photo: photos.bahujan, pos: '50% 45%' },
  { photo: photos.commerce, pos: '50% 40%' },
  { photo: photos.industry, pos: '55% 40%' },
];
const pillars = story.map((t, i) => ({ letter: t.letter, word: t.name, title: t.title, text: t.text, href: t.link.href, infinity: t.letter === 'C', ...tilePhotos[i] }));
const motto = ['Bahujana', 'Hitāya,', 'Bahujana', 'Sukhāya'];
// "BC doesn't mean Backward Class" story card (client text, verbatim), told one sentence at a time.
const bcStory: { t: string; key?: boolean }[][] = [
  [
    { t: 'History gave them a label meant to keep them behind, yet they spent centuries pushing the nation forward.' },
    { t: 'While the world looks at towering skyscrapers and booming markets, it often forgets the calloused hands, the sleepless nights, and the unbreakable spirit working silently at the foundation.' },
    { t: 'BC does not stand for Backward Class—it stands for the Backbone Class of the Indian Economy.', key: true },
    { t: 'Without their sweat, the engine of this country would come to a standstill.' },
    { t: 'Respect the roots that keep the tree alive.', key: true },
  ],
  [
    { t: 'For decades, two letters—BC—were used as a reminder of where we stood in line.' },
    { t: 'Today, it’s time to change the meaning of those letters forever.' },
    { t: 'Look at the farms, the factories, the small businesses, and the artisans shaping India’s future.' },
    { t: 'Who is carrying the weight of a billion dreams on their shoulders?' },
    { t: 'It’s time the world knew: BC isn’t Backward Class. It is the Backbone Class—the heartbeat and the foundation of the Indian economy.', key: true },
  ],
];
// The four questions every visitor should get an answer to (Critique Review §20),
// each with what works today and what is still being set up.
// Four content pillars. Each answers one visitor question (Critique Review §20) and says
// honestly whether it works today.
const answers = [
  { pillar: 'Discover', icon: 'search', q: 'What opportunities can I access?', a: 'Government schemes, tenders, scholarships, loans, jobs and apprenticeships, each checked against its official source and dated. No account needed.', status: 'Available now', href: '/opportunities', link: 'Open the opportunity finder' },
  { pillar: 'Develop', icon: 'services', q: 'What can BECCI do for my business?', a: 'Connect you with finance, registration, compliance and mentorship through providers and institutions BECCI is arranging.', status: 'Being set up', href: '/services', link: 'Tell us what you need' },
  { pillar: 'Connect', icon: 'community', q: 'Whom can I connect with?', a: 'Other entrepreneurs through the Women’s Wing, Youth Wing, sector committees, State chapters and events.', status: 'Being set up', href: '/wings', link: 'Wings, sectors and chapters' },
  { pillar: 'Grow', icon: 'membership', q: 'How can I become part of BECCI?', a: 'Join as a member if your community is on the Central OBC list for your State or a State BC/OBC list, or partner with BECCI as an institution.', status: 'Request a call', href: '/membership', link: 'Membership and joining' },
];
const pillarArt: Record<string, { tone: string; illo?: 'finder' | 'chamber' | 'members' }> = {
  Discover: { tone: 'ice', illo: 'finder' }, Develop: { tone: 'midnight' }, Connect: { tone: 'royal', illo: 'chamber' }, Grow: { tone: 'sky', illo: 'members' },
};
const cardTones = ['ice', 'cyan', 'sky', 'white', 'sapphire', 'stone'];
const more = [
  { label: 'Government Schemes', href: '/schemes' },
  { label: 'Franchise & Enterprise', href: '/franchise' },
  { label: 'Services', href: '/services' },
  { label: 'Event Calendar', href: '/events' },
  { label: 'Knowledge Centre', href: '/knowledge' },
  { label: 'Success Stories', href: '/success-stories' },
  { label: 'Biz Connect', href: '/biz-connect', note: 'Coming later' },
  { label: 'Marketplace', href: '/marketplace', note: 'Coming later' },
];
---
<Base title="Home">
  <section class="h-hero on-dark">
    <div class="h-hero__bg" aria-hidden="true"></div>
    <div class="wrap h-hero__grid">
      <div class="h-film" aria-hidden="true">
        <!-- BECCI brand films (client files, Nov 2026): the title film (36 s) builds the infinity from light and
             resolves into the logo; then the 12 s loop keeps the finished logo alive. The title plays once per visit.
             Black is keyed out in WebGL, so only the light sits on the hero's gradient: no frame, no controls. -->
        <video class="h-film__v" muted playsinline preload="auto" width="1280" height="720" data-film-title>
          <source src="/video/becci-title.mp4" type="video/mp4" />
        </video>
        <video class="h-film__v h-film__v--loop" muted playsinline loop preload="none" width="1280" height="720" data-film-loop>
          <source src="/video/becci-loop.mp4" type="video/mp4" />
        </video>
        <canvas class="h-film__c" width="1280" height="720" data-film-canvas></canvas>
      </div>
      <div class="h-hero__copy">
        <h1 class="kinetic" aria-label="Where Community Meets Commerce">
          <span class="kinetic__line" aria-hidden="true"><span class="kw" style="--i:0"><span>Where</span></span> <span class="kw" style="--i:1"><span>Community</span></span></span>
          <span class="kinetic__line kinetic__line--lit" aria-hidden="true"><span class="kw" style="--i:2"><span>Meets</span></span> <span class="kw" style="--i:3"><span>Commerce</span></span></span>
        </h1>
        <p class="h-hero__lede h-in" style="--i:4">{site.supporting}</p>
        <div class="h-hero__actions h-in" style="--i:5">
          <a class="btn btn--light btn--lg" href="/opportunities">Explore Opportunities <Icon name="arrow" size={18} /></a>
          <a class="btn btn--ghost btn--lg" href="/membership#join">Join as a Member</a>
        </div>
        <p class="h-hero__id h-in" style="--i:6">BECCI is the <strong>Bahujan Entrepreneurs Chamber for Commerce &amp; Industry</strong>, an OBC-exclusive national Chamber of Commerce.</p>
        <form class="h-search h-in" style="--i:7" action="/opportunities" method="get" role="search">
          <label for="hero-q" class="visually-hidden">Find schemes, scholarships, loans, tenders and jobs</label>
          <div class="h-search__row">
            <Icon name="search" size={18} class="h-search__icon" />
            <input id="hero-q" name="q" type="search" class="input" placeholder="Search loans, scholarships, tenders…" />
            <button class="btn" type="submit">Search</button>
          </div>
        </form>
        <ul class="h-cats h-in" style="--i:8" aria-label="Browse by category">
          {CATEGORY_ORDER.map((c) => <li><a href={CATEGORY_META[c].path}>{CATEGORY_META[c].label}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="h-sources" aria-label="Official sources BECCI checks">
      <p class="wrap h-sources__label">Listings are checked against official sources, including</p>
      <ul class="wrap h-sources__list">{portals.map((p) => <li>{p.name}</li>)}</ul>
    </div>
  </section>

  <section class="h-motto h-motto--cards" aria-label="The BECCI story">
    <div class="wrap h-bc__kicker"><span class="story-kicker story-kicker--dark">01 · The BECCI story</span></div>
    <ol class="wrap h-bc" aria-label="The BECCI story: five letters, one journey">
      {pillars.map((p, i) => (
        <li class="h-bc__item" style={`--i:${i}`}>
          <a class="h-bc__card" href={p.href}>
            <img src={`${p.photo.src}-640.webp`} srcset={srcset(p.photo)} sizes="(max-width: 1100px) 46vw, 20vw" alt={p.photo.alt} width="1024" height="1280" style={`object-position:${p.pos}`} loading="lazy" decoding="async" />
            <span class="h-bc__frame" aria-hidden="true"></span>
            <span class="h-bc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="h-bc__body">
              <span class="h-bc__letter" aria-hidden="true">{p.letter}{p.infinity && <img class="h-bc__inf" src="/brand/becci-symbol-white.svg" alt="" width="46" height="23" />}</span>
              <span class="h-bc__word">{p.word}</span>
              <span class="h-bc__title">{p.title}</span>
              <span class="h-bc__text"><span>{p.text}</span></span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="bc" aria-labelledby="bc-title" data-bc>
    <div class="wrap bc__grid">
      <div class="bc__stage">
        <figure class="bc__photo"><img src="/images/sample/story-pottery.webp" alt="" width="1024" height="768" loading="lazy" decoding="async" /></figure>
        <div class="bc__mark">
          <span class="story-kicker story-kicker--dark">02 · The Backbone Class</span>
          <h2 id="bc-title" class="bc__title">
            <span class="bc__bc" aria-hidden="true">BC</span>
            <span class="bc__not">doesn’t mean <s>Backward Class</s>.</span>
            <span class="bc__is">It means <em>Backbone Class</em> of Indian Economy.</span>
          </h2>
        </div>
      </div>
      <div class="bc__story">
        {bcStory.map((para, pi) => (
          <div class="bc__para">
            {para.map((line) => <p class:list={['bc__line', line.key && 'bc__line--key']} data-bc-line>{line.t}</p>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section h-paths h-curtain" aria-labelledby="paths-title">
    <div class="wrap">
      <InfinityRule class="h-rule" />
      <div class="h-head" data-reveal>
        <span class="story-kicker">03 · Your path</span>
        <h2 id="paths-title">BECCI for…</h2>
      </div>
      <ul class="h-paths__list" data-reveal-group>
        {audiences.map((a, i) => (
          <li><a class={`h-path h-path--${cardTones[i % cardTones.length]}`} href={a.href}>
            <span class="h-path__for">BECCI for</span>
            <strong>{a.who}</strong>
            <span class="h-path__go">Start here <span aria-hidden="true">→</span></span>
            <span class="h-path__art" aria-hidden="true"><Icon name={a.icon as any} size={40} /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="open-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <span class="story-kicker">04 · Open today</span>
          <h2 id="open-title">Opportunities you can apply for</h2>
        </div>
        <a class="link-arrow" href="/opportunities">All {opportunities.length} records and {portals.length} official portals</a>
      </div>
      <div class="h-open" data-reveal-group>
        {featured && (
          <article class="h-open__feature on-dark">
            <div class="h-open__meta"><span class={`status status--${featured.st}`}>{STATUS_LABEL[featured.st]}</span><span class="h-open__scope">{OBC_SCOPE_LABEL[featured.o.obcScope]}</span></div>
            <h3><a href={`/opportunities/${featured.o.slug}`}>{featured.o.title}</a></h3>
            <p class="h-open__auth">{featured.o.authority}</p>
            <p>{featured.o.summary}</p>
            <p class="h-open__deadline">{deadlineText(featured.o, today)}</p>
          </article>
        )}
        <ol class="h-open__list">
          {rest.map(({ o, st }) => (
            <li>
              <div class="h-open__meta"><span class={`status status--${st}`}>{STATUS_LABEL[st]}</span><span class={`scope scope--${o.obcScope}`}>{OBC_SCOPE_LABEL[o.obcScope]}</span></div>
              <h3><a href={`/opportunities/${o.slug}`}>{o.title}</a></h3>
              <p class="small muted">{o.authority.split(',')[0]} · {deadlineText(o, today)}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section h-gs" aria-labelledby="gs-title">
    <div class="wrap h-gs__grid">
      <div class="h-gs__copy">
        <span class="story-kicker">05 · Schemes</span>
        <h2 id="gs-title">Government schemes, explained</h2>
        <a class="btn" href="/schemes">Browse government schemes</a>
      </div>
      <ol class="h-gs__list">
        {featuredSchemes.map((o) => (
          <li>
            <a href={`/schemes/${o.slug}`}>
              {schemeLogos[o.slug] && <span class="h-gs__logo"><img src={schemeLogos[o.slug].src} alt="" width="96" height="40" loading="lazy" decoding="async" /></span>}
              <span class="h-gs__name">{o.title}</span>
              <span class="h-gs__by">{o.scheme!.ministry}</span>
              <span class="h-gs__meta"><span>For {o.scheme!.beneficiaries.join(', ').toLowerCase()}</span><span class={`scope scope--${o.obcScope}`}>{OBC_SCOPE_LABEL[o.obcScope]}</span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ImpactStats />

  <Testimonials />

  <section class="section" aria-labelledby="does-title">
    <div class="wrap">
      <div class="h-head" data-reveal>
        <span class="story-kicker">07 · How BECCI helps</span>
        <h2 id="does-title">Discover. Develop. Connect. Grow.</h2>
      </div>
      <ul class="h-does" data-reveal-group>
        {answers.map((p) => { const art = pillarArt[p.pillar]; return (
          <li class={`h-pil h-pil--${art.tone}`}>
            {art.tone === 'midnight' && <span class="h-pil__mark" aria-hidden="true"></span>}
            <p class="h-pil__eyebrow"><span>{p.pillar}</span><span class="h-pil__status">{p.status}</span></p>
            <h3>{p.q}</h3>
            <a class="h-pil__link" href={p.href}>{p.link} <span aria-hidden="true">→</span></a>
            {art.illo ? <span class="h-pil__art"><Illo name={art.illo} /></span> : <span class="h-pil__icon" aria-hidden="true"><Icon name={p.icon as any} size={56} /></span>}
          </li>
        ); })}
      </ul>
      <ul class="h-more" aria-label="More from BECCI">
        {more.map((m) => <li><a href={m.href}>{m.label}{m.note && <span class="nav-note">{m.note}</span>}</a></li>)}
      </ul>
    </div>
  </section>


  <AdvisorsStrip />

  <section class="section h-close" aria-labelledby="close-title">
    <div class="wrap">
      <div class="h-close__box">
        <span class="h-close__art"><Illo name="arch" /></span>
        <span class="story-kicker">08 · Together</span>
        <h2 id="close-title">Open doors for entrepreneurs at scale</h2>
        <div class="h-close__cta"><a class="btn" href="/partnerships">Partner with BECCI</a><a class="btn btn--ghost" href="/contact">Contact the chamber</a></div>
        <ul class="h-close__links">
          <li><a href="/events"><Icon name="events" size={22} /><strong>Event calendar</strong><span>{realCount(events) ? `${realCount(events)} announced` : events.length ? 'Sample content' : 'No events announced yet'}</span></a></li>
          <li><a href="/news"><Icon name="news" size={22} /><strong>News</strong><span>{realCount(news) ? `${realCount(news)} announcements` : news.length ? 'Sample content' : 'No announcements yet'}</span></a></li>
          <li><a href="/knowledge"><Icon name="knowledge" size={22} /><strong>Knowledge Centre</strong><span>Guides and resources</span></a></li>
          <li><a href="/leadership"><Icon name="leadership" size={22} /><strong>Leadership</strong><span>{realCount(advisors) ? `${realCount(advisors)} advisors` : advisors.length ? 'Sample content' : 'Profiles coming soon'}</span></a></li>
        </ul>
      </div>
    </div>
    {stats.length > 0 && <ul class="wrap h-stats">{stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span><small>{s.period} · {s.basis}</small></li>)}</ul>}
  </section>

  <section class="h-motto h-motto--end" aria-labelledby="motto-title" data-motto>
    <div class="h-motto__jali" aria-hidden="true"></div>
    <div class="wrap h-motto__in">
      <p class="h-motto__eyebrow" id="motto-title">BECCI’s guiding principle</p>
      <p class="h-motto__line" aria-label="Bahujana Hitāya, Bahujana Sukhāya">
        {motto.map((w, i) => <><span class="h-motto__w" style={`--w:${i}`} aria-hidden="true">{w}</span>{i === 1 ? <br /> : i < motto.length - 1 ? ' ' : ''}</>)}
      </p>
      <span class="h-motto__rule" aria-hidden="true"><i></i></span>
      <p class="h-motto__meaning">For the welfare of the many, for the happiness of the many.</p>
    </div>
  </section>
</Base>

<script>

  // Story boards: the Backbone Class lines light up one by one as they reach the middle of the screen,
  // and each board's heading and items fade up once when they come into view.
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
    const bc = document.querySelector<HTMLElement>('[data-bc]');
    if (bc) {
      new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { bc.setAttribute('data-in', ''); o.disconnect(); } }), { threshold: 0.2 }).observe(bc);
      const lit = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.setAttribute('data-lit', ''); lit.unobserve(e.target); } }), { rootMargin: '0px 0px -38% 0px' });
      bc.querySelectorAll('[data-bc-line]').forEach((l) => lit.observe(l));
    }
    const rev = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.setAttribute('data-shown', ''); rev.unobserve(e.target); } }), { threshold: 0.12 });
    document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group]').forEach((el) => {
      if (el.hasAttribute('data-reveal-group')) Array.from(el.children).forEach((c, k) => (c as HTMLElement).style.setProperty('--k', String(k)));
      rev.observe(el);
    });
  } else {
    document.querySelectorAll('[data-reveal], [data-reveal-group]').forEach((el) => el.setAttribute('data-shown', ''));
  }

  // Brand film. The film has a black ground; a tiny WebGL shader turns that black into true transparency
  // (alpha = brightest channel), so only the light of the particles and logo is drawn on the hero, in every
  // browser. Without WebGL the video falls back to CSS screen blending. Plays muted while the hero is on screen;
  // with reduced motion only the final frame (the logo) is drawn.
  const title = document.querySelector<HTMLVideoElement>('[data-film-title]');
  const loopV = document.querySelector<HTMLVideoElement>('[data-film-loop]');
  const cv = document.querySelector<HTMLCanvasElement>('[data-film-canvas]');
  const box = cv?.closest<HTMLElement>('.h-film');
  const still = !window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
  let seen = false;
  try { seen = sessionStorage.getItem('becci-title-seen') === '1'; } catch {}
  if (title && loopV && cv && box) {
    // The title film plays once per visit; after it (or on a return visit) the 12 s loop carries on from the logo.
    let cur: HTMLVideoElement = seen || still ? loopV : title;
    const gl = cv.getContext('webgl', { premultipliedAlpha: true, alpha: true, antialias: false });
    let draw = () => {};
    if (gl) {
      const sh = (type: number, src: string) => { const x = gl.createShader(type)!; gl.shaderSource(x, src); gl.compileShader(x); return x; };
      const prog = gl.createProgram()!;
      gl.attachShader(prog, sh(gl.VERTEX_SHADER, 'attribute vec2 p;varying vec2 uv;void main(){uv=vec2(p.x*.5+.5,.5-p.y*.5);gl_Position=vec4(p,0.,1.);}'));
      gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, 'precision mediump float;varying vec2 uv;uniform sampler2D t;void main(){vec3 c=texture2D(t,uv).rgb;float a=max(c.r,max(c.g,c.b));float k=smoothstep(.02,.07,a);gl_FragColor=vec4(c*k,a*k);}'));
      gl.linkProgram(prog);
      if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
        gl.useProgram(prog);
        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
        [gl.TEXTURE_WRAP_S, gl.TEXTURE_WRAP_T].forEach((w) => gl.texParameteri(gl.TEXTURE_2D, w, gl.CLAMP_TO_EDGE));
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.clearColor(0, 0, 0, 0);
        draw = () => {
          if (cur.readyState < 2) return;
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, cur);
          gl.clear(gl.COLOR_BUFFER_BIT); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        };
        box.classList.add('is-gl');
      }
    }
    box.dataset.clip = cur === title ? 'title' : 'loop';
    if (cur === loopV) { loopV.preload = 'auto'; loopV.load(); }
    if (still) {
      loopV.addEventListener('loadeddata', () => draw());
      loopV.addEventListener('seeked', () => draw());
    } else {
      let raf = 0; let onScreen = false;
      const tick = () => { draw(); raf = requestAnimationFrame(tick); };
      const play = () => { onScreen = true; cur.play().catch(() => {}); cancelAnimationFrame(raf); raf = requestAnimationFrame(tick); };
      const stop = () => { onScreen = false; cur.pause(); cancelAnimationFrame(raf); };
      // Get the loop ready before the title ends, then hand over on the last frame: both show the same logo.
      title.addEventListener('timeupdate', () => { if (title.duration && title.currentTime > title.duration - 8 && loopV.preload !== 'auto') { loopV.preload = 'auto'; loopV.load(); } });
      title.addEventListener('ended', () => {
        try { sessionStorage.setItem('becci-title-seen', '1'); } catch {}
        cur = loopV; box.dataset.clip = 'loop';
        if (onScreen) loopV.play().catch(() => {});
      });
