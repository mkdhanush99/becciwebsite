---
import Base from '../layouts/Base.astro';
import ImpactStats from '../components/ImpactStats.astro';
import InfinityRule from '../components/InfinityRule.astro';
import AdvisorsStrip from '../components/AdvisorsStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import Icon from '../components/Icon.astro';
import Illo from '../components/Illo.astro';
import { schemeLogos } from '../data/scheme-logos';
import { site, audiences, advisors, events, news, stats, story } from '../data/site';
import { photos, srcset } from '../data/photos';
import { opportunities, portals, CATEGORY_META, CATEGORY_ORDER, OBC_SCOPE_LABEL } from '../data/opportunities';
import { computeStatus, STATUS_LABEL, deadlineText, todayISO, formatDate } from '../lib/status';

const today = todayISO();
const realCount = (xs: { sample?: boolean }[]) => xs.filter((x) => !x.sample).length;
const open = opportunities
  .map((o) => ({ o, st: computeStatus(o, today) }))
  .filter((x) => x.st !== 'closed' && x.st !== 'awaiting-notice' && x.st !== 'unconfirmed')
  .sort((a, b) => (a.o.closingDate ?? '9999').localeCompare(b.o.closingDate ?? '9999'));
const [featured, ...rest] = open;
const lastChecked = opportunities.map((o) => o.lastVerified).sort().at(-1);
const register = open.slice(0, 3);
const schemeList = opportunities.filter((o) => o.categories.includes('schemes') && o.scheme);
const featuredSchemes = ['pmegp', 'pm-mudra-yojana', 'nbcfdc-individual-loan-scheme', 'pm-vishwakarma'].map((slug) => schemeList.find((o) => o.slug === slug)!).filter(Boolean);
// BECCI card experience: the five words of BECCI with the Sanskrit motto. Definitions are the About page's.
const pillars = [
  { letter: 'B', word: 'Bahujan', title: 'The many, together', text: 'The communities BECCI exists for: those on the Central OBC list for their State or on a State BC/OBC list.', href: '/about#whom', photo: photos.bahujan, pos: '50% 45%' },
  { letter: 'E', word: 'Entrepreneurs', title: 'Skills into enterprise', text: 'Everyone who builds an enterprise, from a student with a first idea to an established business owner.', href: '/services', photo: photos.entrepreneurs, pos: '42% 40%' },
  { letter: 'C', word: 'Chamber', title: 'A collective voice', text: 'A membership institution that represents its members and connects them with one another.', href: '/membership', photo: photos.chamber, pos: '52% 45%' },
  { letter: 'C', word: 'Commerce', title: 'Markets and relationships', text: 'Trade, markets, referrals and the business relationships that members create together.', href: '/opportunities', photo: photos.commerce, pos: '50% 40%' },
  { letter: 'I', word: 'Industry', title: 'Every sector', text: 'Manufacturing, services, agriculture and every other sector in which members work.', href: '/partnerships', photo: photos.industry, pos: '55% 40%' },
];
const motto = ['बहुजन', 'हिताय,', 'बहुजन', 'सुखाय।'];
// The four questions every visitor should get an answer to (Critique Review §20),
// each with what works today and what is still being set up.
// Four content pillars. Each answers one visitor question (Critique Review §20) and says
// honestly whether it works today.
const answers = [
  { pillar: 'Discover', icon: 'search', q: 'What opportunities can I access?', a: 'Government schemes, tenders, scholarships, loans, jobs and apprenticeships, each checked against its official source and dated. No account needed.', status: 'Available now', href: '/opportunities', link: 'Open the opportunity finder' },
  { pillar: 'Develop', icon: 'services', q: 'What can BECCI do for my business?', a: 'Connect you with finance, registration, compliance and mentorship through providers and institutions BECCI is arranging.', status: 'Being set up', href: '/services', link: 'Tell us what you need' },
  { pillar: 'Connect', icon: 'community', q: 'Whom can I connect with?', a: 'Other entrepreneurs through the Women’s Wing, Youth Wing, sector committees, State chapters and events.', status: 'Being set up', href: '/wings', link: 'Wings, sectors and chapters' },
  { pillar: 'Grow', icon: 'membership', q: 'How can I become part of BECCI?', a: 'Join as a member if your community is on the Central OBC list for your State or a State BC/OBC list, or partner with BECCI as an institution.', status: 'Request a call', href: '/membership', link: 'Membership and joining' },
];
const pillarArt: Record<string, { tone: string; illo?: 'finder' | 'chamber' | 'members' }> = {
  Discover: { tone: 'ice', illo: 'finder' }, Develop: { tone: 'midnight' }, Connect: { tone: 'royal', illo: 'chamber' }, Grow: { tone: 'sky', illo: 'members' },
};
const cardTones = ['ice', 'cyan', 'sky', 'white', 'sapphire', 'stone'];
const more = [
  { label: 'Government Schemes', href: '/schemes' },
  { label: 'Franchise & Enterprise', href: '/franchise' },
  { label: 'Services', href: '/services' },
  { label: 'Event Calendar', href: '/events' },
  { label: 'Knowledge Centre', href: '/knowledge' },
  { label: 'Success Stories', href: '/success-stories' },
  { label: 'Biz Connect', href: '/biz-connect', note: 'Coming later' },
  { label: 'Marketplace', href: '/marketplace', note: 'Coming later' },
];
const tiers = [
  { name: 'Free', text: 'Basic platform access and manual scheme search for your home State and National schemes.' },
  { name: 'Affiliate', text: 'Everything in Free, plus profile-based scheme suggestions and opportunity notifications.' },
  { name: 'Associate', text: 'Everything in Affiliate, plus one complimentary Scheme Suggestion Report.' },
];
---
<Base title="Home">
  <section class="h-hero on-dark">
    <div class="h-hero__bg" aria-hidden="true"></div>
    <div class="wrap h-hero__grid">
      <div class="h-hero__copy">
        <h1 class="kinetic" aria-label="Where Community Meets Commerce.">
          <span class="kinetic__line" aria-hidden="true"><span class="kw" style="--i:0"><span>Where</span></span> <span class="kw" style="--i:1"><span>Community</span></span></span>
          <span class="kinetic__line kinetic__line--lit" aria-hidden="true"><span class="kw" style="--i:2"><span>Meets</span></span> <span class="kw" style="--i:3"><span>Commerce.</span></span></span>
        </h1>
        <p class="h-hero__lede h-in" style="--i:4">{site.supporting}</p>
        <div class="h-hero__actions h-in" style="--i:5">
          <a class="btn btn--light btn--lg" href="/opportunities">Explore Opportunities <Icon name="arrow" size={18} /></a>
          <a class="btn btn--ghost btn--lg" href="/membership#join">Join as a Member</a>
        </div>
        <p class="h-hero__id h-in" style="--i:6">BECCI is the <strong>Bahujan Entrepreneurs Chamber for Commerce &amp; Industry</strong>, an OBC-exclusive national Chamber of Commerce.</p>
        <form class="h-search h-in" style="--i:7" action="/opportunities" method="get" role="search">
          <label for="hero-q" class="visually-hidden">Find schemes, scholarships, loans, tenders and jobs</label>
          <div class="h-search__row">
            <Icon name="search" size={18} class="h-search__icon" />
            <input id="hero-q" name="q" type="search" class="input" placeholder="Search loans, scholarships, tenders…" />
            <button class="btn" type="submit">Search</button>
          </div>
        </form>
        <ul class="h-cats h-in" style="--i:8" aria-label="Browse by category">
          {CATEGORY_ORDER.map((c) => <li><a href={CATEGORY_META[c].path}>{CATEGORY_META[c].label}</a></li>)}
        </ul>
      </div>
      <div class="h-art" aria-labelledby="reg-title">
        <div class="h-art__scene"><Illo name="hero" /></div>
        <h2 id="reg-title" class="visually-hidden">Open now</h2>
        <span class="h-art__live">Open now · checked {formatDate(lastChecked)}</span>
        {register.slice(0, 2).map(({ o, st }, i) => (
          <article class={`h-card h-card--${i}`}>
            <div class="h-card__meta"><span class={`status status--${st}`}>{STATUS_LABEL[st]}</span><span class="h-card__cat">{CATEGORY_META[o.categories[0]].label}</span></div>
            <h3><a href={`/opportunities/${o.slug}`}>{o.title}</a></h3>
            <p>{o.authority.split(',')[0]}</p>
            <p class="h-card__when">{deadlineText(o, today)}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="h-sources" aria-label="Official sources BECCI checks">
      <p class="wrap h-sources__label">Listings are checked against official sources, including</p>
      <ul class="wrap h-sources__list">{portals.map((p) => <li>{p.name}</li>)}</ul>
    </div>
  </section>

  <section class="h-motto" aria-labelledby="motto-title" data-motto>
    <div class="h-motto__jali" aria-hidden="true"></div>
    <div class="wrap h-motto__in">
      <p class="h-motto__eyebrow" id="motto-title">BECCI’s guiding principle</p>
      <p class="h-motto__line" lang="sa" aria-label="बहुजन हिताय, बहुजन सुखाय।">
        {motto.map((w, i) => <><span class="h-motto__w" style={`--w:${i}`} aria-hidden="true">{w}</span>{i < motto.length - 1 ? ' ' : ''}</>)}
      </p>
      <p class="h-motto__translit" lang="sa-Latn">Bahujana Hitāya, Bahujana Sukhāya.</p>
      <span class="h-motto__rule" aria-hidden="true"><i></i></span>
      <p class="h-motto__meaning">For the welfare of the many, for the happiness of the many.</p>
    </div>
    <ol class="wrap h-bc" aria-label="What the five letters of BECCI stand for">
      {pillars.map((p, i) => (
        <li class="h-bc__item" style={`--i:${i}`}>
          <a class="h-bc__card" href={p.href}>
            <img src={`${p.photo.src}-640.webp`} srcset={srcset(p.photo)} sizes="(max-width: 1100px) 46vw, 20vw" alt={p.photo.alt} width="1024" height="1280" style={`object-position:${p.pos}`} loading="lazy" decoding="async" />
            <span class="h-bc__frame" aria-hidden="true"></span>
            <span class="h-bc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="h-bc__body">
              <span class="h-bc__letter" aria-hidden="true">{p.letter}</span>
              <span class="h-bc__word">{p.word}</span>
              <span class="h-bc__title">{p.title}</span>
              <span class="h-bc__text"><span>{p.text}</span></span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section h-paths h-curtain" aria-labelledby="paths-title">
    <div class="wrap">
      <InfinityRule class="h-rule" />
      <div class="h-head" data-reveal>
        <h2 id="paths-title">BECCI for…</h2>
        <p>Start from where you are today. Each path opens the part of the website that is most useful to you first.</p>
      </div>
      <ul class="h-paths__list" data-reveal-group>
        {audiences.map((a, i) => (
          <li><a class={`h-path h-path--${cardTones[i % cardTones.length]}`} href={a.href}>
            <span class="h-path__for">BECCI for</span>
            <strong>{a.who}</strong>
            <span class="h-path__need">{a.need}</span>
            <span class="h-path__go">Start here <span aria-hidden="true">→</span></span>
            <span class="h-path__art" aria-hidden="true"><Icon name={a.icon as any} size={40} /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="open-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <h2 id="open-title">Opportunities you can apply for</h2>
          <p class="h-open__intro">Every listing names the authority that issued it, who can apply, the deadline and the official link, and shows when BECCI last checked it.</p>
        </div>
        <a class="link-arrow" href="/opportunities">All {opportunities.length} records and {portals.length} official portals</a>
      </div>
      <dl class="h-scope" data-reveal>
        <div><dt><span class="scope scope--exclusive">{OBC_SCOPE_LABEL.exclusive}</span></dt><dd>Reserved for OBC/BC applicants under the scheme’s own rules.</dd></div>
        <div><dt><span class="scope scope--preference">{OBC_SCOPE_LABEL.preference}</span></dt><dd>Open more widely, with a written preference or quota for OBC/BC applicants.</dd></div>
        <div><dt><span class="scope scope--open">{OBC_SCOPE_LABEL.open}</span></dt><dd>Open to anyone who meets the eligibility rules. Not every listing is OBC-only.</dd></div>
      </dl>
      <div class="h-open" data-reveal-group>
        {featured && (
          <article class="h-open__feature on-dark">
            <div class="h-open__meta"><span class={`status status--${featured.st}`}>{STATUS_LABEL[featured.st]}</span><span class="h-open__scope">{OBC_SCOPE_LABEL[featured.o.obcScope]}</span></div>
            <h3><a href={`/opportunities/${featured.o.slug}`}>{featured.o.title}</a></h3>
            <p class="h-open__auth">{featured.o.authority}</p>
            <p>{featured.o.summary}</p>
            <p class="h-open__deadline">{deadlineText(featured.o, today)}</p>
          </article>
        )}
        <ol class="h-open__list">
          {rest.map(({ o, st }) => (
            <li>
              <div class="h-open__meta"><span class={`status status--${st}`}>{STATUS_LABEL[st]}</span><span class={`scope scope--${o.obcScope}`}>{OBC_SCOPE_LABEL[o.obcScope]}</span></div>
              <h3><a href={`/opportunities/${o.slug}`}>{o.title}</a></h3>
              <p class="small muted">{o.authority.split(',')[0]} · {deadlineText(o, today)}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section h-gs" aria-labelledby="gs-title">
    <div class="wrap h-gs__grid">
      <div class="h-gs__copy">
        <h2 id="gs-title">Government schemes, explained</h2>
        <p>{schemeList.length} Central and State schemes, each told in six short chapters: why it exists, what it offers, who can benefit, what you need, how to apply, and where to check it officially.</p>
        <p class="h-gs__rule">BECCI explains the opportunity. The issuing government authority remains the source of truth.</p>
        <a class="btn" href="/schemes">Browse government schemes</a>
      </div>
      <ol class="h-gs__list">
        {featuredSchemes.map((o) => (
          <li>
            <a href={`/schemes/${o.slug}`}>
              {schemeLogos[o.slug] && <span class="h-gs__logo"><img src={schemeLogos[o.slug].src} alt="" width="96" height="40" loading="lazy" decoding="async" /></span>}
              <span class="h-gs__name">{o.title}</span>
              <span class="h-gs__by">{o.scheme!.ministry}</span>
              <span class="h-gs__meta"><span>For {o.scheme!.beneficiaries.join(', ').toLowerCase()}</span><span class={`scope scope--${o.obcScope}`}>{OBC_SCOPE_LABEL[o.obcScope]}</span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ImpactStats />

  <Testimonials />

  <section class="section" aria-labelledby="does-title">
    <div class="wrap">
      <div class="h-head" data-reveal>
        <h2 id="does-title">Discover. Develop. Connect. Grow.</h2>
        <p>Each pillar answers a question visitors ask, and says plainly what works today and what is still being set up.</p>
      </div>
      <ul class="h-does" data-reveal-group>
        {answers.map((p) => { const art = pillarArt[p.pillar]; return (
          <li class={`h-pil h-pil--${art.tone}`}>
            {art.tone === 'midnight' && <span class="h-pil__mark" aria-hidden="true"></span>}
            <p class="h-pil__eyebrow"><span>{p.pillar}</span><span class="h-pil__status">{p.status}</span></p>
            <h3>{p.q}</h3>
            <p class="h-pil__text">{p.a}</p>
            <a class="h-pil__link" href={p.href}>{p.link} <span aria-hidden="true">→</span></a>
            {art.illo ? <span class="h-pil__art"><Illo name={art.illo} /></span> : <span class="h-pil__icon" aria-hidden="true"><Icon name={p.icon as any} size={56} /></span>}
          </li>
        ); })}
      </ul>
      <ul class="h-more" aria-label="More from BECCI">
        {more.map((m) => <li><a href={m.href}>{m.label}{m.note && <span class="nav-note">{m.note}</span>}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section h-join on-dark" aria-labelledby="join-title">
    <div class="h-join__bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="h-head h-head--center" data-reveal>
        <h2 id="join-title">Become part of the chamber</h2>
        <p>For Bahujan entrepreneurs, business owners, professionals, students and first-generation founders whose community is on the Central OBC list for their State or on a State BC/OBC list. Either list is enough.</p>
      </div>
      <ol class="h-tiers" data-reveal-group>
        {tiers.map((t, i) => <li><span class="h-tiers__step">Level {i + 1}</span><h3>{t.name} <span>Membership</span></h3><p>{t.text}</p></li>)}
      </ol>
      <div class="h-member__foot">
        <a class="btn btn--light" href="/membership#join">Join BECCI</a>
        <p class="small">These three categories are proposed. Fees and final benefits will be confirmed before online applications open. Until then, the membership team can explain them on a call.</p>
      </div>
    </div>
  </section>

  <AdvisorsStrip />

  <section class="section h-close" aria-labelledby="close-title">
    <div class="wrap">
      <div class="h-close__box">
        <span class="h-close__art"><Illo name="arch" /></span>
        <h2 id="close-title">Open doors for entrepreneurs at scale</h2>
        <p>Government departments, banks, MSME bodies, industry associations, educational institutions, incubators and corporates can create opportunities for entrepreneurs that ordinary networking cannot. BECCI welcomes proposals for collaboration.</p>
        <div class="h-close__cta"><a class="btn" href="/partnerships">Partner with BECCI</a><a class="btn btn--ghost" href="/contact">Contact the chamber</a></div>
        <ul class="h-close__links">
          <li><a href="/events"><Icon name="events" size={22} /><strong>Event calendar</strong><span>{realCount(events) ? `${realCount(events)} announced` : events.length ? 'Sample content' : 'No events announced yet'}</span></a></li>
          <li><a href="/news"><Icon name="news" size={22} /><strong>News</strong><span>{realCount(news) ? `${realCount(news)} announcements` : news.length ? 'Sample content' : 'No announcements yet'}</span></a></li>
          <li><a href="/knowledge"><Icon name="knowledge" size={22} /><strong>Knowledge Centre</strong><span>Guides and resources</span></a></li>
          <li><a href="/leadership"><Icon name="leadership" size={22} /><strong>Leadership</strong><span>{realCount(advisors) ? `${realCount(advisors)} advisors` : advisors.length ? 'Sample content' : 'Profiles coming soon'}</span></a></li>
        </ul>
      </div>
    </div>
    {stats.length > 0 && <ul class="wrap h-stats">{stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span><small>{s.period} · {s.basis}</small></li>)}</ul>}
  </section>
</Base>

<script>
  // Motto: words light up as the line crosses the viewport; the five cards rise once when in view.
  // Transforms, opacity and filter only. Nothing runs with reduced motion; CSS then shows the final state.
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const motto = document.querySelector<HTMLElement>('[data-motto]');
    if (motto) {
      const words = Array.from(motto.querySelectorAll<HTMLElement>('.h-motto__w'));
      let queued = false;
      const frame = () => {
        queued = false;
        const r = motto.getBoundingClientRect(), vh = window.innerHeight;
        const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (vh * 0.55)));
        words.forEach((w, i) => w.style.setProperty('--on', p > 0.12 + i * 0.13 ? '1' : '0'));
        motto.style.setProperty('--rule', p > 0.62 ? '1' : '0');
        motto.style.setProperty('--meaning', p > 0.7 ? '1' : '0');
      };
      const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(frame); } };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      frame();
    }
    const deck = document.querySelector<HTMLElement>('.h-bc');
    if (deck && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { deck.setAttribute('data-in', ''); io.disconnect(); } }), { threshold: 0.15 });
      io.observe(deck);
    } else deck?.setAttribute('data-in', '');
  }
</script>


<style>
  /* ── Hero: saturated royal surface with a drawing grid, copy left, illustrated stage right ── */
  .h-hero { position: relative; z-index: 2; isolation: isolate; overflow: hidden; background: var(--royal); color: #dbe6fb; padding-top: clamp(var(--s-7), 6vw, 96px); }
  .h-hero__bg { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(rgb(255 255 255 / 9%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 9%) 1px, transparent 1px); background-size: 72px 72px; background-position: -1px -1px; mask-image: linear-gradient(180deg, #000 60%, transparent); }
  .h-hero__bg::after { content: ''; position: absolute; inset: 0; background: radial-gradient(50% 60% at 80% 40%, rgb(200 210 228 / 35%), transparent 70%); }
  .h-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-6); align-items: center; }
  /* Headline: heavier editorial weight (ref. Bizpole's bold display), tight leading, measured tracking */
  .kinetic { color: #fff; font-size: clamp(2.75rem, 0.8rem + 4.4vw, 5.25rem); font-weight: 700; line-height: 0.96; letter-spacing: -0.015em; margin: 0 0 var(--s-5); max-width: none; font-kerning: normal; }
  .kinetic__line { display: block; white-space: nowrap; }
  .kinetic__line--lit { color: #bfe7ff; }
  .kw { display: inline-block; overflow: hidden; padding: 0.14em 0.06em 0.08em; margin: -0.14em -0.06em -0.08em; vertical-align: top; }
  .kw > span { display: inline-block; }
  .h-hero__lede { font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem); font-weight: 400; line-height: 1.5; letter-spacing: -0.005em; color: #eef3fd; max-width: 34ch; margin: 0 0 var(--s-6); text-wrap: pretty; }
  .h-hero__id { font-size: var(--fs-sm); line-height: 1.55; color: #d3e0f8; max-width: 50ch; margin: var(--s-6) 0 var(--s-4); padding-top: var(--s-4); border-top: 1px solid rgb(255 255 255 / 18%); }
  .h-hero__id strong { color: #fff; font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .kw > span { transform: translateY(105%) rotate(4deg); animation: rise 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: calc(120ms + var(--i) * 90ms); }
    :global(.js) .h-in { opacity: 0; transform: translateY(16px); animation: fadeUp 700ms var(--ease) forwards; animation-delay: calc(var(--i) * 80ms); }
    :global(.js) .h-card { opacity: 0; animation: cardIn 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    :global(.js) .h-card--0 { animation-delay: 700ms; } :global(.js) .h-card--1 { animation-delay: 850ms; }
    .h-card { transition: transform 300ms var(--ease), box-shadow 300ms var(--ease); }
    }
  @keyframes rise { to { transform: none; } }
  @keyframes fadeUp { to { opacity: 1; transform: none; } }
  @keyframes cardIn { from { opacity: 0; translate: 0 40px; } to { opacity: 1; translate: 0 0; } }

  .h-search { width: min(100%, 520px); margin-bottom: var(--s-3); }
  .h-search__row { position: relative; display: flex; align-items: center; gap: var(--s-2); padding: 6px; background: #fff; border-radius: 999px; border: 1px solid var(--midnight); box-shadow: none; }
  :global(.h-search__icon) { position: absolute; left: 20px; color: var(--slate); pointer-events: none; }
  .h-search .input { flex: 1; min-width: 0; border: 0; background: transparent; min-height: 44px; padding-left: 46px; font-size: var(--fs-base); box-shadow: none; }
  .h-search .input:focus-visible { outline: 2px solid var(--royal); outline-offset: 2px; border-radius: 999px; }
  .h-search__row:focus-within { box-shadow: 0 0 0 4px var(--cyan); }
  .h-search .btn { min-height: 44px; padding: 0 var(--s-5); border-radius: 999px; --bg: var(--midnight); --bd: var(--midnight); }
  .h-cats { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; padding: 0; margin: 0 0 var(--s-5); }
  .h-cats a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--s-3); border-radius: 999px; border: 1px solid rgb(255 255 255 / 30%); background: rgb(255 255 255 / 8%); color: #fff; font-size: var(--fs-sm); font-weight: 500; text-decoration: none; transition: background var(--dur), border-color var(--dur), color var(--dur); }
  .h-cats a:hover { color: var(--midnight); background: #fff; border-color: #fff; }
  .h-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .h-hero__actions .btn { border-radius: 999px; min-height: 56px; padding: 0 var(--s-6); font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.005em; }
  .h-hero__actions .btn--light { box-shadow: 4px 4px 0 var(--midnight); }
  .h-hero__actions .btn--light:hover { transform: translateY(-1px); }
  :global(.btn--light) { --bg: #fff; --bd: #fff; --fg: var(--midnight); }
  :global(.btn--light:hover) { --bg: var(--cyan-soft); --bd: var(--cyan-soft); --fg: var(--midnight); }

  /* Stage: illustration with live opportunity cards layered over it */
  .h-art { position: relative; min-height: 520px; }
  .h-art__scene { position: absolute; inset: 14% -6% 0 6%; }
  .h-art__live { position: absolute; top: 6%; right: 2%; z-index: 3; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: var(--midnight); color: #fff; font-size: var(--fs-label); font-weight: 600; box-shadow: 3px 3px 0 rgb(8 26 53 / 40%); }
  .h-art__live::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 0 3px rgb(200 210 228 / 35%); }
  .h-card { position: absolute; z-index: 2; width: min(272px, 56%); padding: var(--s-4); background: #fff; color: var(--ink); border: 1px solid var(--midnight); border-radius: 16px; box-shadow: 6px 6px 0 var(--midnight); }
  .h-card--0 { top: 0; left: 0; }
  .h-card--1 { bottom: 0; right: 0; }
  .h-card:hover { transform: translateY(-2px); box-shadow: 8px 10px 0 var(--midnight); }
  .h-card__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
  .h-card__cat { margin-left: auto; font-size: var(--fs-label); font-weight: 600; color: var(--slate); }
  .h-card h3 { font-size: var(--fs-base); line-height: 1.3; margin: var(--s-2) 0 2px; }
  .h-card h3 a { color: var(--midnight); text-decoration: none; }
  .h-card h3 a::after { content: ''; position: absolute; inset: 0; }
  .h-card h3 a:hover { color: var(--royal); }
  .h-card p { margin: 0; font-size: var(--fs-sm); color: var(--slate); }
  .h-card .h-card__when { color: var(--ink); font-weight: 600; margin-top: 2px; }

  .h-sources { position: relative; margin-top: var(--s-6); padding: var(--s-4) 0 calc(var(--s-6) + 40px); overflow: hidden; border-top: 1px solid rgb(255 255 255 / 16%); }
  .h-sources__label { margin: 0 auto var(--s-3); font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #c5d6f6; }
  .h-sources__list { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); list-style: none; padding: 0; margin-top: 0; margin-bottom: 0; }
  .h-sources li { font: 500 var(--fs-base)/1.4 var(--font-display); color: #fff; }

  @media (max-width: 1000px) {
    .h-hero__grid { grid-template-columns: minmax(0, 1fr); }
    .h-art { min-height: 0; aspect-ratio: 640 / 520; max-width: 640px; width: 100%; margin-inline: auto; }
    .h-art__scene { inset: 0; }
  }
  @media (max-width: 560px) {
    .h-hero { padding-top: var(--s-6); }
    .kinetic { font-size: clamp(2.75rem, 13.5vw, 3.75rem); line-height: 0.98; letter-spacing: -0.015em; }
    .kinetic__line { white-space: normal; }
    .h-hero__actions .btn { flex: 1 1 100%; }
    .h-hero__lede { margin-bottom: var(--s-5); }
    .h-search__row { flex-wrap: wrap; border-radius: 20px; }
    .h-search .btn { width: 100%; border-radius: 14px; }
    :global(.h-search__icon) { top: 20px; }
    .h-cats a { padding: 0 var(--s-3); }
    .h-art { aspect-ratio: auto; display: grid; gap: var(--s-3); padding-top: 64%; }
    .h-art__scene { inset: 0 -6% auto -6%; }
    .h-card { position: relative; inset: auto; width: 100%; rotate: none; box-shadow: 4px 4px 0 var(--midnight); }
    .h-card--1 { display: none; }
    .h-art__live { top: 0; right: 0; }
  }

  /* Statement */
  /* BECCI card experience: Sanskrit motto in champagne gold over five art-directed photographic cards. */
  @font-face { font-family: 'BECCI Motto'; src: url('/fonts/TiroDevanagariSanskrit-motto.woff2') format('woff2'); font-display: swap; unicode-range: U+0900-097F, U+0964; }
  .h-motto { --gold: #c6a15b; --gold-2: #a9874c; --gold-hi: #ecd6a4; --ink-night: #061329; position: relative; isolation: isolate; padding-block: calc(var(--s-9) + 40px) calc(var(--s-8) + 40px); margin-top: -40px; overflow: hidden;
    /* continues the hero's royal blue and settles into midnight, so the section emerges rather than cuts in */
    background: linear-gradient(180deg, #0A2352 0, #091f49 140px, #071a3f 300px, #061638 420px, var(--ink-night) 560px, var(--ink-night) calc(100% - 260px), #081b38 100%); }
  .h-motto::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background:
      radial-gradient(34% 26% at 50% 30%, rgb(198 161 91 / 18%), transparent 72%),
      radial-gradient(70% 30% at 50% 78%, rgb(198 161 91 / 9%), transparent 70%),
      radial-gradient(60% 22% at 50% 100%, rgb(10 35 82 / 16%), transparent 70%); }
  /* A faint jali (lattice) behind the motto, the traditional Indian screen, drawn in gold at very low opacity. */
  .h-motto__jali { position: absolute; z-index: -1; left: 50%; top: 40px; width: 980px; height: 560px; translate: -50% 0; opacity: 0.09; pointer-events: none;
    background: radial-gradient(circle at 50% 50%, transparent 9px, var(--gold) 9.5px, var(--gold) 10.5px, transparent 11px) 0 0 / 28px 28px,
                radial-gradient(circle at 0 0, transparent 9px, var(--gold) 9.5px, var(--gold) 10.5px, transparent 11px) 0 0 / 28px 28px;
    -webkit-mask: radial-gradient(closest-side, #000 30%, transparent); mask: radial-gradient(closest-side, #000 30%, transparent); }
  .h-motto__in { position: relative; display: grid; justify-items: center; text-align: center; }
  .h-motto__eyebrow { display: inline-flex; align-items: center; gap: 16px; margin: 0 0 var(--s-6); color: var(--gold); font: 700 var(--fs-label)/1 var(--font-body); letter-spacing: 0.24em; text-transform: uppercase; }
  .h-motto__eyebrow::before, .h-motto__eyebrow::after { content: ''; width: 48px; height: 1px; background: linear-gradient(90deg, transparent, var(--gold)); }
  .h-motto__eyebrow::after { transform: scaleX(-1); }
  .h-motto__line { margin: 0; font: 400 clamp(3.25rem, 1rem + 5vw, 7.25rem)/1.22 'BECCI Motto', 'Kohinoor Devanagari', 'Devanagari Sangam MN', 'Noto Serif Devanagari', 'Nirmala UI', serif; letter-spacing: 0.01em; filter: drop-shadow(0 0 28px rgb(198 161 91 / 28%)) drop-shadow(0 2px 0 rgb(0 0 0 / 35%)); }
  .h-motto__w { display: inline-block; color: var(--gold); background: linear-gradient(176deg, var(--gold-hi) 8%, var(--gold) 46%, var(--gold-2) 78%, #8a6a35 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .h-motto__translit { margin: var(--s-3) 0 0; color: var(--gold); font: italic 400 clamp(1.125rem, 0.9rem + 0.5vw, 1.375rem)/1.3 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif; letter-spacing: 0.04em; opacity: 0.92; }
  .h-motto__rule { position: relative; display: block; width: min(560px, 60%); height: 1px; margin: var(--s-5) 0 var(--s-4); background: linear-gradient(90deg, transparent, var(--gold) 22%, var(--gold) 78%, transparent); transform-origin: center; }
  .h-motto__rule i { position: absolute; left: 50%; top: 50%; width: 9px; height: 9px; translate: -50% -50%; rotate: 45deg; background: var(--ink-night); border: 1px solid var(--gold); box-shadow: 0 0 12px rgb(198 161 91 / 60%); }
  .h-motto__meaning { margin: 0; color: #eee4cf; font: 500 clamp(1.125rem, 0.95rem + 0.5vw, 1.4375rem)/1.5 var(--font-body); letter-spacing: 0.01em; }

  /* Five cards */
  .h-bc { list-style: none; padding: 0; margin-top: clamp(64px, 6vw, 96px); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(12px, 1.1vw, 20px); }
  .h-bc__card { position: relative; display: block; aspect-ratio: 3 / 4.6; overflow: hidden; border-radius: 6px; color: #fff; text-decoration: none; isolation: isolate; background: #0b1a33;
    box-shadow: 0 0 0 1px rgb(198 161 91 / 32%), 0 30px 60px -30px rgb(0 0 0 / 70%), 0 12px 24px -16px rgb(0 0 0 / 55%);
    transition: transform 600ms var(--ease), box-shadow 600ms var(--ease); outline-offset: 6px; }
  .h-bc__card img { position: absolute; inset: 0; z-index: -3; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.86) contrast(1.08) brightness(0.92); transform: scale(1.02); transition: transform 1200ms var(--ease), filter 700ms var(--ease); }
  /* cinematic grade: warm gold light from the top, navy depth at the base */
  .h-bc__card::before { content: ''; position: absolute; inset: 0; z-index: -2; background: radial-gradient(90% 55% at 50% 0%, rgb(236 214 164 / 18%), transparent 60%), linear-gradient(180deg, rgb(6 19 41 / 55%) 0%, rgb(6 19 41 / 0%) 22%, rgb(6 19 41 / 0%) 40%, rgb(6 19 41 / 62%) 62%, rgb(6 19 41 / 94%) 84%, rgb(6 19 41 / 98%) 100%); mix-blend-mode: normal; }
  /* a gold sheen that crosses once on hover */
  .h-bc__card::after { content: ''; position: absolute; inset: -20% -60%; z-index: -1; background: linear-gradient(105deg, transparent 42%, rgb(236 214 164 / 16%) 50%, transparent 58%); transform: translateX(-60%); transition: transform 1100ms var(--ease); pointer-events: none; }
  .h-bc__frame { position: absolute; inset: 10px; border: 1px solid rgb(198 161 91 / 26%); border-radius: 3px; pointer-events: none; transition: border-color 600ms var(--ease), inset 600ms var(--ease); }
  .h-bc__num { position: absolute; top: 24px; left: 24px; color: var(--gold-hi); font: 700 0.75rem/1 var(--font-body); letter-spacing: 0.2em; }
  .h-bc__num::after { content: ''; display: inline-block; vertical-align: middle; width: 28px; height: 1px; margin-left: 10px; background: rgb(198 161 91 / 60%); }
  .h-bc__body { position: absolute; inset: auto 0 0; display: grid; padding: 0 26px 28px; }
  .h-bc__letter { font: 700 clamp(3.5rem, 2rem + 2.6vw, 5.25rem)/0.9 var(--font-display); letter-spacing: -0.01em; color: var(--gold-hi); background: linear-gradient(180deg, #f7ecd2 0%, var(--gold) 70%, var(--gold-2) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 18px rgb(0 0 0 / 45%)); }
  .h-bc__word { margin-top: 14px; padding-top: 14px; border-top: 1px solid rgb(198 161 91 / 55%); color: var(--gold); font: 700 0.75rem/1 var(--font-body); letter-spacing: 0.24em; text-transform: uppercase; }
  .h-bc__title { margin-top: 10px; color: #fff; font: 700 clamp(1.0625rem, 0.85rem + 0.35vw, 1.25rem)/1.25 var(--font-display); text-wrap: balance; }
  .h-bc__text { display: grid; grid-template-rows: 0fr; margin-top: 0; color: rgb(247 245 239 / 82%); font-size: 0.875rem; line-height: 1.5; opacity: 0; transition: grid-template-rows 600ms var(--ease), opacity 450ms var(--ease), margin-top 600ms var(--ease); }
  .h-bc__text > span { min-height: 0; overflow: hidden; }
  .h-bc__card:hover, .h-bc__card:focus-visible { transform: translateY(-8px); box-shadow: 0 0 0 1px rgb(198 161 91 / 70%), 0 40px 70px -30px rgb(0 0 0 / 80%), 0 0 40px -10px rgb(198 161 91 / 35%); color: #fff; text-decoration: none; }
  .h-bc__card:hover img, .h-bc__card:focus-visible img { transform: scale(1.08); filter: saturate(0.95) contrast(1.1) brightness(0.72); }
  .h-bc__card:hover::after, .h-bc__card:focus-visible::after { transform: translateX(60%); }
  .h-bc__card:hover .h-bc__frame, .h-bc__card:focus-visible .h-bc__frame { border-color: rgb(198 161 91 / 60%); inset: 8px; }
  .h-bc__card:hover .h-bc__text, .h-bc__card:focus-visible .h-bc__text { grid-template-rows: 1fr; opacity: 1; margin-top: 10px; }
  @media (hover: none) { .h-bc__text { grid-template-rows: 1fr; opacity: 1; margin-top: 10px; } }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .h-motto__w { opacity: calc(0.12 + 0.88 * var(--on, 0)); transform: translateY(calc((1 - var(--on, 0)) * 0.16em)); filter: blur(calc((1 - var(--on, 0)) * 6px)); transition: opacity 700ms var(--ease), transform 900ms var(--ease), filter 700ms var(--ease); }
    :global(.js) .h-motto__translit { opacity: calc(0.92 * var(--rule, 0)); transition: opacity 800ms var(--ease); }
    :global(.js) .h-motto__rule { transform: scaleX(var(--rule, 0)); transition: transform 1000ms var(--ease); }
    :global(.js) .h-motto__meaning { opacity: var(--meaning, 0); transform: translateY(calc((1 - var(--meaning, 0)) * 10px)); transition: opacity 800ms var(--ease), transform 800ms var(--ease); }
    :global(.js) .h-bc__item { opacity: 0; transform: translateY(40px); transition: opacity 900ms var(--ease), transform 1100ms var(--ease); transition-delay: calc(var(--i) * 120ms); }
    :global(.js) .h-bc[data-in] .h-bc__item { opacity: 1; transform: none; }
  }
  @media (max-width: 1100px) { .h-bc { grid-template-columns: repeat(2, minmax(0, 1fr)); } .h-motto__jali { width: 100%; } }
  .h-hero { border-radius: 0 0 40px 40px; }

  /* Curtain */
  :global(.h-rule) { margin-bottom: var(--s-6); }
  .h-curtain { position: relative; z-index: 1; margin-top: -40px; border-radius: 40px 40px 0 0; background: var(--ivory); }
  @media (max-width: 560px) { .h-curtain { border-radius: 24px 24px 0 0; margin-top: -24px; } .h-hero { border-radius: 0 0 24px 24px; } .h-facts { flex-direction: column; align-items: flex-start; } }

  /* Section heads (Tines: eyebrow, large editorial heading, short lede) */
  .h-head { max-width: 760px; margin-bottom: var(--s-7); }
  .h-head h2 { font-size: clamp(2.25rem, 1.4rem + 3vw, 4rem); font-weight: 700; letter-spacing: -0.015em; line-height: 1.02; margin-bottom: var(--s-4); }
  .h-head p:not(.eyebrow) { color: var(--slate); font-size: var(--fs-md); max-width: 56ch; margin: 0; }
  .h-head--center { max-width: 620px; margin-inline: auto; text-align: center; }
  .h-head--center p:not(.eyebrow) { margin-inline: auto; }
  .eyebrow { letter-spacing: 0.14em; }

  /* ── Audience paths: colour-blocked "BECCI for" cards ── */
  .h-paths__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
  .h-path { --bg: var(--ice); --art: var(--sapphire-soft); position: relative; display: flex; flex-direction: column; height: 100%; min-height: 300px; padding: var(--s-5) var(--s-5) var(--s-5); overflow: hidden; background: var(--bg); border: 1px solid rgb(8 26 53 / 14%); border-radius: 18px; color: var(--slate); text-decoration: none; font-size: var(--fs-sm); transition: transform 260ms var(--ease), box-shadow 260ms var(--ease); }
  .h-path--cyan { --bg: var(--cyan-soft); --art: #dfe5ee; }
  .h-path--sky { --bg: var(--sky-tint); --art: #bcdaf7; }
  .h-path--white { --bg: #fff; --art: var(--ice); }
  .h-path--sapphire { --bg: var(--royal); --art: var(--sapphire); color: #d3e0fa; }
  .h-path--stone { --bg: #ece7da; --art: #ded6c3; }
  .h-path:hover { color: inherit; transform: translateY(-2px); box-shadow: 6px 8px 0 var(--midnight); }
  .h-path--sapphire:hover { color: #d3e0fa; }
  .h-path__for { font: 600 0.6875rem/1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--royal); }
  .h-path--sapphire .h-path__for { color: #bfe7ff; }
  .h-path strong { margin: var(--s-2) 0 var(--s-3); font: 500 var(--fs-xl)/1.1 var(--font-display); letter-spacing: -0.01em; color: var(--midnight); max-width: 12ch; }
  .h-path--sapphire strong { color: #fff; }
  .h-path__need { max-width: 30ch; }
  .h-path__go { margin-top: auto; padding-top: var(--s-5); font-weight: 600; color: var(--midnight); }
  .h-path--sapphire .h-path__go { color: #fff; }
  .h-path__go span { display: inline-block; transition: translate 200ms var(--ease); }
  .h-path:hover .h-path__go span { translate: 4px 0; }
  .h-path__art { position: absolute; right: var(--s-5); bottom: var(--s-5); display: grid; place-items: center; width: 84px; height: 84px; border-radius: 22px; background: var(--art); border: 1px solid rgb(8 26 53 / 18%); color: var(--midnight); --icon-accent: var(--cyan); box-shadow: 4px 4px 0 rgb(8 26 53 / 85%); }
  .h-path--sapphire .h-path__art { color: #fff; --icon-accent: var(--sky); }
  @media (max-width: 960px) { .h-paths__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .h-paths__list { grid-template-columns: 1fr; gap: var(--s-3); } .h-path { min-height: 0; padding-right: 110px; } .h-path__art { width: 64px; height: 64px; border-radius: 18px; top: var(--s-5); bottom: auto; } .h-path strong { font-size: var(--fs-lg); } }

  /* ── Opportunities ── */
  .h-open__intro { margin: var(--s-2) 0 0; color: var(--slate); max-width: 56ch; }
  .h-scope { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); margin: 0 0 var(--s-6); padding: var(--s-4) var(--s-5); border-radius: 16px; background: var(--ivory); border: 1px solid rgb(8 26 53 / 12%); }
  .h-scope dt { margin-bottom: var(--s-2); }
  .h-scope dd { margin: 0; font-size: var(--fs-sm); color: var(--slate); }
  @media (max-width: 760px) { .h-scope { grid-template-columns: 1fr; } }
  .h-open { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-6); align-items: stretch; }
  .h-open__feature { position: relative; border-radius: 18px; padding: clamp(var(--s-5), 3vw, var(--s-7)); display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); color: #d3e0fa; background: var(--royal); border: 1px solid var(--midnight); box-shadow: 10px 10px 0 var(--sky-tint), 10px 10px 0 1px rgb(8 26 53 / 30%); background-image: linear-gradient(rgb(255 255 255 / 7%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 7%) 1px, transparent 1px); background-size: 36px 36px; }
  .h-open__feature h3 { font-size: var(--fs-xl); line-height: 1.2; margin: var(--s-2) 0 0; color: #fff; }
  .h-open__feature p { margin: 0; }
  .h-open__feature .h-open__auth { color: #cfd8e6; font-size: var(--fs-sm); }
  .h-open__feature h3 a { color: #fff; text-decoration: none; }
  .h-open__feature h3 a:hover { color: #fff; text-decoration: underline; }
  .h-open__scope { font-size: var(--fs-label); font-weight: 600; color: #fff; padding: 5px 8px; border-radius: 4px; background: rgb(255 255 255 / 16%); }
  .h-open__deadline { margin-top: auto !important; padding-top: var(--s-4); font-weight: 600; color: #fff; }
  .h-open h3 a::after { content: ''; position: absolute; inset: 0; }
  .h-open__list { list-style: none; padding: 0; margin: 0; border-top: var(--hair); }
  .h-open__list li { position: relative; padding: var(--s-5) var(--s-3); border-bottom: var(--hair); border-radius: 8px; transition: background var(--dur); }
  .h-open__list li:hover { background: var(--ice); }
  .h-open__list h3 { margin: var(--s-3) 0 var(--s-1); font-size: var(--fs-md); }
  .h-open__list h3 a { color: var(--midnight); text-decoration: none; }
  .h-open__list h3 a:hover { color: var(--royal); }
  .h-open__list p { margin: 0; }
  .h-open__meta { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  @media (max-width: 960px) { .h-open { grid-template-columns: 1fr; } }

  /* ── Pillars: Tines resource grid, mixed spans and surfaces ── */
