---
import Base from '../layouts/Base.astro';
import LetterStory from '../components/LetterStory.astro';
import BrandMedia from '../components/BrandMedia.astro';
import { site, audiences, advisors, events, news, stats } from '../data/site';
import { PHOTOS } from '../data/media';
import { opportunities, CATEGORY_META, CATEGORY_ORDER, OBC_SCOPE_LABEL } from '../data/opportunities';
import { computeStatus, STATUS_LABEL, deadlineText, todayISO } from '../lib/status';

const today = todayISO();
const open = opportunities
  .map((o) => ({ o, st: computeStatus(o, today) }))
  .filter((x) => x.st !== 'closed' && x.st !== 'awaiting-notice')
  .sort((a, b) => (a.o.closingDate ?? '9999').localeCompare(b.o.closingDate ?? '9999'));
const [featured, ...rest] = open;
const pillars = [
  { title: 'Open opportunities', text: 'Schemes, scholarships, loans, tenders and jobs, each checked against its official source.', href: '/opportunities', link: 'Find opportunities' },
  { title: 'Connect entrepreneurs', text: 'Events, wings and sector committees that put business owners in the same room.', href: '/wings', link: 'Wings and sectors' },
  { title: 'Build capability', text: 'Services, guidance and knowledge for starting and growing an enterprise.', href: '/services', link: 'Services' },
  { title: 'Partner with institutions', text: 'Banks, departments, educational institutions and industry bodies that open doors at scale.', href: '/partnerships', link: 'Partnerships' },
];
const more = [
  { label: 'Franchise & Enterprise', href: '/franchise' },
  { label: 'Knowledge Centre', href: '/knowledge' },
  { label: 'Success Stories', href: '/success-stories' },
  { label: 'Biz Connect', href: '/biz-connect', note: 'Coming later' },
  { label: 'Marketplace', href: '/marketplace', note: 'Coming later' },
];
const tiers = [
  { name: 'Free', text: 'Basic platform access and manual scheme search for your home State and National schemes.' },
  { name: 'Affiliate', text: 'Everything in Free, plus profile-based scheme suggestions and opportunity notifications.' },
  { name: 'Associate', text: 'Everything in Affiliate, plus one complimentary Scheme Suggestion Report.' },
];
---
<Base title="Home">
  <section class="h-hero on-dark" data-enter>
    <div class="wrap h-hero__grid">
      <div class="h-hero__copy">
        
        <h1>Where Community <span>Meets Commerce</span></h1>
        <p class="h-hero__lede">{site.supporting}</p>
        <form class="h-search" action="/opportunities" method="get" role="search">
          <label for="hero-q" class="h-search__label">Find schemes, scholarships, loans, tenders and jobs</label>
          <div class="h-search__row">
            <input id="hero-q" name="q" type="search" class="input" placeholder="Try “loan”, “scholarship” or “tender”" />
            <button class="btn btn--accent" type="submit">Search</button>
          </div>
          <ul class="h-cats" aria-label="Browse by category">
            {CATEGORY_ORDER.map((c) => <li><a href={CATEGORY_META[c].path}>{CATEGORY_META[c].label}</a></li>)}
          </ul>
        </form>
        <div class="h-hero__actions">
          <a class="btn btn--accent" href="/membership#join">Join as a Member</a>
          <a class="btn btn--ghost" href="/about">About the chamber</a>
        </div>
      </div>
      <div class="h-hero__media">
        <BrandMedia src={PHOTOS.homeHero.src} alt={PHOTOS.homeHero.alt} ratio="4 / 5" eager />
      </div>
    </div>
    <div class="wrap h-promise"><p>{site.promise}</p></div>
  </section>

  <section class="h-paths" aria-labelledby="paths-title">
    <div class="wrap">
      <h2 id="paths-title" class="h-paths__title">I am…</h2>
      <ul class="h-paths__list">
        {audiences.map((a) => (
          <li><a href={a.href}><strong>{a.who}</strong><span>{a.need}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="open-title">
    <div class="wrap">
      <div class="section-head">
        <div><h2 id="open-title">Opportunities you can apply for</h2></div>
        <a class="link-arrow" href="/opportunities">All opportunities and official portals</a>
      </div>
      <div class="h-open">
        {featured && (
          <article class="h-open__feature">
            <span class={`status status--${featured.st}`}>{STATUS_LABEL[featured.st]}</span>
            <h3><a href={`/opportunities/${featured.o.slug}`}>{featured.o.title}</a></h3>
            <p class="muted small">{featured.o.authority}</p>
            <p>{featured.o.summary}</p>
            <p class="h-open__deadline">{deadlineText(featured.o, today)}</p>
            <span class={`scope scope--${featured.o.obcScope}`}>{OBC_SCOPE_LABEL[featured.o.obcScope]}</span>
          </article>
        )}
        <ol class="h-open__list">
          {rest.map(({ o, st }) => (
            <li>
              <div class="h-open__meta"><span class={`status status--${st}`}>{STATUS_LABEL[st]}</span><span class={`scope scope--${o.obcScope}`}>{OBC_SCOPE_LABEL[o.obcScope]}</span></div>
              <h3><a href={`/opportunities/${o.slug}`}>{o.title}</a></h3>
              <p class="small muted">{o.authority.split(',')[0]} · {deadlineText(o, today)}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <LetterStory />

  <section class="section" aria-labelledby="does-title">
    <div class="wrap h-does">
      <div class="h-does__intro">
        
        <h2 id="does-title">From a first idea to an established enterprise</h2>
        <p class="lede">BECCI is a national chamber for OBC entrepreneurs. It began in Telangana and Andhra Pradesh and is building towards a national presence.</p>
        <ul class="h-does__more" aria-label="More from BECCI">
          {more.map((m) => <li><a href={m.href}>{m.label}</a>{m.note && <span class="nav-note">{m.note}</span>}</li>)}
        </ul>
      </div>
      <ul class="h-does__list">
        {pillars.map((p) => (
          <li><h3>{p.title}</h3><p>{p.text}</p><a class="link-arrow" href={p.href}>{p.link}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="join-title">
    <div class="wrap">
      <div class="section-head">
        <div><h2 id="join-title">Become part of the chamber</h2></div>
        <p>For Bahujan entrepreneurs, professionals, students and first-generation founders whose community is in the Central OBC list for their State or a State BC/OBC list.</p>
      </div>
      <ol class="h-tiers">
        {tiers.map((t) => <li><h3>{t.name} Membership</h3><p>{t.text}</p></li>)}
      </ol>
      <div class="h-member__foot">
        <a class="btn btn--accent" href="/membership#join">Join as a Member</a>
        <p class="small muted">Categories are proposed. Fees and final benefits will be confirmed before applications open.</p>
      </div>
    </div>
  </section>

  <section class="section h-close" aria-labelledby="close-title">
    <div class="wrap h-close__grid">
      <div>
        
        <h2 id="close-title">Open doors for entrepreneurs at scale</h2>
        <p>Government departments, banks, MSME bodies, educational institutions, incubators and corporates can create opportunities that ordinary networking cannot.</p>
        <a class="btn btn--accent" href="/partnerships">Partner with BECCI</a>
      </div>
      <ul class="h-close__links">
        <li><a href="/events"><strong>Event calendar</strong><span>{events.length ? `${events.length} announced` : 'No events announced yet'}</span></a></li>
        <li><a href="/news"><strong>News Desk</strong><span>{news.length ? `${news.length} announcements` : 'No announcements yet'}</span></a></li>
        <li><a href="/knowledge"><strong>Knowledge Centre</strong><span>Guides and resources</span></a></li>
        <li><a href="/leadership"><strong>Leadership</strong><span>{advisors.length ? `${advisors.length} advisors` : 'Profiles coming soon'}</span></a></li>
      </ul>
    </div>
    {stats.length > 0 && <ul class="wrap h-stats">{stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span><small>{s.period} · {s.basis}</small></li>)}</ul>}
  </section>
</Base>

<style>
  .h-hero { background: var(--midnight); color: var(--on-dark-2); padding-top: clamp(var(--s-6), 5vw, var(--s-8)); overflow: hidden; display: flex; flex-direction: column; justify-content: center; }
  @media (min-width: 961px) and (min-height: 700px) { .h-hero { min-height: calc(100svh - var(--header-h)); } }
  .h-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(var(--s-6), 5vw, var(--s-8)); align-items: center; }
  .h-hero h1 { color: #fff; font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4rem); font-weight: 500; line-height: 1.04; letter-spacing: -0.02em; margin-bottom: var(--s-5); }
  .h-hero h1 span { display: block; }
  .h-hero__lede { font-size: var(--fs-md); color: var(--on-dark); max-width: 46ch; margin-bottom: var(--s-6); }
  .h-search { border-top: 1px solid rgb(255 255 255 / 14%); padding-top: var(--s-5); margin-bottom: var(--s-6); }
  .h-search__label { display: block; font-size: var(--fs-sm); font-weight: 500; color: var(--on-dark-2); margin-bottom: var(--s-3); }
  .h-search__row { display: flex; gap: var(--s-2); }
  .h-search .input { border-color: transparent; min-height: 56px; font-size: var(--fs-md); }
  .h-search .btn { min-height: 56px; padding: 0 var(--s-6); }
  .h-cats { display: flex; flex-wrap: wrap; gap: 0 var(--s-5); list-style: none; padding: 0; margin: var(--s-3) 0 0; }
  .h-cats a { display: inline-flex; align-items: center; min-height: 44px; color: #fff; font-weight: 500; text-decoration: underline; text-decoration-color: rgb(255 255 255 / 35%); text-underline-offset: 6px; }
  .h-cats a:hover { color: #fff; text-decoration-color: #fff; }
  .h-hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .h-promise p { margin: clamp(var(--s-6), 5vw, var(--s-7)) 0 0; padding: var(--s-5) 0; border-top: 1px solid rgb(255 255 255 / 10%); font: 400 var(--fs-base)/1 var(--font-display); letter-spacing: 0.02em; color: var(--on-dark-2); }
  @media (max-width: 960px) { .h-hero__grid { grid-template-columns: 1fr; } .h-hero__media { display: none; } }
  @media (max-width: 520px) { .h-search__row { flex-direction: column; } .h-search .btn { width: 100%; } .h-hero .eyebrow { display: none; } .h-hero__lede { margin-bottom: var(--s-5); } .h-search { padding-top: var(--s-4); margin-bottom: var(--s-5); } .h-hero__actions .btn--ghost { display: none; } .h-promise p { margin-top: var(--s-5); } }

  .h-paths { background: var(--white); border-bottom: var(--hair); }
  .h-paths .wrap { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 10fr); gap: var(--s-6); padding-block: var(--s-7); align-items: start; }
  .h-paths__title { font-size: var(--fs-xl); margin: var(--s-4) 0 0; }
  .h-paths__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--s-6); border-top: var(--hair); }
  .h-paths__list li { border-bottom: var(--hair); }
  .h-paths__list a { display: flex; flex-direction: column; gap: var(--s-1); height: 100%; padding: var(--s-5) 0; color: var(--slate); text-decoration: none; font-size: var(--fs-sm); }
  .h-paths__list strong { font-size: var(--fs-md); font-weight: 600; color: var(--midnight); letter-spacing: -0.01em; display: flex; justify-content: space-between; gap: var(--s-2); transition: color var(--dur); }
  .h-paths__list strong::after { content: '→'; color: var(--sapphire); transition: transform var(--dur) var(--ease); }
  .h-paths__list a:hover strong { color: var(--sapphire); }
  .h-paths__list a:hover strong::after { transform: translateX(4px); }
  @media (max-width: 960px) { .h-paths .wrap { grid-template-columns: 1fr; gap: var(--s-3); } .h-paths__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .h-paths__list { grid-template-columns: 1fr; } .h-paths__list a { padding: var(--s-4) 0; } }

  .h-open { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-6); align-items: start; }
  .h-open__feature { position: relative; background: var(--white); border: var(--hair); border-radius: var(--radius); padding: var(--s-6); display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); transition: border-color var(--dur); }
  .h-open__feature:hover { border-color: var(--sapphire); }
  .h-open__feature h3 { font-size: var(--fs-lg); line-height: 1.25; margin: 0; }
  .h-open__feature p { margin: 0; }
  .h-open h3 a { color: var(--midnight); text-decoration: none; }
  .h-open h3 a::after { content: ''; position: absolute; inset: 0; }
  .h-open h3 a:hover { color: var(--sapphire); }
  .h-open__deadline { font-weight: 600; color: var(--ink); }
  .h-open__list { list-style: none; padding: 0; margin: 0; border-top: var(--hair); }
  .h-open__list li { position: relative; padding: var(--s-5) 0; border-bottom: var(--hair); }
  .h-open__list h3 { margin: var(--s-3) 0 var(--s-1); font-size: var(--fs-md); }
  .h-open__list p { margin: 0; }
  .h-open__meta { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  @media (max-width: 960px) { .h-open { grid-template-columns: 1fr; } }

  .h-does { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(var(--s-6), 6vw, var(--s-9)); }
  .h-does__more { list-style: none; padding: 0; margin: var(--s-6) 0 0; display: grid; gap: var(--s-2); }
  .h-does__more li { display: flex; align-items: center; gap: var(--s-3); min-height: 32px; }
  .h-does__more a { font-weight: 500; }
  .h-does__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: var(--hair); }
  .h-does__list li { padding: var(--s-5) var(--s-5) var(--s-6) 0; border-bottom: var(--hair); display: flex; flex-direction: column; }
  .h-does__list li:nth-child(odd) { border-right: var(--hair); }
  .h-does__list li:nth-child(even) { padding-left: var(--s-5); }
  .h-does__list h3 { font-size: var(--fs-lg); }
  .h-does__list p { color: var(--slate); flex: 1; }
  @media (max-width: 960px) { .h-does { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .h-does__list { grid-template-columns: 1fr; } .h-does__list li, .h-does__list li:nth-child(even) { padding: var(--s-5) 0; border-right: 0; } }

  .h-tiers { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: var(--hair); border-radius: var(--radius); overflow: hidden; }
  .h-tiers li { padding: var(--s-6); }
  .h-tiers li + li { border-left: var(--hair); }
  .h-tiers h3 { font-size: var(--fs-lg); }
  .h-tiers p { color: var(--slate); margin: 0; }
  .h-member__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-5); margin-top: var(--s-6); }
  .h-member__foot p { margin: 0; }
  @media (max-width: 760px) { .h-tiers { grid-template-columns: 1fr; } .h-tiers li + li { border-left: 0; border-top: var(--hair); } }

  .h-close__grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(var(--s-6), 6vw, var(--s-9)); align-items: start; }
  .h-close p { color: var(--slate); max-width: 48ch; margin-bottom: var(--s-5); }
  .h-close__links { list-style: none; padding: 0; margin: 0; border-top: var(--hair); }
  .h-close__links li { border-bottom: var(--hair); }
  .h-close__links a { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); min-height: 64px; color: var(--midnight); text-decoration: none; }
  .h-close__links strong { font-size: var(--fs-md); font-weight: 600; }
  .h-close__links span { color: var(--slate); font-size: var(--fs-sm); text-align: right; }
  .h-close__links a:hover strong { color: var(--sapphire); text-decoration: underline; }
  @media (max-width: 860px) { .h-close__grid { grid-template-columns: 1fr; } }
  .h-stats { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--s-4); padding: 0; margin-top: var(--s-7); }
</style>
