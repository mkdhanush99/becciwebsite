---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pending from '../components/Pending.astro';
import { leadershipGroups } from '../data/site';
const roles: Record<string, string> = {
  'Advisors': 'Experienced people from business, finance, public service and other fields who guide the chamber. Each profile will set out their background, areas of expertise and contribution to BECCI.',
  'National Committee': 'The chamber’s national leadership. It sets BECCI’s direction and is accountable for the chamber as a whole.',
  'State Committees': 'Lead BECCI’s work in each State, beginning with Telangana and Andhra Pradesh, and support the district and city chapters within it.',
  'Wing Presidents': 'Lead the Women’s Wing and the Youth Wing: their programmes, their events and the members who take part.',
  'Sector Committees': 'Bring together members who work in the same industry, so that knowledge, contacts and opportunities in that sector are shared.',
};
---
<Base title="Leadership & Governance" description="BECCI's leadership structure, advisors and committees.">
  <PageHero tone="ice" icon="leadership" title="The people accountable for BECCI" lede="BECCI is led collectively. Advisors, a National Committee, State Committees, wing presidents and sector committees each carry a defined responsibility, so that decisions are shared and members know who answers for what." crumbs={[{ label: 'Leadership & Governance' }]} />
  <section class="section"><div class="wrap l-grid">
    <aside class="l-structure" aria-label="Leadership structure">
      <h2>Structure</h2>
      <ol class="l-tree">
        <li class="l-tree__top">National Committee</li>
        <li>Advisors</li><li>State Committees</li><li>Wing Presidents</li><li>Sector Committees</li>
      </ol>
      <h2 class="l-sub">About these profiles</h2>
      <p class="small muted">Each profile will show a photograph, name, designation, professional background, a short introduction and professional links. Profiles are published only after BECCI approves them and the person consents.</p>
      <p class="small muted">Personal phone numbers are never published. To reach the leadership, use the official routes on the <a href="/contact">Contact page</a>.</p>
      <p class="small muted">New appointments, further State committees and other officially constituted positions will be added here as they are made.</p>
    </aside>
    <div class="l-groups">
      {leadershipGroups.map((g) => (
        <section class="l-group" aria-labelledby={`g-${g.title.replace(/\W+/g, '-')}`}>
          <div class="l-group__head">
            <h2 id={`g-${g.title.replace(/\W+/g, '-')}`}>{g.title}</h2>
            <p>{roles[g.title]}</p>
          </div>
          {g.people.length ? (
            <ul class="l-people">{g.people.map((p) => (
              <li><h3>{p.name}</h3><p class="muted">{p.role}{p.affiliation && ` · ${p.affiliation}`}</p>{p.intro && <p>{p.intro}</p>}
                {p.links?.map((l) => <a class="ext" href={l.url} rel="noopener">{l.label}</a>)}</li>
            ))}</ul>
          ) : <Pending label="Profiles">Published once BECCI approves names, photographs and biographies.</Pending>}
        </section>
      ))}
    </div>
  </div></section>
</Base>
<style>
  .l-sub { font-size: var(--fs-md); margin-top: var(--s-6); }
  .l-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(var(--s-6), 6vw, var(--s-9)); align-items: start; }
  .l-structure { position: sticky; top: calc(64px + var(--s-5)); }
  .l-structure h2 { font-size: var(--fs-lg); }
  .l-tree { list-style: none; padding: 0; margin: 0 0 var(--s-5); display: grid; gap: var(--s-2); }
  .l-tree li { padding: var(--s-3) var(--s-4); border: var(--hair); border-radius: var(--radius-sm); background: var(--white); font-weight: 500; color: var(--midnight); margin-left: var(--s-5); }
  .l-tree .l-tree__top { margin-left: 0; background: var(--midnight-2); border-color: var(--midnight-2); color: #fff; }
  .l-group { padding-block: var(--s-5) var(--s-4); border-top: var(--hair); }
  .l-group:first-child { border-top: 0; padding-top: 0; }
  .l-group__head h2 { font-size: var(--fs-xl); margin-bottom: var(--s-2); }
  .l-group__head p { color: var(--slate); max-width: 56ch; }
  .l-people { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--s-5); }
  @media (max-width: 860px) { .l-grid { grid-template-columns: 1fr; } .l-structure { position: static; } }
</style>
