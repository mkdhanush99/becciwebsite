---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pending from '../components/Pending.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { destinations } from '../data/site';
const has = destinations.email || destinations.phone || destinations.address;
---
<Base title="Contact" description="How to contact BECCI.">
  <PageHero tone="sky" icon="support" title="Contact BECCI" lede="Reach the right part of BECCI quickly. Use the guide below for the fastest route, or send a general enquiry." crumbs={[{ label: 'Contact' }]} />
  <section class="section"><div class="wrap">
    <h2>Who to contact for what</h2>
    <ul class="c-routes bento">
      <li><a href="/membership#request-call" class="tile"><span class="ibadge"><Icon name="membership" /></span><strong>Joining BECCI</strong><span>Ask the membership team to call you.</span></a></li>
      <li><a href="/partnerships#proposal" class="tile"><span class="ibadge"><Icon name="partnership" /></span><strong>Institutional partnership</strong><span>Send a partnership proposal.</span></a></li>
      <li><a href="/services" class="tile"><span class="ibadge"><Icon name="services" /></span><strong>Business services</strong><span>Tell us what help you need.</span></a></li>
      <li><a href="/opportunities" class="tile"><span class="ibadge"><Icon name="schemes" /></span><strong>A scheme, tender or job</strong><span>Contact the issuing authority named on the listing. BECCI cannot decide eligibility.</span></a></li>
    </ul>
  </div></section>
  <section class="section section--white"><div class="wrap two-col">
    <div>
      <h2>Official contact details</h2>
      {has ? (
        <dl>{destinations.email && <><dt>Email</dt><dd><a href={`mailto:${destinations.email}`}>{destinations.email}</a></dd></>}{destinations.phone && <><dt>Phone</dt><dd>{destinations.phone}</dd></>}{destinations.address && <><dt>Office</dt><dd>{destinations.address}</dd></>}</dl>
      ) : <Pending>BECCI's official email, office phone and address will be published here once confirmed.</Pending>}
      <p class="small muted" style="margin-top:var(--s-4)">BECCI never publishes the personal phone numbers of its leadership. Please use these official routes.</p>
    </div>
    <div>
      <h2>Send an enquiry</h2>
      <EnquiryForm id="contact" purpose="general" submitLabel="Send enquiry" fields={[
        { name: 'name', label: 'Your name', required: true, autocomplete: 'name' },
        { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
        { name: 'topic', label: 'Topic', type: 'select', required: true, options: ['Membership', 'Partnership', 'Events', 'Opportunities', 'Media', 'Something else'] },
        { name: 'message', label: 'Message', type: 'textarea', required: true },
      ]} />
    </div>
  </div></section>
</Base>

<style>
  .c-routes { list-style: none; padding: 0; margin: 0; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .c-routes li { display: flex; }
  .c-routes .tile { width: 100%; }
  .c-routes strong { color: var(--midnight); font-size: var(--fs-md); }
  @media (max-width: 900px) { .c-routes { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .c-routes { grid-template-columns: 1fr; } }
</style>
