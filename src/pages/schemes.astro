---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { opportunities, portals } from '../data/opportunities';
import ScopeLegend from '../components/ScopeLegend.astro';
import Finder from '../components/Finder.astro';
---
<Base title="Government Schemes" description="Browse and filter Central and State government schemes with official links and last verified dates.">
  <PageHead meta={`${opportunities.length} verified records · ${portals.length} official portals. Every record links to its source.`} title="Government Schemes" lede="Browse Central and State schemes, read what each offers and who can apply, then go to the official guidelines and application. No account needed." crumbs={[{ label: 'Opportunities', href: '/opportunities' }, { label: 'Government Schemes' }]} />
  <section class="finder-page"><div class="wrap">
    <ScopeLegend />
    <p class="small muted" style="margin:0 0 var(--s-5)">A listing here is not a promise of eligibility or approval. Always confirm with the issuing authority before you apply.</p>
    <Finder category="schemes" />
  </div></section>
</Base>
