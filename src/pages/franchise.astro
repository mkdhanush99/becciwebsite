---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pending from '../components/Pending.astro';
import SampleBadge from '../components/SampleBadge.astro';
import { franchiseListings } from '../data/site';
const kinds = ['Franchise opportunities', 'Ready-to-start business models', 'Small business ownership', 'Enterprise development models', 'Traditional business modernisation', 'Business expansion', 'Project-based enterprise'];
---
<Base title="Franchise & Enterprise" description="Franchise and enterprise ownership opportunities for aspiring entrepreneurs and business owners, and what each listing will include.">
  <PageHero tone="ice" icon="franchise" title="Practical paths to owning a business" lede="Not every entrepreneur starts from a new idea. A franchise, a proven business model or a project-based enterprise can be a faster and safer way in. This page will list such opportunities once BECCI has reviewed them." crumbs={[{ label: 'Opportunities', href: '/opportunities' }, { label: 'Franchise & Enterprise' }]} />
  <section class="section"><div class="wrap two-col">
    <div><h2>Who it is for</h2></div>
    <div class="prose">
      <p>Aspiring entrepreneurs looking for a ready-to-start model, and existing business owners who want to expand, add a line of business or modernise a traditional enterprise.</p>
      <h3>Kinds of opportunity</h3>
      <ul class="tag-list">{kinds.map((k) => <li>{k}</li>)}</ul>
    </div>
  </div></section>
  {franchiseListings.length > 0 && (
  <section class="section" aria-labelledby="fr-list"><div class="wrap">
    <h2 id="fr-list">Opportunities</h2>
    <ul class="fr-list">{franchiseListings.map((f) => (
      <li class="fr-card">
        {f.image && <img src={f.image} alt={f.sample ? 'Sample photograph (illustrative AI image)' : f.title} width="1024" height="768" loading="lazy" decoding="async" />}
        <div class="fr-body">
          <h3>{f.title} {f.sample && <SampleBadge />}</h3>
          <dl>{[['Business model', f.model], ['Investment', f.investment], ['Operations', f.operations], ['Capabilities expected', f.capabilities], ['Contact', f.contact]].map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        </div>
      </li>
    ))}</ul>
  </div></section>
  )}
  <section class="section section--white"><div class="wrap two-col">
    <div><h2>What every listing will tell you</h2></div>
    <div class="prose">
      <ul>
        <li><strong>The business model</strong>: what the business does and how it earns.</li>
        <li><strong>Investment</strong>: what it costs to start, as stated by the offering company.</li>
        <li><strong>Operations</strong>: space, staff, equipment and time it needs.</li>
        <li><strong>Capabilities expected</strong>: skills and experience the owner should bring.</li>
        <li><strong>Contact</strong>: who to speak to, and what BECCI has and has not checked.</li>
      </ul>
      {franchiseListings.length === 0 && <Pending label="No listings yet" icon="franchise" action={{ label: "See loans and funding", href: "/opportunities/finance" }}>BECCI has not published any franchise or enterprise opportunities. Listings will appear only after review. To fund a business of your own, see <a href="/opportunities/finance">Loans &amp; Funding</a>.</Pending>}
    </div>
  </div></section>
  <section class="section"><div class="wrap two-col">
    <div><h2>Offering an opportunity?</h2></div>
    <div class="prose"><p>Franchisors and companies that want to reach OBC entrepreneurs can propose an opportunity for listing.</p><p><a class="btn" href="/partnerships#proposal">Propose an opportunity</a></p></div>
  </div></section>
</Base>
<style>
  .fr-list { list-style: none; padding: 0; margin: var(--s-5) 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); }
  .fr-card { display: grid; grid-template-columns: 2fr 3fr; overflow: hidden; border-radius: var(--radius); background: #fff; border: 1px solid rgb(10 35 82 / 10%); }
  .fr-card img { width: 100%; height: 100%; object-fit: cover; }
  .fr-body { padding: var(--s-5); }
  .fr-body h3 { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 var(--s-3); font-size: var(--fs-md); }
  .fr-body dl { margin: 0; display: grid; gap: var(--s-2); }
  .fr-body dt { font-size: var(--fs-label); font-weight: 700; color: var(--slate); }
  .fr-body dd { margin: 0; font-size: var(--fs-sm); }
  @media (max-width: 1100px) { .fr-list { grid-template-columns: 1fr; } }
</style>
