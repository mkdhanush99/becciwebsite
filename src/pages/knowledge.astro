---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { resources } from '../data/site';
const cats = ['Business News', 'MSME Updates', 'Startup News', 'New Laws and Regulatory Changes', 'Government Notifications', 'Industry Developments', 'Business Articles', 'Educational Resources', 'Video', 'Interviews and Discussions', 'Entrepreneurship Guidance', 'Reports and Guides'];
---
<Base title="Knowledge Centre" description="Guides, resources, reports and learning for entrepreneurs.">
  <PageHero eyebrow="Knowledge Centre" title="Learn what you need to grow" lede="Practical guides, regulatory updates, reports and educational material for entrepreneurs and business owners." crumbs={[{ label: 'Knowledge Centre' }]} />
  <section class="section"><div class="wrap">
    <label class="visually-hidden" for="kq">Search the Knowledge Centre</label>
    <input id="kq" class="input" type="search" placeholder={resources.length ? "Search guides and resources" : "Search opens when resources are published"} disabled={resources.length === 0} style="max-width:560px;margin-bottom:var(--s-5)" data-kq />
    <ul class="tag-list" aria-label="Categories" style="margin-bottom:var(--s-6)">{cats.map((c) => <li>{c}</li>)}</ul>
    <div data-kempty>{resources.length === 0 && <div class="empty"><h3>No resources published yet</h3><p class="muted">Search will cover every guide, article, report and video once BECCI publishes them. The category structure above is ready for that content. Meanwhile, the <a href="/opportunities/about-data">opportunity data guide</a> explains how to read deadlines and eligibility.</p></div>}</div>
  </div></section>
</Base>
