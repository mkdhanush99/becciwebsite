---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { news } from '../data/site';
import { formatDate } from '../lib/status';
const topics = ['BECCI announcements', 'Government announcements', 'Business and MSME updates', 'Scheme updates', 'Programme news'];
---
<Base title="News Desk" description="BECCI announcements, government and scheme updates, and business news for OBC entrepreneurs.">
  <PageHero tone="ivory" icon="news" title="News and announcements" lede="The News Desk is where BECCI publishes its own announcements, alongside government, scheme and MSME updates that affect its members." crumbs={[{ label: 'News Desk' }]} />
  <section class="section"><div class="wrap">
    <ul class="tag-list" aria-label="Topics covered" style="margin-bottom:var(--s-6)">{topics.map((t) => <li>{t}</li>)}</ul>
    {news.length ? <ul>{news.map((n) => <li><p class="small muted">{formatDate(n.date)}</p><h3>{n.title}</h3><p>{n.summary}</p></li>)}</ul>
      : <div class="empty"><h2 class="empty__title">No announcements published yet</h2><p class="muted">BECCI’s first announcements will appear here, each with its date. For deadlines that are open now, use the <a href="/opportunities">opportunity finder</a>.</p></div>}
    <p class="small muted" style="margin-top:var(--s-6)">Looking for guides and explainers rather than news? See the <a href="/knowledge">Knowledge Centre</a>.</p>
  </div></section>
</Base>
