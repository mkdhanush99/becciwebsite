---
import { photos } from '../data/photos';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pending from '../components/Pending.astro';
---
<Base title="Privacy Policy and Terms">
  <PageHero title="Privacy Policy and Terms" crumbs={[{ label: 'Policies' }]} />
  <section class="section"><div class="wrap prose">
    <h2 id="privacy">Privacy Policy</h2>
    <Pending>BECCI's legally reviewed Privacy Policy has not been supplied yet.</Pending>
    <p style="margin-top:var(--s-4)">What this website does today: it has no accounts, logins or tracking. Forms are not yet connected to any inbox, so form entries are not sent or stored. The opportunity finder remembers your search in the page address and your scroll position in your browser tab only.</p>
    <h2 id="terms">Terms of use</h2>
    <Pending>BECCI's Terms of use have not been supplied yet.</Pending>
    <h2 id="photo-credits">Photo credits</h2>
    <p>The homepage photographs come from Wikimedia Commons and illustrate BECCI's themes. They do not show BECCI members or BECCI events. Each was resized, and in some cases cropped, for the web.</p>
    <ul>{Object.values(photos).map((p) => <li><a href={p.page} rel="noopener">{p.title}</a> by {p.by}, <a href={p.licenceUrl} rel="noopener license">{p.licence}</a></li>)}</ul>
  </div></section>
</Base>
