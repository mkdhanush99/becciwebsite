---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { collaborators } from '../data/site';
const areaIcons = ['funding', 'schemes', 'education', 'entrepreneur', 'commerce', 'partnership'];
const areas = [
  ['Access to finance', 'Credit products, awareness camps and application support with banks and financial institutions.'],
  ['Government programmes', 'Outreach for schemes, procurement and registration drives with departments.'],
  ['Skills and education', 'Training, internships and entrepreneurship programmes with educational institutions.'],
  ['Incubation', 'Pathways from idea to venture with incubators and accelerators.'],
  ['Market access', 'Supplier development and buyer meetings with corporates and industry associations.'],
  ['Exports', 'Readiness and market linkages with export promotion organisations.'],
];
---
<Base title="Partner with BECCI" description="Institutional partnerships and collaborations with BECCI.">
  <PageHero tone="royal" icon="partnership" variant="feature" title="Partner with BECCI" lede="A bank, a government department, a college or an industry body can open doors for thousands of entrepreneurs at once. BECCI welcomes institutions that want to reach OBC entrepreneurs and help them grow." crumbs={[{ label: 'Partnerships' }]}>
    <a class="btn btn--accent" href="#proposal" style="margin-top:var(--s-5)">Send a partnership proposal</a>
  </PageHero>
  <section class="section"><div class="wrap">
    <div class="two-col" style="margin-bottom:var(--s-7)">
      <div><h2>Why partner with BECCI</h2></div>
      <div class="prose">
        <p>BECCI is organising OBC entrepreneurs, business owners, professionals and students into one national chamber, beginning in Telangana and Andhra Pradesh. For an institution, that is a single, organised way to reach them.</p>
        <p>For members, partnerships create what ordinary networking cannot: credit products designed for first-time founders, supplier programmes, internships, training and new markets.</p>
      </div>
    </div>
    <h2>Who we work with</h2>
    <ul class="chips" style="margin-bottom:var(--s-7)">{collaborators.map((c) => <li>{c}</li>)}</ul>
    <h2>Areas of collaboration</h2>
    <div class="bento">{areas.map(([t, d], i) => <div class="tile"><span class="ibadge"><Icon name={areaIcons[i]} /></span><h3>{t}</h3><p>{d}</p></div>)}</div>
  </div></section>
  <section class="section section--white" id="proposal"><div class="wrap two-col">
    <div><h2>Tell us about your organisation</h2><p class="muted">A useful proposal says who you are, what you would like to do together, whom it would help and what you would need from BECCI.</p></div>
    <EnquiryForm id="partner" purpose="partnership" submitLabel="Send proposal" assurance="BECCI’s team will reply to the official email you give. Your proposal is not shared outside BECCI." fields={[
      { name: 'org', label: 'Organisation name', required: true, autocomplete: 'organization' },
      { name: 'kind', label: 'Type of organisation', type: 'select', required: true, options: collaborators },
      { name: 'name', label: 'Contact person', required: true, autocomplete: 'name' },
      { name: 'email', label: 'Official email', type: 'email', required: true, autocomplete: 'email' },
      { name: 'phone', label: 'Phone', type: 'tel', autocomplete: 'tel' },
      { name: 'proposal', label: 'What would you like to do together?', type: 'textarea', required: true },
    ]} />
  </div></section>
</Base>
